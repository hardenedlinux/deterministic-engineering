(import (only-in :clan/poo/object .def .o .get)
        (only-in :deterministic-engineering/types library-catalog-scope-contract)
        (only-in :deterministic-engineering/library/quint-methods/types ThreatCatalogConfigContract)
        "objects.ss"
        (only-in :deterministic-engineering/library/quint-profiles/objects
                 QuintModelSlotSpecs
                 QuintModelDefaultSlots
                 QuintModelGovernanceFloor))
(export HookPolicyAndProtocolContractConfinement)

(.def HookPolicyAndProtocolContractConfinement
  identity: 'hook-policy-and-protocol-contract-confinement
  tags: '(quint
          quint.model
          quint.domain.threat
          quint.threat.execution
          quint.property.stateful
          quint.property.emergent-invariant
          quint.property.mbt-ready
          quint.failure.hook-policy-protocol-bypass
          de.layer.threat)
  slot-specs: QuintModelSlotSpecs
  defaults: QuintModelDefaultSlots
  governance-floor: QuintModelGovernanceFloor
  core:
  (.o
    admissions: (.o)
    scope-contract: (.get (library-catalog-scope-contract 'hook-policy-and-protocol-contract-confinement/scope) value-contract)
    exports:
    (.o entry: HookPolicyAndProtocolContractConfinementModel
        config: (.o entry: HookPolicyAndProtocolContractConfinementModel)
        contracts: (.o config: ThreatCatalogConfigContract)))
  features: (.o))
