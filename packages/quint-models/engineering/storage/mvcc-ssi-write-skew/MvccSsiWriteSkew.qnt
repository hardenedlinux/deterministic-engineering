// SPDX-FileCopyrightText: 2026 hardenedlinux Linux Team and Contributors
// SPDX-License-Identifier: LGPL-2.1-or-later
// @quint-model engineering.storage.mvcc-ssi-write-skew
// @quint-version 0.33.0
// @apalache-version 0.62.1
// @verify safety max-steps=10
// @countermodel ssi-dangerous-structure step=stepSnapshotIsolation max-steps=9 itf="h.balX + h.balY == 0 and h.committedWithdrawals == 2"
// @countermodel retain-siread-after-commit step=stepEarlySireadRelease max-steps=9 itf="h.balX + h.balY == 0 and h.committedWithdrawals == 2"
// @countermodel detect-rw-on-read step=stepMissedReadRw max-steps=9 itf="h.balX + h.balY == 0 and h.committedWithdrawals == 2"
// Limits: Finite 2-transaction, 2-key MVCC/SSI abstraction verifying write skew, lost updates, persistent SIREAD locks, and read-time rw-antidependencies; does not model 3-txn read-only anomalies, predicate index page coarsening, or GC vacuuming of old SIREAD locks.
module storage_mvcc_ssi {
  type State = { balX: int, balY: int, commitSeq: int, xModSeq: int, yModSeq: int, committedWithdrawals: int, t1State: int, t1Snap: int, t1SnapX: int, t1SnapY: int, t1SireadX: bool, t1SireadY: bool, t1WriteKey: int, t1CommitSeq: int, t1InRw: bool, t1OutRw: bool, t2State: int, t2Snap: int, t2SnapX: int, t2SnapY: int, t2SireadX: bool, t2SireadY: bool, t2WriteKey: int, t2CommitSeq: int, t2InRw: bool, t2OutRw: bool }
  var h: State
  action init = h' = { balX: 1, balY: 1, commitSeq: 1, xModSeq: 1, yModSeq: 1, committedWithdrawals: 0, t1State: 0, t1Snap: 0, t1SnapX: 0, t1SnapY: 0, t1SireadX: false, t1SireadY: false, t1WriteKey: 0, t1CommitSeq: 0, t1InRw: false, t1OutRw: false, t2State: 0, t2Snap: 0, t2SnapX: 0, t2SnapY: 0, t2SireadX: false, t2SireadY: false, t2WriteKey: 0, t2CommitSeq: 0, t2InRw: false, t2OutRw: false }
  action beginTxAs(tx: int): bool = if (tx == 1) if (h.t1State == 0) h' = h.with("t1State", 1).with("t1Snap", h.commitSeq).with("t1SnapX", h.balX).with("t1SnapY", h.balY) else h' = h else if (h.t2State == 0) h' = h.with("t2State", 1).with("t2Snap", h.commitSeq).with("t2SnapX", h.balX).with("t2SnapY", h.balY) else h' = h
  action beginTx = { nondet tx = Set(1, 2).oneOf()
    beginTxAs(tx) }
  action readBothAs(tx: int): bool = if (tx == 1) if ((h.t1State == 1 and not(h.t1SireadX))) h' = h.with("t1SireadX", true).with("t1SireadY", true).with("t1OutRw", (h.t1OutRw or ((h.t2State == 1 and h.t2WriteKey > 0) or (h.t2State == 2 and h.t2CommitSeq > h.t1Snap)))).with("t2InRw", (h.t2InRw or ((h.t2State == 1 and h.t2WriteKey > 0) or (h.t2State == 2 and h.t2CommitSeq > h.t1Snap)))) else h' = h else if ((h.t2State == 1 and not(h.t2SireadX))) h' = h.with("t2SireadX", true).with("t2SireadY", true).with("t2OutRw", (h.t2OutRw or ((h.t1State == 1 and h.t1WriteKey > 0) or (h.t1State == 2 and h.t1CommitSeq > h.t2Snap)))).with("t1InRw", (h.t1InRw or ((h.t1State == 1 and h.t1WriteKey > 0) or (h.t1State == 2 and h.t1CommitSeq > h.t2Snap)))) else h' = h
  action readBoth = { nondet tx = Set(1, 2).oneOf()
    readBothAs(tx) }
  action writeWithdrawAs(tx: int, key: int): bool = if (tx == 1) if ((h.t1State == 1 and h.t1SireadX and h.t1SireadY and h.t1WriteKey == 0 and (h.t1SnapX + h.t1SnapY) >= 2 and ((key == 1 and h.t1SnapX >= 1) or (key == 2 and h.t1SnapY >= 1)))) h' = h.with("t1WriteKey", key).with("t2OutRw", (h.t2OutRw or ((h.t2State == 1 or h.t2State == 2) and ((key == 1 and h.t2SireadX) or (key == 2 and h.t2SireadY))))).with("t1InRw", (h.t1InRw or ((h.t2State == 1 or h.t2State == 2) and ((key == 1 and h.t2SireadX) or (key == 2 and h.t2SireadY))))) else h' = h else if ((h.t2State == 1 and h.t2SireadX and h.t2SireadY and h.t2WriteKey == 0 and (h.t2SnapX + h.t2SnapY) >= 2 and ((key == 1 and h.t2SnapX >= 1) or (key == 2 and h.t2SnapY >= 1)))) h' = h.with("t2WriteKey", key).with("t1OutRw", (h.t1OutRw or ((h.t1State == 1 or h.t1State == 2) and ((key == 1 and h.t1SireadX) or (key == 2 and h.t1SireadY))))).with("t2InRw", (h.t2InRw or ((h.t1State == 1 or h.t1State == 2) and ((key == 1 and h.t1SireadX) or (key == 2 and h.t1SireadY))))) else h' = h
  action writeWithdraw = { nondet tx = Set(1, 2).oneOf()
    nondet key = Set(1, 2).oneOf()
    writeWithdrawAs(tx, key) }
  action commitTxAs(tx: int): bool = if (tx == 1) if ((h.t1State == 1 and h.t1WriteKey > 0)) if ((not((h.t1WriteKey == 1 and h.xModSeq > h.t1Snap)) and not((h.t1WriteKey == 2 and h.yModSeq > h.t1Snap)) and not(((h.t1InRw and h.t1OutRw) or (h.t2State == 2 and h.t2InRw and h.t2OutRw))))) h' = h.with("t1State", 2).with("commitSeq", (h.commitSeq + 1)).with("t1CommitSeq", (h.commitSeq + 1)).with("balX", if (h.t1WriteKey == 1) (h.balX - 1) else h.balX).with("balY", if (h.t1WriteKey == 2) (h.balY - 1) else h.balY).with("xModSeq", if (h.t1WriteKey == 1) (h.commitSeq + 1) else h.xModSeq).with("yModSeq", if (h.t1WriteKey == 2) (h.commitSeq + 1) else h.yModSeq).with("committedWithdrawals", (h.committedWithdrawals + 1)).with("t1SireadX", h.t1SireadX).with("t1SireadY", h.t1SireadY) else h' = h.with("t1State", 3).with("t1SireadX", false).with("t1SireadY", false) else h' = h else if ((h.t2State == 1 and h.t2WriteKey > 0)) if ((not((h.t2WriteKey == 1 and h.xModSeq > h.t2Snap)) and not((h.t2WriteKey == 2 and h.yModSeq > h.t2Snap)) and not(((h.t2InRw and h.t2OutRw) or (h.t1State == 2 and h.t1InRw and h.t1OutRw))))) h' = h.with("t2State", 2).with("commitSeq", (h.commitSeq + 1)).with("t2CommitSeq", (h.commitSeq + 1)).with("balX", if (h.t2WriteKey == 1) (h.balX - 1) else h.balX).with("balY", if (h.t2WriteKey == 2) (h.balY - 1) else h.balY).with("xModSeq", if (h.t2WriteKey == 1) (h.commitSeq + 1) else h.xModSeq).with("yModSeq", if (h.t2WriteKey == 2) (h.commitSeq + 1) else h.yModSeq).with("committedWithdrawals", (h.committedWithdrawals + 1)).with("t2SireadX", h.t2SireadX).with("t2SireadY", h.t2SireadY) else h' = h.with("t2State", 3).with("t2SireadX", false).with("t2SireadY", false) else h' = h
  action commitTx = { nondet tx = Set(1, 2).oneOf()
    commitTxAs(tx) }
  action step = any { beginTx, readBoth, writeWithdraw, commitTx }
  val safety = ((h.balX + h.balY) >= 1 and ((h.balX + h.balY) + h.committedWithdrawals) == 2)
  // Countermodel engineering.storage.mvcc-ssi-write-skew.snapshot-isolation-write-skew (dropped guard: ssi-dangerous-structure)
  action commitTxNoSsi(tx: int): bool = if (tx == 1) if ((h.t1State == 1 and h.t1WriteKey > 0)) if ((not((h.t1WriteKey == 1 and h.xModSeq > h.t1Snap)) and not((h.t1WriteKey == 2 and h.yModSeq > h.t1Snap)) and true)) h' = h.with("t1State", 2).with("commitSeq", (h.commitSeq + 1)).with("t1CommitSeq", (h.commitSeq + 1)).with("balX", if (h.t1WriteKey == 1) (h.balX - 1) else h.balX).with("balY", if (h.t1WriteKey == 2) (h.balY - 1) else h.balY).with("xModSeq", if (h.t1WriteKey == 1) (h.commitSeq + 1) else h.xModSeq).with("yModSeq", if (h.t1WriteKey == 2) (h.commitSeq + 1) else h.yModSeq).with("committedWithdrawals", (h.committedWithdrawals + 1)).with("t1SireadX", h.t1SireadX).with("t1SireadY", h.t1SireadY) else h' = h.with("t1State", 3).with("t1SireadX", false).with("t1SireadY", false) else h' = h else if ((h.t2State == 1 and h.t2WriteKey > 0)) if ((not((h.t2WriteKey == 1 and h.xModSeq > h.t2Snap)) and not((h.t2WriteKey == 2 and h.yModSeq > h.t2Snap)) and true)) h' = h.with("t2State", 2).with("commitSeq", (h.commitSeq + 1)).with("t2CommitSeq", (h.commitSeq + 1)).with("balX", if (h.t2WriteKey == 1) (h.balX - 1) else h.balX).with("balY", if (h.t2WriteKey == 2) (h.balY - 1) else h.balY).with("xModSeq", if (h.t2WriteKey == 1) (h.commitSeq + 1) else h.xModSeq).with("yModSeq", if (h.t2WriteKey == 2) (h.commitSeq + 1) else h.yModSeq).with("committedWithdrawals", (h.committedWithdrawals + 1)).with("t2SireadX", h.t2SireadX).with("t2SireadY", h.t2SireadY) else h' = h.with("t2State", 3).with("t2SireadX", false).with("t2SireadY", false) else h' = h
  action stepSnapshotIsolation = any { step, { nondet tx = Set(1, 2).oneOf()
    commitTxNoSsi(tx) } }
  // Countermodel engineering.storage.mvcc-ssi-write-skew.early-siread-release (dropped guard: retain-siread-after-commit)
  action commitTxReleaseSiread(tx: int): bool = if (tx == 1) if ((h.t1State == 1 and h.t1WriteKey > 0)) if ((not((h.t1WriteKey == 1 and h.xModSeq > h.t1Snap)) and not((h.t1WriteKey == 2 and h.yModSeq > h.t1Snap)) and not(((h.t1InRw and h.t1OutRw) or (h.t2State == 2 and h.t2InRw and h.t2OutRw))))) h' = h.with("t1State", 2).with("commitSeq", (h.commitSeq + 1)).with("t1CommitSeq", (h.commitSeq + 1)).with("balX", if (h.t1WriteKey == 1) (h.balX - 1) else h.balX).with("balY", if (h.t1WriteKey == 2) (h.balY - 1) else h.balY).with("xModSeq", if (h.t1WriteKey == 1) (h.commitSeq + 1) else h.xModSeq).with("yModSeq", if (h.t1WriteKey == 2) (h.commitSeq + 1) else h.yModSeq).with("committedWithdrawals", (h.committedWithdrawals + 1)).with("t1SireadX", false).with("t1SireadY", false) else h' = h.with("t1State", 3).with("t1SireadX", false).with("t1SireadY", false) else h' = h else if ((h.t2State == 1 and h.t2WriteKey > 0)) if ((not((h.t2WriteKey == 1 and h.xModSeq > h.t2Snap)) and not((h.t2WriteKey == 2 and h.yModSeq > h.t2Snap)) and not(((h.t2InRw and h.t2OutRw) or (h.t1State == 2 and h.t1InRw and h.t1OutRw))))) h' = h.with("t2State", 2).with("commitSeq", (h.commitSeq + 1)).with("t2CommitSeq", (h.commitSeq + 1)).with("balX", if (h.t2WriteKey == 1) (h.balX - 1) else h.balX).with("balY", if (h.t2WriteKey == 2) (h.balY - 1) else h.balY).with("xModSeq", if (h.t2WriteKey == 1) (h.commitSeq + 1) else h.xModSeq).with("yModSeq", if (h.t2WriteKey == 2) (h.commitSeq + 1) else h.yModSeq).with("committedWithdrawals", (h.committedWithdrawals + 1)).with("t2SireadX", false).with("t2SireadY", false) else h' = h.with("t2State", 3).with("t2SireadX", false).with("t2SireadY", false) else h' = h
  action stepEarlySireadRelease = any { step, { nondet tx = Set(1, 2).oneOf()
    commitTxReleaseSiread(tx) } }
  // Countermodel engineering.storage.mvcc-ssi-write-skew.missed-read-rw-conflict (dropped guard: detect-rw-on-read)
  action readBothNoRwCheck(tx: int): bool = if (tx == 1) if ((h.t1State == 1 and not(h.t1SireadX))) h' = h.with("t1SireadX", true).with("t1SireadY", true).with("t1OutRw", (h.t1OutRw or false)).with("t2InRw", (h.t2InRw or false)) else h' = h else if ((h.t2State == 1 and not(h.t2SireadX))) h' = h.with("t2SireadX", true).with("t2SireadY", true).with("t2OutRw", (h.t2OutRw or false)).with("t1InRw", (h.t1InRw or false)) else h' = h
  action stepMissedReadRw = any { step, { nondet tx = Set(1, 2).oneOf()
    readBothNoRwCheck(tx) } }
  action checkSafe = all { assert(safety), h' = h }
  action checkUnsafe = all { assert(not(safety)), h' = h }
  run ssiBlocksWriteSkewTest = init.then(beginTxAs(1)).then(beginTxAs(2)).then(readBothAs(1)).then(readBothAs(2)).then(writeWithdrawAs(1, 1)).then(commitTxAs(1)).then(writeWithdrawAs(2, 2)).then(commitTxAs(2)).then(all { assert(h.t1State == 2), assert(h.t2State == 3), assert((h.balX + h.balY) == 1), assert(safety), h' = h })
  run siWriteSkewCountermodelTest = init.then(beginTxAs(1)).then(beginTxAs(2)).then(readBothAs(1)).then(readBothAs(2)).then(writeWithdrawAs(1, 1)).then(commitTxAs(1)).then(writeWithdrawAs(2, 2)).then(commitTxNoSsi(2)).then(checkUnsafe)
  run earlySireadReleaseCountermodelTest = init.then(beginTxAs(1)).then(beginTxAs(2)).then(readBothAs(1)).then(readBothAs(2)).then(writeWithdrawAs(1, 1)).then(commitTxReleaseSiread(1)).then(writeWithdrawAs(2, 2)).then(commitTxAs(2)).then(checkUnsafe)
  run missedReadRwCountermodelTest = init.then(beginTxAs(1)).then(beginTxAs(2)).then(readBothAs(1)).then(writeWithdrawAs(1, 1)).then(commitTxAs(1)).then(readBothNoRwCheck(2)).then(writeWithdrawAs(2, 2)).then(commitTxAs(2)).then(checkUnsafe)
}
