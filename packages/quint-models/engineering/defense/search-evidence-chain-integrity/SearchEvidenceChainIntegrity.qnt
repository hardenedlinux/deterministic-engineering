// SPDX-License-Identifier: LGPL-2.1-or-later
// @quint-model engineering.defense.search-evidence-chain-integrity
// @quint-version 0.33.0
// @apalache-version 0.62.1
// @verify safety max-steps=10
// @countermodel require-fresh-structural-epoch step=stepStaleStructuralReuse max-steps=7 itf="h.staleStructuralReuseViolations > 0"
// @countermodel require-neg-domain-unexpanded step=stepStaleNegDomainReuse max-steps=7 itf="h.staleNegDomainReuseViolations > 0"
// @countermodel require-kv-epoch-and-pins step=stepKvCacheContamination max-steps=7 itf="h.kvCacheContaminationViolations > 0"
// @countermodel require-oracle-and-no-tombstone step=stepPoisonedEvidencePromotion max-steps=7 itf="h.poisonedPromotionViolations > 0"
// @countermodel forbid-zombie-derived-chain step=stepZombieEvidenceCascade max-steps=7 itf="h.zombieCascadeViolations > 0"
// Limits: Finite single-root/single-derived Scenario B evidence-chain abstraction over comment vs structural AST drift, DE01 negative-domain expansion, KV-cache epoch/pin fencing, and ATMS multi-justification retraction; unbounded multi-file dependency graphs and cryptographic SHA-256 receipts are verified in Marlin's executable ASCENT/Dusa truth-maintenance suite.
module search_evidence_chain_integrity {
  type State = { indexEpoch: int, commentOnlyEdit: bool, structuralDrifted: bool, negDomainExpanded: bool, oracleVerified: bool, rootAdmitted: bool, rootEvidenceEpoch: int, derivedActive: bool, hasAltCleanSupport: bool, poisonRetracted: bool, kvCachedEpoch: int, pinnedRetained: bool, staleStructuralReuseViolations: int, staleNegDomainReuseViolations: int, kvCacheContaminationViolations: int, poisonedPromotionViolations: int, zombieCascadeViolations: int, validEvidenceReuses: int, validKvServes: int }
  var h: State
  action init = h' = { indexEpoch: 1, commentOnlyEdit: false, structuralDrifted: false, negDomainExpanded: false, oracleVerified: false, rootAdmitted: false, rootEvidenceEpoch: 0, derivedActive: false, hasAltCleanSupport: false, poisonRetracted: false, kvCachedEpoch: 0, pinnedRetained: true, staleStructuralReuseViolations: 0, staleNegDomainReuseViolations: 0, kvCacheContaminationViolations: 0, poisonedPromotionViolations: 0, zombieCascadeViolations: 0, validEvidenceReuses: 0, validKvServes: 0 }
  action verifyWithSearchOracle = if (not(h.oracleVerified)) h' = h.with("oracleVerified", true) else h' = h
  action admitM1Evidence = if ((not(h.rootAdmitted) and (h.oracleVerified and not(h.poisonRetracted)))) h' = h.with("rootAdmitted", true).with("rootEvidenceEpoch", h.indexEpoch).with("structuralDrifted", false).with("negDomainExpanded", false).with("kvCachedEpoch", h.indexEpoch).with("poisonedPromotionViolations", if ((h.oracleVerified and not(h.poisonRetracted))) h.poisonedPromotionViolations else (h.poisonedPromotionViolations + 1)) else h' = h
  action deriveScenarioBChain = if ((h.rootAdmitted and h.rootEvidenceEpoch == h.indexEpoch and not(h.structuralDrifted) and not(h.derivedActive))) h' = h.with("derivedActive", true) else h' = h
  action attachAltCleanJustification = if ((h.derivedActive and not(h.hasAltCleanSupport))) h' = h.with("hasAltCleanSupport", true) else h' = h
  action applyCommentOnlyEdit = if ((h.rootAdmitted and not(h.commentOnlyEdit))) h' = h.with("commentOnlyEdit", true) else h' = h
  action reuseStructuralEvidence = if ((h.rootAdmitted and (h.rootEvidenceEpoch == h.indexEpoch and not(h.structuralDrifted)) and not(h.negDomainExpanded))) h' = h.with("validEvidenceReuses", (h.validEvidenceReuses + 1)).with("staleStructuralReuseViolations", if ((h.rootEvidenceEpoch == h.indexEpoch and not(h.structuralDrifted))) h.staleStructuralReuseViolations else (h.staleStructuralReuseViolations + 1)).with("staleNegDomainReuseViolations", if (not(h.negDomainExpanded)) h.staleNegDomainReuseViolations else (h.staleNegDomainReuseViolations + 1)) else h' = h
  action applyStructuralAstDrift = if ((h.rootAdmitted and h.indexEpoch < 3 and not(h.structuralDrifted))) h' = h.with("indexEpoch", (h.indexEpoch + 1)).with("structuralDrifted", true).with("derivedActive", if (h.hasAltCleanSupport) h.derivedActive else false) else h' = h
  action expandNegativeScopeDomain = if ((h.rootAdmitted and not(h.negDomainExpanded))) h' = h.with("negDomainExpanded", true) else h' = h
  action reconcileAndRefreshEvidence = if ((h.oracleVerified and not(h.poisonRetracted) and (h.structuralDrifted or h.negDomainExpanded))) h' = h.with("rootAdmitted", true).with("rootEvidenceEpoch", h.indexEpoch).with("structuralDrifted", false).with("negDomainExpanded", false).with("kvCachedEpoch", h.indexEpoch).with("derivedActive", true) else h' = h
  action retractPoisonedEvidence = if ((h.rootAdmitted and not(h.poisonRetracted))) h' = h.with("poisonRetracted", true).with("rootAdmitted", false).with("derivedActive", if (h.hasAltCleanSupport) h.derivedActive else false) else h' = h
  action dropPinnedConstraintInKv = if (h.pinnedRetained) h' = h.with("pinnedRetained", false) else h' = h
  action restorePinnedConstraintInKv = if (not(h.pinnedRetained)) h' = h.with("pinnedRetained", true) else h' = h
  action serveKvCachedConclusion = if ((h.kvCachedEpoch > 0 and (h.kvCachedEpoch == h.indexEpoch and h.pinnedRetained and not(h.poisonRetracted) and not(h.structuralDrifted) and not(h.negDomainExpanded)))) h' = h.with("validKvServes", (h.validKvServes + 1)).with("kvCacheContaminationViolations", if ((h.kvCachedEpoch == h.indexEpoch and h.pinnedRetained and not(h.poisonRetracted) and not(h.structuralDrifted) and not(h.negDomainExpanded))) h.kvCacheContaminationViolations else (h.kvCacheContaminationViolations + 1)) else h' = h
  action consumeDerivedScenarioBChain = if ((h.rootEvidenceEpoch > 0 and (h.derivedActive and (not(h.poisonRetracted) or h.hasAltCleanSupport) and (not(h.structuralDrifted) or h.hasAltCleanSupport)))) h' = h.with("validEvidenceReuses", (h.validEvidenceReuses + 1)).with("zombieCascadeViolations", if ((h.derivedActive and (not(h.poisonRetracted) or h.hasAltCleanSupport) and (not(h.structuralDrifted) or h.hasAltCleanSupport))) h.zombieCascadeViolations else (h.zombieCascadeViolations + 1)) else h' = h
  action step = any { verifyWithSearchOracle, admitM1Evidence, deriveScenarioBChain, attachAltCleanJustification, applyCommentOnlyEdit, reuseStructuralEvidence, applyStructuralAstDrift, expandNegativeScopeDomain, reconcileAndRefreshEvidence, retractPoisonedEvidence, dropPinnedConstraintInKv, restorePinnedConstraintInKv, serveKvCachedConclusion, consumeDerivedScenarioBChain }
  val safety = (h.staleStructuralReuseViolations == 0 and h.staleNegDomainReuseViolations == 0 and h.kvCacheContaminationViolations == 0 and h.poisonedPromotionViolations == 0 and h.zombieCascadeViolations == 0)
  // Countermodel engineering.defense.search-evidence-chain-integrity.stale-structural-reuse (dropped guard: require-fresh-structural-epoch)
  action reuseStaleStructural = if ((h.rootAdmitted and true and not(h.negDomainExpanded))) h' = h.with("validEvidenceReuses", (h.validEvidenceReuses + 1)).with("staleStructuralReuseViolations", if ((h.rootEvidenceEpoch == h.indexEpoch and not(h.structuralDrifted))) h.staleStructuralReuseViolations else (h.staleStructuralReuseViolations + 1)).with("staleNegDomainReuseViolations", if (not(h.negDomainExpanded)) h.staleNegDomainReuseViolations else (h.staleNegDomainReuseViolations + 1)) else h' = h
  action stepStaleStructuralReuse = any { step, reuseStaleStructural }
  // Countermodel engineering.defense.search-evidence-chain-integrity.stale-neg-domain-reuse (dropped guard: require-neg-domain-unexpanded)
  action reuseStaleNegDomain = if ((h.rootAdmitted and (h.rootEvidenceEpoch == h.indexEpoch and not(h.structuralDrifted)) and true)) h' = h.with("validEvidenceReuses", (h.validEvidenceReuses + 1)).with("staleStructuralReuseViolations", if ((h.rootEvidenceEpoch == h.indexEpoch and not(h.structuralDrifted))) h.staleStructuralReuseViolations else (h.staleStructuralReuseViolations + 1)).with("staleNegDomainReuseViolations", if (not(h.negDomainExpanded)) h.staleNegDomainReuseViolations else (h.staleNegDomainReuseViolations + 1)) else h' = h
  action stepStaleNegDomainReuse = any { step, reuseStaleNegDomain }
  // Countermodel engineering.defense.search-evidence-chain-integrity.kv-cache-contamination (dropped guard: require-kv-epoch-and-pins)
  action serveContaminatedKv = if ((h.kvCachedEpoch > 0 and true)) h' = h.with("validKvServes", (h.validKvServes + 1)).with("kvCacheContaminationViolations", if ((h.kvCachedEpoch == h.indexEpoch and h.pinnedRetained and not(h.poisonRetracted) and not(h.structuralDrifted) and not(h.negDomainExpanded))) h.kvCacheContaminationViolations else (h.kvCacheContaminationViolations + 1)) else h' = h
  action stepKvCacheContamination = any { step, serveContaminatedKv }
  // Countermodel engineering.defense.search-evidence-chain-integrity.poisoned-evidence-promotion (dropped guard: require-oracle-and-no-tombstone)
  action admitPoisonedOrUnverified = if ((not(h.rootAdmitted) and true)) h' = h.with("rootAdmitted", true).with("rootEvidenceEpoch", h.indexEpoch).with("structuralDrifted", false).with("negDomainExpanded", false).with("kvCachedEpoch", h.indexEpoch).with("poisonedPromotionViolations", if ((h.oracleVerified and not(h.poisonRetracted))) h.poisonedPromotionViolations else (h.poisonedPromotionViolations + 1)) else h' = h
  action stepPoisonedEvidencePromotion = any { step, admitPoisonedOrUnverified }
  // Countermodel engineering.defense.search-evidence-chain-integrity.zombie-evidence-cascade (dropped guard: forbid-zombie-derived-chain)
  action consumeZombieDerivedChain = if ((h.rootEvidenceEpoch > 0 and true)) h' = h.with("validEvidenceReuses", (h.validEvidenceReuses + 1)).with("zombieCascadeViolations", if ((h.derivedActive and (not(h.poisonRetracted) or h.hasAltCleanSupport) and (not(h.structuralDrifted) or h.hasAltCleanSupport))) h.zombieCascadeViolations else (h.zombieCascadeViolations + 1)) else h' = h
  action stepZombieEvidenceCascade = any { step, consumeZombieDerivedChain }
  run commentEditPreservesReuseAndStructuralRefreshTest = init.then(verifyWithSearchOracle).then(admitM1Evidence).then(deriveScenarioBChain).then(applyCommentOnlyEdit).then(reuseStructuralEvidence).then(applyStructuralAstDrift).then(reconcileAndRefreshEvidence).then(serveKvCachedConclusion).then(all { assert(safety), assert(h.commentOnlyEdit), assert(h.indexEpoch == 2), assert(h.rootEvidenceEpoch == 2), assert(h.validEvidenceReuses == 1), assert(h.validKvServes == 1), h' = h })
  run atmsAltJustificationSurvivesPoisonRetractionTest = init.then(verifyWithSearchOracle).then(admitM1Evidence).then(deriveScenarioBChain).then(attachAltCleanJustification).then(retractPoisonedEvidence).then(consumeDerivedScenarioBChain).then(all { assert(safety), assert(h.poisonRetracted), assert(h.derivedActive), assert(h.validEvidenceReuses == 1), h' = h })
  run staleStructuralReuseRefutedTest = init.then(verifyWithSearchOracle).then(admitM1Evidence).then(applyStructuralAstDrift).then(reuseStaleStructural).then(all { assert(not(safety)), assert(h.staleStructuralReuseViolations > 0), h' = h })
  run staleNegDomainReuseRefutedTest = init.then(verifyWithSearchOracle).then(admitM1Evidence).then(expandNegativeScopeDomain).then(reuseStaleNegDomain).then(all { assert(not(safety)), assert(h.staleNegDomainReuseViolations > 0), h' = h })
  run kvCacheContaminationRefutedTest = init.then(verifyWithSearchOracle).then(admitM1Evidence).then(applyStructuralAstDrift).then(serveContaminatedKv).then(all { assert(not(safety)), assert(h.kvCacheContaminationViolations > 0), h' = h })
  run poisonedPromotionRefutedTest = init.then(admitPoisonedOrUnverified).then(all { assert(not(safety)), assert(h.poisonedPromotionViolations > 0), h' = h })
  run zombieCascadeRefutedTest = init.then(verifyWithSearchOracle).then(admitM1Evidence).then(deriveScenarioBChain).then(retractPoisonedEvidence).then(consumeZombieDerivedChain).then(all { assert(not(safety)), assert(h.zombieCascadeViolations > 0), h' = h })
}
