# Dual-mode pre-push hook for packages/render (monorepo & standalone split mirror).

set -euo pipefail

PKG_ROOT="$(pwd)"
if [ "${DE_HOOK_FAST:-0}" = "1" ]; then
  echo "[render/pre-push] DE_HOOK_FAST=1 set; skipping render test suite." >&2
  exit 0
fi

if [ -d "$PKG_ROOT/test" ] && command -v bun >/dev/null 2>&1; then
  echo "[render/pre-push] Running packages/render test suite..." >&2
  (cd "$PKG_ROOT" && bun test ./test)
fi
