;;; -*- Gerbil -*-
(import (only-in :gerbil/runtime/loader list-modules) (only-in :std/os/pid getpid) :std/test :std/encoding/json :std/misc/ports :std/list/list (only-in :std/misc/ports read-all-as-u8vector) :clan/poo/object
        :yuanxu/contribution/verification
        :deterministic-engineering/scenarios/resource-lifecycle/review/profile
        :deterministic-engineering/scenarios/resource-lifecycle/review/func
        :deterministic-engineering/scenarios/resource-lifecycle/review/reassessment)
(export backpressure-reassessment-test)
(def (load path) (call-with-input-file path (cut read-json <> object-as-hash: #t)))
(def backpressure-reassessment-test
  (test-suite "Actual source change, complete ASCENT intake and native Aitia disposition"
    (test-case "historical failures cannot disappear through revision scope or stale receipts"
      ;; Observe the actual loader, not a fixture or a claimed backend label.
      (when (getenv "BACKPRESSURE_REVIEW_LIB" #f)
        (let ((files (hash-ref (call-with-input-file (getenv "BACKPRESSURE_REVIEW_SOURCES")
                       (cut read-json <> object-as-hash: #t)) "files")))
        (for-each (lambda (name)
          (def id (string-append "deterministic-engineering/scenarios/resource-lifecycle/review/" name "~0"))
          (def found (assoc id (list-modules)))
          (def prefix (string-append (getenv "BACKPRESSURE_REVIEW_LIB") "/" id ".o"))
          (displayln "NATIVE-OWNER " id " " (and found (cdr found))) (force-output)
          (check-equal? (and found (string? (cdr found))
            (>= (string-length (cdr found)) (string-length prefix))
            (equal? prefix (substring (cdr found) 0 (string-length prefix)))) #t)
          (def reference (and found (assoc (cdr found) files)))
          (check-equal? (and reference (equal? (review-file-digest (car reference)) (cadr reference))) #t))
          '("func" "reassessment"))))
      (def rows (load (getenv "BACKPRESSURE_REASSESSMENT_RUNS")))
      (def (run label) (cadr (assoc label rows)))
      (for-each (lambda (row) (check-equal? (review-file-digest (cadr row)) (caddr row))) rows)
      (def history (open-backpressure-history (getenv "BACKPRESSURE_ACCEPTANCE") (getenv "BACKPRESSURE_REVIEW_SOURCES")))
      (def add! (.ref history 'add-run!))
      (add! (run "A-original64"))
      (def c64 (add! (run "C-repair64")))
      (def out (getenv "BACKPRESSURE_REASSESSMENT_REVIEW_OUTPUT"))
      (when (file-exists? out) (error "review output must be fresh"))
      (create-directory out)
      (displayln "OUTPUT " out) (force-output)
      (def (active-crate name)
        (def directory (path-expand name out)) (create-directory directory)
        (create-directory (path-expand "src" directory))
        (def repaired-source (hash-ref (load (run "C-repair64")) "source"))
        (for-each (lambda (pair)
          (call-with-output-file (path-expand (car pair) directory)
            (lambda (port) (display (call-with-input-file (cadr pair) read-all-as-string) port))))
          (list (list "src/main.rs" repaired-source)
                (list "Cargo.toml" (path-expand "../Cargo.toml" (path-directory repaired-source)))
                (list "Cargo.lock" (path-expand "../Cargo.lock" (path-directory repaired-source)))))
        (path-expand "src/main.rs" directory))
      (def live (active-crate "active"))
      (def repairs c64)
      (def (.profile revision-value (scope-value "bounded-permit-method/M04-M06"))
        (.o (:: @ BackpressureReviewProfile) revision: revision-value scope: scope-value))
      (def (make revision-value (scope-value "bounded-permit-method/M04-M06")
                 failures: (failures #f) dispositions: (dispositions '()))
        (make-backpressure-reassessment history (.profile revision-value scope-value) live failures: failures dispositions: dispositions))
      (def (credentials review)
        (list (reassessment-verify-context review 10 100) (reassessment-verify-content review 10 100)))
      (def steps '()) (def packet-count 0)
      (def (step label review receipts now expected unresolved complete current)
        (def gate (reassessment-stage review receipts now))
        (check-equal? (.ref gate 'status) expected)
        (check-equal? (length (.ref gate 'unresolved)) unresolved)
        (check-equal? (.ref gate 'history-complete?) complete)
        (check-equal? (.ref gate 'current?) current)
        (check-equal? (.ref gate 'release-authorized?) #f)
        (set! packet-count (+ packet-count 1))
        (displayln "GOLD " label " " expected) (force-output)
        (def packet-path (path-expand (string-append label ".json") out))
        (call-with-output-file packet-path (cut display (.ref review 'packet) <>))
        (set! steps (append steps (list (hash ("step" label) ("status" (symbol->string (.ref gate 'status)))
          ("unresolved" (.ref gate 'unresolved)) ("allFailures" (.ref gate 'failure-ids))
          ("complete" (.ref gate 'history-complete?)) ("current" (.ref gate 'current?))
          ("packet" packet-path) ("packetSha256" (review-file-digest packet-path)))))))
      (def initial (make "source-review/r2"))
      ;; The historical audit is not current content issuance. Change an actual
      ;; raw result after construction, persist the original, and refuse issuance.
      (def c64-run (load (run "C-repair64")))
      (def raw-path (hash-ref c64-run "observations"))
      (def raw-bytes (call-with-input-file raw-path read-all-as-u8vector))
      (def raw-sha (review-file-digest raw-path))
      (def raw-backup (path-expand (string-append "reassessment-raw-backup-" (number->string (getpid)) ".bin") out))
      (call-with-output-file raw-backup (cut write-u8vector raw-bytes <>))
      (check-equal? (review-file-digest raw-backup) raw-sha)
      (displayln "ISSUANCE-RAW-BACKUP " raw-backup " " raw-sha " " raw-path) (force-output)
      (dynamic-wind
        (lambda () (call-with-output-file (list path: raw-path append: #t) (cut display "\n" <>)))
        (lambda ()
          (def stale-context (reassessment-verify-context initial 10 100))
          (check-equal? (and stale-context #t) #t)
          (check-equal? (reassessment-verify-content initial 10 100) #f)
          (def stale-gate (reassessment-stage initial (list stale-context) 11))
          (check-equal? (.ref stale-gate 'current?) #f)
          (check-equal? (.ref stale-gate 'status) 'requirements-blocked))
        (lambda () (call-with-output-file (list path: raw-path truncate: #t) (cut write-u8vector raw-bytes <>))))
      (check-equal? (review-file-digest raw-path) raw-sha)
      (def initial-credentials (credentials initial))
      (check-equal? (length (.ref initial 'failure-ids)) 5)
      (def native-failure (find (lambda (id) (not (hash-ref ((.ref history 'entry) id) "diagnostic"))) (.ref initial 'failure-ids)))
      (def presentation ((.ref history 'entry) native-failure))
      (def original-path (caar (hash-ref presentation "dependencies")))
      (set-car! (car (hash-ref presentation "dependencies")) "/caller-mutated-dependency")
      (check-equal? (caar (hash-ref ((.ref history 'entry) native-failure) "dependencies")) original-path)
      (hash-put! presentation "diagnostic" #t)
      (hash-put! presentation "outcome" "pass")
      (check-equal? (hash-ref ((.ref history 'entry) native-failure) "diagnostic") #f)
      (check-equal? (hash-ref ((.ref history 'entry) native-failure) "outcome") "fail")
      (step "01-retained-failures" initial initial-credentials 11 'requirements-blocked 4 #t #t)
      (def omitted (make "source-review/r3" failures: (cdr (.ref initial 'failure-ids))))
      (check-equal? (reassessment-verify-content omitted 10 100) #f)
      (step "02-omitted-history" omitted (filter identity (credentials omitted)) 11 'requirements-blocked 4 #f #t)
      (def duplicate (make "source-review/r3-duplicate" failures: (cons (car (.ref initial 'failure-ids)) (.ref initial 'failure-ids))))
      (check-equal? (reassessment-verify-content duplicate 10 100) #f)
      (def unknown (make "source-review/r3-unknown" failures: (cons "unregistered-failure" (cdr (.ref initial 'failure-ids)))))
      (check-equal? (reassessment-verify-content unknown 10 100) #f)
      (check-exception (make-backpressure-reassessment history (.o (:: @ (.profile "relabel")) identity: 'other-policy) live) (lambda (_) #t))
      (def narrow (make "source-review/r4" "bounded-permit-method/M04"))
      (step "03-scope-cannot-erase" narrow (credentials narrow) 11 'requirements-blocked 4 #t #t)
      (def (dispositions ids)
        (filter-map (lambda (id)
          (def failure ((.ref history 'entry) id))
          (def repair (find (lambda (r)
            (and (equal? (hash-ref r "case") (hash-ref failure "case"))
                 (= (hash-ref r "payloadBytes") (hash-ref failure "payloadBytes")))) repairs))
          (and (not (hash-ref failure "diagnostic")) repair
            (let ((selected-failure id) (selected-repair (hash-ref repair "id")))
              (.o failure: selected-failure repair: selected-repair)))) ids))
      (def (disposition-receipts review)
        (map (lambda (row) (reassessment-verify-disposition review (car row) 10 100)) (.ref review 'disposition-requests)))
      (def failure128 (find (lambda (id) (= (hash-ref ((.ref history 'entry) id) "payloadBytes") 128)) (.ref initial 'failure-ids)))
      (def repair64 (hash-ref (find (lambda (r) (equal? (hash-ref r "case") "M06")) repairs) "id"))
      (def wrong-load (make "wrong-payload" dispositions: (list (.o failure: failure128 repair: repair64))))
      (check-equal? (reassessment-verify-disposition wrong-load failure128 10 100) #f)
      (def repair-other-case (hash-ref (find (lambda (r) (equal? (hash-ref r "case") "M04")) repairs) "id"))
      (def wrong-case (make "wrong-case" dispositions: (list (.o failure: native-failure repair: repair-other-case))))
      (check-equal? (reassessment-verify-disposition wrong-case native-failure 10 100) #f)
      (def partial (make "source-review/r5" dispositions: (dispositions (.ref initial 'failure-ids))))
      (def partial-receipts (append (credentials partial) (disposition-receipts partial)))
      (step "04-payload128-still-open" partial partial-receipts 11 'requirements-blocked 1 #t #t)
      (set! repairs (append repairs (add! (run "C-repair128"))))
      (step "05-intake-change-invalidates" partial partial-receipts 11 'requirements-blocked 4 #t #f)
      (def closed (make "source-review/r6" dispositions: (dispositions (.ref initial 'failure-ids))))
      (def closed-receipts (append (credentials closed) (disposition-receipts closed)))
      (step "06-bounded-dispositions-close" closed closed-receipts 11 'stage-admitted 0 #t #t)
      ;; Register the real regression late: M04 is a new counter, M06 is a new source-bound failure.
      (def b (add! (run "B-regression64")))
      (step "07-late-counter-reopens" closed closed-receipts 11 'requirements-blocked 6 #t #f)
      (def old-list (make "source-review/r7-old-list" failures: (.ref closed 'failure-ids)))
      (step "08-old-list-incomplete" old-list (filter identity (credentials old-list)) 11 'requirements-blocked 6 #f #t)
      (def expanded (make "source-review/r7" dispositions: (dispositions (.ref closed 'failure-ids))))
      (check-equal? (length (.ref expanded 'failure-ids)) 7)
      (def expanded-credentials (credentials expanded))
      (step "09-old-dispositions-insufficient" expanded (append expanded-credentials (disposition-receipts expanded)) 11 'requirements-blocked 2 #t #t)
      (def complete (make "source-review/r8" dispositions: (dispositions (.ref expanded 'failure-ids))))
      (def base-receipts (credentials complete))
      (def requests (.ref complete 'disposition-requests))
      (def first-receipt (reassessment-verify-disposition complete (caar requests) 10 20))
      (def other-receipts (map (lambda (row) (reassessment-verify-disposition complete (car row) 10 100)) (cdr requests)))
      (def all-receipts (append base-receipts (cons first-receipt other-receipts)))
      (step "10-expanded-dispositions-close" complete all-receipts 11 'stage-admitted 0 #t #t)
      (check-equal? (length (.ref complete 'failure-ids)) 7)
      (check-equal? (reassessment-verify-content closed 10 100) #f)
      ;; Native receipt authority is neither copied nor transported to a new revision.
      (step "11-cloned-disposition-denied" complete (append base-receipts (cons (.o (:: @ first-receipt)) other-receipts)) 11 'requirements-blocked 1 #t #t)
      (step "12-expired-disposition-reopens" complete all-receipts 20 'requirements-blocked 1 #t #t)
      (yuanxu-revoke-verification! (.ref complete 'adapter) (car other-receipts))
      (step "13-revoked-disposition-reopens" complete all-receipts 11 'requirements-blocked 1 #t #t)
      (def revision (make "source-review/r9" dispositions: (dispositions (.ref expanded 'failure-ids))))
      (step "14-old-receipts-new-revision" revision all-receipts 11 'context-verification-required 6 #t #t)
      ;; Real on-disk source change after checks; never restore the old bytes to manufacture a pass.
      (call-with-output-file (list path: live append: #t) (cut display "\n// Changed after review: native correspondence needs a fresh run.\n" <>))
      (step "15-real-source-change" complete all-receipts 11 'requirements-blocked 6 #t #f)
      (def changed (make "source-review/r10"))
      (check-equal? (reassessment-verify-content changed 10 100) #f)
      (step "16-revision-does-not-revalidate-source" changed (filter identity (credentials changed)) 11 'requirements-blocked 6 #t #t)
      (def lock-source (active-crate "lock-change-control"))
      (def lock-review (make-backpressure-reassessment history (.profile "source-review/r11") lock-source))
      (def lock-credentials (credentials lock-review))
      (check-equal? (and (cadr lock-credentials) #t) #t)
      (call-with-output-file (list path: (path-expand "../Cargo.lock" (path-directory lock-source)) append: #t)
        (cut display "\n# Lock bytes changed after content verification.\n" <>))
      (check-equal? (reassessment-verify-content lock-review 10 100) #f)
      (step "17-real-lock-change" lock-review lock-credentials 11 'requirements-blocked 6 #t #f)
      (def archive-source (active-crate "archive-control"))
      (def archive-review (make-backpressure-reassessment history (.profile "source-review/r12") archive-source))
      (def archive-credentials (credentials archive-review))
      (def original-record (run "B-regression64"))
      (def unavailable-record (path-expand "temporarily-unavailable-run.json" out))
      (def original-digest (review-file-digest original-record))
      (dynamic-wind
        (lambda () (rename-file original-record unavailable-record))
        (lambda ()
          (check-equal? (reassessment-verify-content archive-review 10 100) #f)
          (step "18-history-source-unavailable" archive-review archive-credentials 11 'requirements-blocked 6 #t #f))
        (lambda () (rename-file unavailable-record original-record)))
      (check-equal? (review-file-digest original-record) original-digest)
      (check-equal? (and (reassessment-verify-content archive-review 10 100) #t) #t)
      (def retained ((.ref history 'capture-stats)))
      (check-equal? (< (.ref retained 'dependency-sets) (.ref retained 'entries)) #t)
      (check-equal? (< (.ref retained 'owned-dependency-items) (.ref retained 'logical-dependency-items)) #t)
      (call-with-output-file (path-expand "retention-work.json" out)
        (cut write-json <> (map (lambda (key) (list (symbol->string key) (.ref retained key)))
          '(entries dependency-sets owned-dependency-items logical-dependency-items))))
      (def snapshot ((.ref history 'exchange) 'snapshot))
      (call-with-output-file (path-expand "history-snapshot.json" out) (cut write-json <> snapshot))
      (call-with-output-file (path-expand "steps.json" out) (cut write-json <> steps)))))
