;;; -*- Gerbil -*-
;;; Real accepted prefix and real signatures; no restored receipt authority.
(import :std/test :std/encoding/json :std/list/list :clan/poo/object
        (only-in :gerbil/runtime/loader list-modules) (only-in :std/os/pid getpid)
        :deterministic-engineering/scenarios/resource-lifecycle/review/archive
        :deterministic-engineering/scenarios/resource-lifecycle/review/signatures
        (only-in :deterministic-engineering/scenarios/resource-lifecycle/review/func review-file-digest))
(export backpressure-archive-cache-test)
(def (load path) (call-with-input-file path (cut read-json <> object-as-hash: #t)))
(def (clone value) (call-with-input-string (json->string value) (cut read-json <> object-as-hash: #t)))
(def (save path value) (call-with-output-file path (cut write-json <> value)))
(def backpressure-archive-cache-test
  (test-suite "Native archive cold read and checked signature relation"
    (test-case "real prefix survives cold read reuse and unavailable references"
      (def out (getenv "BACKPRESSURE_ARCHIVE_CACHE_OUTPUT"))
      (create-directory out)
      (displayln "OUTPUT " out) (displayln "PROCESS " (getpid)) (force-output)
      (when (getenv "BACKPRESSURE_NATIVE_TEST_LIB" #f)
        (let* ((id "deterministic-engineering/t/backpressure-archive-cache-test~0")
               (archive-id "deterministic-engineering/scenarios/resource-lifecycle/review/archive~0")
               (loaded (assoc id (list-modules))) (archive-loaded (assoc archive-id (list-modules)))
               (files (hash-ref (load (getenv "BACKPRESSURE_REVIEW_SOURCES")) "files")))
          (check-equal? (and loaded (cdr loaded))
            (string-append (getenv "BACKPRESSURE_NATIVE_TEST_LIB") "/" id ".o1"))
          (check-equal? (and archive-loaded (cdr archive-loaded))
            (string-append (getenv "BACKPRESSURE_REVIEW_LIB") "/" archive-id ".o1"))
          (for-each (lambda (row)
            (let (captured (assoc (cdr row) files))
              (check-equal? (and captured
                (equal? (review-file-digest (car captured)) (cadr captured))) #t))) (list loaded archive-loaded))))
      (def original-selection (hash-ref (load (getenv "BACKPRESSURE_ARCHIVE_CACHE_ACK")) "selection"))
      (def original-archive (load (hash-ref original-selection "archive")))
      (def original-ids (map car (hash-ref original-archive "records")))
      (check-equal? (length original-ids) 3)
      (def reader (recovery-reader-identity))
      (def selection original-selection)
      (def tools (review-signature-tools (getenv "BACKPRESSURE_OPENSSL") out))
      (def (p name) (path-expand name out))
      (def (head)
        (let ((selected-path (hash-ref selection "headPath"))
              (selected-digest (hash-ref selection "headDigest"))
              (selected-signature (hash-ref selection "signature")))
          (.o path: selected-path digest: selected-digest signature: selected-signature)))
      (def mandate
        (let ((selected-owner (hash-ref original-selection "owner"))
              (selected-cut (hash-ref original-selection "cut"))
              (selected-archive (hash-ref original-selection "archive"))
              (selected-public (getenv "BACKPRESSURE_ARCHIVE_CACHE_ROOT_PUBLIC"))
              (selected-reader reader) (selected-head head))
          (.o owner: selected-owner cut: selected-cut archive: selected-archive
              root-public: selected-public reader: selected-reader head: selected-head)))
      (def source (open-archived-review-source mandate tools))
      (def steps '())
      (def (verify-count)
        (length (filter (lambda (name)
          (and (string-prefix? "crypto-" name) (string-suffix? ".json" name)
            (let (argv (hash-ref (load (p name)) "argv"))
              (and (member "-verify" argv) (member (p "active.json") argv))))) (directory-files out))))
      (def (step label expected)
        (def captured ((.ref source 'handover-capture)))
        (def status ((.ref source 'status)))
        (check-equal? status expected)
        (check-equal? (and captured #t) (eq? expected 'archive-available))
        (when captured (check-equal? (map car (.ref captured 'records)) original-ids))
        (set! steps (append steps (list (hash ("id" label) ("status" (symbol->string status))
          ("available" (and captured #t)) ("verifyCount" (verify-count))
          ("head" selection) ("reader" reader)
          ("signatureObservedSha256" (review-file-digest (hash-ref selection "signature")))
          ("recordObservedSha256" (let (path (caar (caddr (car (hash-ref original-archive "records")))))
            (and (file-exists? path) (review-file-digest path))))
          ("native" (and captured (.ref captured 'native)))
          ("records" (and captured (clone (.ref captured 'records))))))))
        (displayln "GOLD " label " " status) (force-output) captured)
      (step "AC01-closed-head-pending" 'history-discovery-required)
      (def active (load (hash-ref original-selection "headPath")))
      (hash-put! active "state" "active") (hash-put! active "reader" reader)
      (save (p "active.json") active)
      ((.ref tools 'sign) (getenv "BACKPRESSURE_ARCHIVE_CACHE_ROOT_KEY") (p "active.json") (p "active.sig"))
      (set! selection (clone original-selection))
      (hash-put! selection "headPath" (p "active.json"))
      (hash-put! selection "headDigest" (review-file-digest (p "active.json")))
      (hash-put! selection "signature" (p "active.sig"))
      (step "AC02-first-active-capture" 'archive-available)
      (check-equal? (verify-count) 1)
      (def repeated (step "AC03-private-cache-reuse" 'archive-available))
      (check-equal? (verify-count) 1)
      (hash-put! (cadar (.ref repeated 'records)) "decision" "public-mutation")
      (def isolated (step "AC04-public-mutation-isolated" 'archive-available))
      (check-equal? (hash-ref (cadar (.ref isolated 'records)) "decision") "rejected")
      (def record (caar (caddr (car (hash-ref original-archive "records")))))
      (def record-sha (review-file-digest record))
      (displayln "ARCHIVE-CACHE-BACKUP " record " " (p "record.unavailable") " " record-sha) (force-output)
      (dynamic-wind (lambda () (rename-file record (p "record.unavailable")))
        (lambda () (step "AC05-record-unavailable" 'history-discovery-required))
        (lambda () (rename-file (p "record.unavailable") record)))
      (check-equal? (review-file-digest record) record-sha)
      (step "AC06-exact-record-restoration" 'archive-available)
      (check-equal? (verify-count) 1)
      (def signature-sha (review-file-digest (p "active.sig")))
      (displayln "ARCHIVE-CACHE-BACKUP " (p "active.sig") " " (p "signature.unavailable") " " signature-sha) (force-output)
      (dynamic-wind (lambda ()
          (rename-file (p "active.sig") (p "signature.unavailable"))
          (call-with-output-file (p "active.sig") (cut display "invalid-signature" <>))
          (copy-file (p "active.sig") (p "invalid-signature.bin")))
        (lambda () (step "AC07-head-signature-tamper" 'archive-refused))
        (lambda () (delete-file (p "active.sig")) (rename-file (p "signature.unavailable") (p "active.sig"))))
      (check-equal? (review-file-digest (p "active.sig")) signature-sha)
      (step "AC08-exact-signature-restoration" 'archive-available)
      (check-equal? (verify-count) 2)
      (save (p "steps.json") steps)
      (save (p "input.json") (hash ("archive" original-selection)
        ("rootPublic" (getenv "BACKPRESSURE_ARCHIVE_CACHE_ROOT_PUBLIC"))
        ("receiptMetadataIsAuthority" #f))))))
