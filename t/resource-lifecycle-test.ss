;;; -*- Gerbil -*-
(import :std/test :std/encoding/json :clan/poo/object :deterministic-engineering/init)
(export resource-lifecycle-test)
(def resource-lifecycle-test
  (test-suite "Rust mechanism ownership and actual evidence"
    (test-case "direct migration publishes one Library to independent applications"
      (check-equal? (.slot? (.get deterministic-engineering.init.exports Library) 'gateway-domain) #f)
      (check-equal? (.slot? (.get deterministic-engineering.init.exports Library) 'gateway-evidence) #f)
      (check-equal? (.get (.get deterministic-engineering.init.exports Library) rust-resources entry identity) 'rust.resources.backpressure-memory)
      (check-equal? (.get (.get deterministic-engineering.init.exports Library) resource-lifecycle entry identity)
                    (.get (.get deterministic-engineering.init.exports Library) gateway-review entry identity)))
    (test-case "actual native/QNT/Lean receipts and change queries match independent gold"
      (def path (getenv "RESOURCE_REAL_REPORT" #f))
      (unless path (error "run examples/resource-lifecycle-evidence.ss and set RESOURCE_REAL_REPORT"))
      (def methods (.get (.get deterministic-engineering.init.exports Library) rust-resources methods))
      (def digest (.ref methods 'file-digest))
      (def (load p) (call-with-input-file p (cut read-json <> object-as-hash: #t)))
      (def report (load path))
      (check-equal? (hash-ref report "schema") "rust.resource-investigation.v1")
      (check-equal? (hash-ref report "status") "passed")
      (check-equal? (hash-ref report "nativeRuns") 3)
      (check-equal? (hash-ref report "nativePerformanceMeasured") #f)
      (def (files-current pairs)
        (for-each (lambda (p) (check-equal? (digest (car p)) (cadr p))) pairs))
      (files-current (hash-ref report "sourceInputs"))
      (files-current (hash-ref report "queries"))
      (files-current (hash-ref report "nativeExchanges"))
      (def results (hash-ref report "results")) (check-equal? (length results) 22)
      (def native-count 0) (def native-counters 0) (def qnt-count 0) (def lean-count 0)
      (for-each (lambda (d)
        (def observation (load (hash-ref d "recordPath")))
        (def review (load (hash-ref d "reviewPath")))
        (check-equal? (hash-ref review "result") (string-append "sha256:" (digest (hash-ref d "recordPath"))))
        (files-current (hash-ref observation "inputs")) (files-current (hash-ref observation "artifacts"))
        (for-each (lambda (command)
          (check-equal? (digest (hash-ref command "log")) (hash-ref command "logSha256")))
          (hash-ref observation "commands"))
        (def method (hash-ref observation "method"))
        (def oracle (hash-ref review "oracle"))
        (cond
          ((equal? method "native")
            (set! native-count (+ native-count 1))
            (for-each (lambda (command) (check-equal? (hash-ref command "exit") 0)) (hash-ref observation "commands"))
            (check-equal? (hash-ref oracle "finalLive") 0)
            (check-equal? (hash-ref oracle "finalAvailable") 1)
            (check-equal? (hash-ref observation "outcome") (hash-ref oracle "outcome"))
            (when (equal? (hash-ref oracle "case") "M06")
              (set! native-counters (+ native-counters 1))
              (check-equal? (hash-ref oracle "heldLive") 1)
              (check-equal? (hash-ref oracle "heldAvailable") 1)))
          ((equal? method "quint")
            (set! qnt-count (+ qnt-count 1))
            (if (equal? (hash-ref observation "outcome") "pass")
              (check-equal? (hash-ref oracle "states") 352)
              (check-equal? (hash-ref oracle "violation") #t)))
          ((equal? method "lean")
            (set! lean-count (+ lean-count 1))
            (check-equal? (hash-ref oracle "within") #t)))) results)
      ;; A corrupted observation cannot be accepted by the independent oracle.
      (def native-result (find (lambda (d)
        (equal? (hash-ref (load (hash-ref d "recordPath")) "method") "native")) results))
      (def native-record (load (hash-ref native-result "recordPath")))
      (def artifact (find (lambda (p) (string-contains (car p) "/observations.json")) (hash-ref native-record "artifacts")))
      (def corrupted (load (car artifact)))
      (check-equal? (length ((.ref methods 'native-oracle) corrupted)) 6)
      (def held (find (lambda (e) (equal? (hash-ref e "event") "held"))
        (hash-ref (car (hash-ref corrupted "cases")) "events")))
      (hash-put! held "live" 0)
      (check-exception ((.ref methods 'native-oracle) corrupted) (lambda (_) #t))
      (check-equal? native-count 18) (check-equal? native-counters 3)
      (check-equal? qnt-count 2) (check-equal? lean-count 2)
      (def expected '(("01-discovery" 0 0 0) ("02-formal-results" 2 0 2)
        ("03-native-results" 7 1 8) ("04-source-old-native" 2 0 8)
        ("05-source-revalidated" 7 1 14) ("06-larger-before-checks" 1 0 14)
        ("07-larger-revalidated" 7 1 21) ("08-rejections-preserve-history" 7 1 21)
        ("09-early-release-model-counter" 6 2 22)))
      (for-each (lambda (gold)
        (def row (find (lambda (p) (string-contains (car p) (string-append (car gold) ".json"))) (hash-ref report "queries")))
        (check-equal? (and row #t) #t)
        (def query (load (car row)))
        (check-equal? (length (hash-ref query "support")) (cadr gold))
        (check-equal? (length (hash-ref query "counter")) (caddr gold))
        (check-equal? (length (hash-ref query "witness")) (cadddr gold))) expected)
      (check-equal? (hash-ref report "rejections") '("changed-lock" "changed-owned-source" "JSON-is-not-issuer")))))
