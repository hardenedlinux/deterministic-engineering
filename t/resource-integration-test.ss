;;; -*- Gerbil -*-
(import :clan/poo/object :std/test :std/encoding/json
        (only-in :std/crypto/digest sha256) (only-in :std/encoding/hex hex-encode)
        (only-in :std/misc/ports read-all-as-u8vector)
        "../library/rust-resources/correspondence.ss"
        "../library/rust-resources/objects.ss"
        "../library/backpressure-tokio-rayon/objects.ss"
        "../library/backpressure-memory/objects.ss")
(def selected-method-references
  (map (lambda (key) (method-ref (.ref RustMethodDefinitions key))) '(native quint lean)))
(def selected-integration-reference
  (method-ref (.get RustMethodDefinitions integration)))
(def selected-integration (make-backpressure-integration (specialize-backpressure BackpressureModel selected-method-references) selected-integration-reference))
(export resource-integration-test)
(def (load-json path) (call-with-input-file path (cut read-json <> object-as-hash: #t)))
(def (copy-json value) (call-with-input-string (json->string value) (cut read-json <> object-as-hash: #t)))
(def (digest path) (hex-encode (sha256 (call-with-input-file path read-all-as-u8vector))))
(def (integration-report)
  (def path (getenv "RESOURCE_INTEGRATION_REPORT" #f))
  (unless path (error "fresh integrated investigation report required"))
  (load-json path))
(def (native-observation report)
  (def native (find (lambda (r) (equal? (hash-ref (hash-ref r "observation") "method") "native"))
                    (hash-ref report "results")))
  (def row (find (lambda (p) (equal? (path-strip-directory (car p)) "observations.json"))
                 (hash-ref (hash-ref native "observation") "artifacts")))
  (load-json (car row)))
(def resource-integration-test
  (test-suite "Backpressure integrated evidence and malformed trace controls"
    (test-case "actual method artifacts bind all cases and preserve counters on mapping change"
      (def report (integration-report))
      (check-equal? (hash-ref report "status") "passed")
      (check-equal? (hash-ref report "completeRustRefinement") #f)
      (check-equal? (hash-ref report "nativeAuthorityIssued") #f)
      (check-equal? (hash-ref report "caseLinks")
                    '(("RL-M01" "SI-M01" "TM-M01") ("RL-M02" "SI-M02" "TM-M02")
                      ("RL-M03" "SI-M03" "TM-M03") ("RL-M04" "SI-M04" "TM-M04")
                      ("RL-M05" "SI-M05" "TM-M05") ("RL-M06" "SI-M06" "TM-M06")))
      (def results (hash-ref report "results"))
      (check-equal? (length results) 20)
      (for-each (lambda (r)
                  (def observation (hash-ref r "observation"))
                  (def record (hash-ref r "recordPath"))
                  (check-equal? (hash-ref (load-json record) "obligation") (hash-ref observation "obligation"))
                  (check-equal? (hash-ref (load-json (hash-ref r "reviewPath")) "result")
                                (string-append "sha256:" (digest record)))
                  (for-each (lambda (p) (check-equal? (digest (car p)) (cadr p)))
                            (append (hash-ref observation "inputs") (hash-ref observation "artifacts")))) results)
      (def (obligations key q) (map cadr (hash-ref q key)))
      (def current (hash-ref report "current"))
      (check-equal? (length (hash-ref current "support")) 17)
      (for-each (lambda (id) (check-equal? (and (member id (obligations "counter" current)) #t) #t))
                '("RL-M06" "SI-M06" "TM-M06"))
      (def changed (hash-ref report "mappingChanged"))
      (check-equal? (length (hash-ref changed "support")) 7)
      (check-equal? (obligations "counter" changed) '("RL-M06"))
      (check-equal? (length (hash-ref changed "witness")) 20))
    (test-case "complete observations map to five paths and one retained reservation counter"
      (def projections (resource-trace-projections selected-integration (native-observation (integration-report))))
      (check-equal? (map (cut hash-ref <> "outcome") projections) '("pass" "pass" "pass" "pass" "pass" "fail"))
      (for-each (lambda (p)
                  (check-equal? (length (hash-ref p "states")) (+ 1 (hash-ref p "steps")))
                  (check-equal? (hash-ref (car (hash-ref p "states")) "stage") "waiting")
                  (check-equal? (hash-ref (car (reverse (hash-ref p "states"))) "stage") "done")) projections))
    (test-case "missing, duplicated, unknown and reordered events refuse instead of passing"
      (def input (native-observation (integration-report)))
      (for-each (lambda (mutate)
                  (def report (copy-json input))
                  (def c (car (hash-ref report "cases")))
                  (mutate report c)
                  (check-exception (resource-trace-projections selected-integration report) (lambda (_) #t)))
                (list
                 (lambda (r c) (hash-put! c "events" (cdr (hash-ref c "events"))))
                 (lambda (r c) (hash-put! c "events" (cons (car (hash-ref c "events")) (hash-ref c "events"))))
                 (lambda (r c) (hash-put! c "events" (append (hash-ref c "events") (list (hash ("event" "unmapped"))))))
                 (lambda (r c) (hash-put! c "events" (reverse (hash-ref c "events"))))
                 (lambda (r c) (hash-put! r "cases" (cdr (hash-ref r "cases"))))
                 (lambda (r c) (hash-put! r "capacity" 2))
                 (lambda (r c) (hash-put! r "payloadBytes" 0))
                 (lambda (r c)
                   (def held (find (lambda (e) (equal? (hash-ref e "event") "held")) (hash-ref c "events")))
                   (hash-put! held "available" 1)))))))
