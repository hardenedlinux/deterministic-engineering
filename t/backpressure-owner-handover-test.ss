;;; -*- Gerbil -*-
(import (only-in :gerbil/runtime/loader list-modules) :std/test :std/encoding/json :std/list/list :clan/poo/object (only-in :std/os/pid getpid)
        :yuanxu/contribution/verification
        :agentic-ai-lab/lambda-aitia/modules/sdlc/review-authority
        :deterministic-engineering/scenarios/resource-lifecycle/review/interface)
(export backpressure-owner-handover-test)
(def (load path) (call-with-input-file path (cut read-json <> object-as-hash: #t)))
(def (save path value) (call-with-output-file path (cut write-json <> value)))
(def backpressure-owner-handover-test
  (test-suite "Real cross-owner handover through native Aitia discovery"
    (test-case "owner handover retains the complete historical rejection inventory"
      (when (getenv "BACKPRESSURE_NATIVE_TEST_LIB" #f)
        (let* ((id "deterministic-engineering/t/backpressure-owner-handover-test~0")
               (loaded (assoc id (list-modules)))
               (prefix (string-append (getenv "BACKPRESSURE_NATIVE_TEST_LIB") "/" id ".o")))
          (displayln "NATIVE-TEST " id " " (and loaded (cdr loaded))) (force-output)
          (check-equal? (and loaded (string? (cdr loaded))
            (>= (string-length (cdr loaded)) (string-length prefix))
            (equal? prefix (substring (cdr loaded) 0 (string-length prefix)))) #t)
          (def captured (assoc (cdr loaded) (hash-ref (load (getenv "BACKPRESSURE_REVIEW_SOURCES")) "files")))
          (check-equal? (and captured (equal? (review-file-digest (car captured)) (cadr captured))) #t)))
      (def out (getenv "BACKPRESSURE_CROSS_OUTPUT"))
      (when (file-exists? out) (error "cross-intake output must be fresh"))
      (create-directory out)
      (displayln "OUTPUT " out) (displayln "PROCESS " (getpid)) (force-output)
      (def group (getenv "BACKPRESSURE_HANDOVER_GROUP" "all"))
      (displayln "GROUP " group) (force-output)
      (def rows (load (getenv "BACKPRESSURE_REASSESSMENT_RUNS")))
      (for-each (lambda (row) (check-equal? (review-file-digest (cadr row)) (caddr row))) rows)
      (def (run label) (cadr (assoc label rows)))
      (def (history) (open-backpressure-history (getenv "BACKPRESSURE_ACCEPTANCE") (getenv "BACKPRESSURE_REVIEW_SOURCES")))
      (def group-owners (open-cross-intake-group '("intake-a" "intake-b")
        (getenv "BACKPRESSURE_ACCEPTANCE") (getenv "BACKPRESSURE_REVIEW_SOURCES")))
      (def a (car (.ref group-owners 'histories))) (def b (cadr (.ref group-owners 'histories)))
      (def repairs
        (let (registered ((.ref a 'add-runs!) (map run '("A-original64" "C-repair64" "C-repair128"))))
          (append (cadr registered) (caddr registered))))
      (def source (hash-ref (load (run "C-repair64")) "source"))
      (def profile (.o (:: @ BackpressureReviewProfile) revision: "cross-intake/r1" scope: "bounded-permit-method/M04-M06"))
      (def (with-repairs selected)
        (def expected (map cadr (hash-ref (cadr ((.ref selected 'capture))) "counterevidence")))
        (def dispositions (filter-map (lambda (id)
          (def failure ((.ref selected 'entry) id))
          (def repair (find (lambda (r) (and (equal? (hash-ref r "case") (hash-ref failure "case"))
            (= (hash-ref r "payloadBytes") (hash-ref failure "payloadBytes")))) repairs))
          (and (not (hash-ref failure "diagnostic")) repair
            (let ((selected-id id) (selected-repair (hash-ref repair "id"))) (.o failure: selected-id repair: selected-repair)))) expected))
        (make-backpressure-reassessment selected profile source dispositions: dispositions))
      (def (credentials review)
        (append (list (reassessment-verify-context review 10 200) (reassessment-verify-content review 10 200))
          (map (lambda (row) (reassessment-verify-disposition review (car row) 10 200)) (.ref review 'disposition-requests))))
      (displayln "PHASE original records and repaired runs registered") (force-output)
      (def local (with-repairs a)) (def local-receipts (credentials local))
      (check-equal? (.ref (reassessment-stage local local-receipts 11) 'status) 'stage-admitted)
      ;; B discovers two actual failures absent from A; their original IDs survive the union.
      ((.ref b 'add-run!) (run "B-regression64"))
      (def federation (.ref group-owners 'federation))
      (def merged ((.ref federation 'capture)))
      (check-equal? (length (hash-ref (car merged) "clues")) 46)
      (check-equal? (length (hash-ref (cadr merged) "counterevidence")) 7)
      (save (path-expand "history-capture.json" out) merged)
      (save (path-expand "intake-captures.json" out) ((.ref federation 'discover)))
      (def omitted (make-backpressure-reassessment federation profile source failures: (.ref local 'failure-ids)))
      (check-equal? (reassessment-verify-content omitted 10 100) #f)
      (displayln "PHASE complete native union queried") (force-output)
      (save (path-expand "registration-work.json" out)
        (map (lambda (binding)
          (def stats ((.ref (cdr binding) 'registration-stats)))
          (list (car binding) (.ref stats 'batches) (.ref stats 'logical-dependency-references)
            (.ref stats 'checked-dependency-paths)))
          (list (cons "intake-a" a) (cons "intake-b" b) (cons "aggregate" federation))))
      (def mechanical (with-repairs federation))
      (check-equal? (.ref (reassessment-stage mechanical local-receipts 11) 'admitted?) #f)
      ((.ref federation 'current!))
      (check-equal? (hash-ref (cadr ((.ref federation 'capture))) "viewIdentity") (hash-ref (cadr merged) "viewIdentity"))
      (def mechanical-receipts (credentials mechanical))
      (def diagnostic (reassessment-stage mechanical mechanical-receipts 11))
      (save (path-expand "mechanical-diagnostic.json" out) (hash
        ("receipts" (map (lambda (r) (and r #t)) mechanical-receipts))
        ("current" (.ref diagnostic 'current?)) ("complete" (.ref diagnostic 'history-complete?))
        ("unresolved" (.ref diagnostic 'unresolved))
        ("covers" (map cadr (.ref mechanical 'disposition-requests)))))
      (check-equal? (.ref (reassessment-stage mechanical mechanical-receipts 11) 'status) 'stage-admitted)
      (check-equal? (length (.ref mechanical 'failure-ids)) 7)
      (call-with-output-file (path-expand "mechanical-packet.json" out) (cut display (.ref mechanical 'packet) <>))
      ;; Setup-only counterexamples retain no authority after their assertions.
      ;; Keep the live histories, current requests, and current receipts intact.
      (set! repairs '()) (set! local #f) (set! local-receipts '())
      (set! omitted #f) (set! diagnostic #f) (set! merged #f)
      (def tools (review-signature-tools (getenv "BACKPRESSURE_OPENSSL") out))
      (def (p name) (path-expand name out))
      (for-each (lambda (name) ((.ref tools 'generate) (p (string-append name ".key")) (p (string-append name ".pub")))) '("root" "alice" "bob"))
      (save (p "directory.json") (hash ("sources" '("intake-a" "intake-b")) ("requiredSigner" "test-reviewer-a")
        ("policies" '("approval/v1" "approval/v2")) ("qualificationOnly" #t)))
      ((.ref tools 'sign) (p "root.key") (p "directory.json") (p "directory.sig"))
      (def changed-body (load (p "mechanical-packet.json")))
      (hash-put! changed-body "scope" "bounded-permit-method/M04")
      (def changed-mechanical (.o (:: @ mechanical) packet: (json->string changed-body)))
      (check-exception (open-cross-intake-approval federation changed-mechanical tools
        (p "directory.json") (p "directory.sig") (p "root.pub") (p "alice.pub") (p "bob.pub")) (lambda (_) #t))
      (def authority (open-cross-intake-approval federation mechanical tools (p "directory.json") (p "directory.sig")
        (p "root.pub") (p "alice.pub") (p "bob.pub")))
      (def (open-owner previous)
        (open-cross-intake-approval federation mechanical tools (p "directory.json") (p "directory.sig")
          (p "root.pub") (p "alice.pub") (p "bob.pub") predecessor: previous))
      (def (verified selected)
        (filter identity (cons (yuanxu-verify (.ref selected 'adapter) (.ref selected 'discovery-request) 10 100)
          (map (lambda (row) (yuanxu-verify (.ref selected 'adapter) (cadr row) 10 100)) (.ref selected 'approval-requests)))))
      (def (decision selected name outcome supersedes)
        (save (p (string-append name ".json")) (hash ("signer" "test-reviewer-a") ("policy" "approval/v1")
          ("decision" outcome) ("reason" name) ("supersedes" supersedes) ("target" ((.ref selected 'target) "approval/v1"))))
        ((.ref tools 'sign) (p "alice.key") (p (string-append name ".json")) (p (string-append name ".sig")))
        (def submitted-path (p (string-append name ".json")))
        (def submitted-signature (p (string-append name ".sig")))
        (def identity ((.ref selected 'submit!) submitted-path submitted-signature))
        ;; Caller-owned text must not mutate privately accepted reference paths.
        (string-set! submitted-path 0 #\X) (string-set! submitted-signature 0 #\X)
        identity)
      (def (grant previous next name (omit? #f))
        (def capture ((.ref previous 'handover-capture)))
        (save (p (string-append name "-capture.json")) (hash ("owner" (.ref capture 'owner))
          ("cut" (.ref capture 'cut)) ("native" (.ref capture 'native)) ("records" (.ref capture 'records))))
        (save (p (string-append name ".json")) (hash ("schema" "aitia.owner-handover/v1")
          ("from" (.ref previous 'owner)) ("to" (.ref next 'owner))
          ("technicalDigest" (.ref next 'technical-digest)) ("cut" (.ref capture 'cut))
          ("records" (if omit? '() (map car (.ref capture 'records))))))
        ((.ref tools 'sign) (p "root.key") (p (string-append name ".json")) (p (string-append name ".sig")))
        (list (p (string-append name ".json")) (p (string-append name ".sig"))))
      (def steps '())
      (def (step label owner selected receipts expected)
        (def n (string->number (substring label 2 4)))
        (when (or (equal? group "all") (and (equal? group "transfer") (<= n 9))
                  (and (equal? group "reuse") (> n 9)))
          (let ()
          (def result ((.ref selected 'gate) mechanical-receipts receipts 11))
          (save (p (string-append label "-guard.json")) (hash
            ("actual" (symbol->string (.ref result 'status))) ("expected" (symbol->string expected))
            ("currentCheck" ((.ref selected 'current-check))) ("receiptCount" (length receipts))
            ("parentCut" (let (capture ((.ref authority 'handover-capture))) (and capture (.ref capture 'cut))))
            ("packet" (.ref selected 'packet))
            ("receiptValidity" (map (lambda (request)
              (map (lambda (receipt) (and (yuanxu-verification-valid? (.ref selected 'adapter) receipt request 11) #t)) receipts))
              (cons (.ref selected 'discovery-request) (map cadr (.ref selected 'approval-requests)))))))
          (check-equal? (.ref result 'status) expected)
          (check-equal? (.ref result 'current-use-checked?) #t)
          (check-equal? (.ref result 'release-authorized?) #f)
          (def input (p (string-append label "-input.json")))
          (call-with-output-file input (cut display (.ref selected 'packet) <>))
          (def presentation (p (string-append label "-presentation.json")))
          (def prescribed (load input))
          (save presentation (hash
            ("handoverFilesNow" (map (lambda (pair) (list (car pair)
              (with-catch (lambda (_) #f) (lambda () (review-file-digest (car pair))))))
              (hash-ref prescribed "handoverReferences")))
            ("acceptedNow" ((.ref owner 'accepted-decisions)))
            ("nativeRequests" (map sdlc-review-authority-snapshot
              (cons (.ref selected 'discovery-request) (map cadr (.ref selected 'approval-requests)))))
            ("predecessorNow" (let (capture ((.ref authority 'handover-capture)))
              (and capture (list (.ref capture 'owner) (.ref capture 'cut) (.ref capture 'native)))))
            ("receiptMetadataIsAuthority" #f)))
          (set! steps (append steps (list (hash ("step" label) ("status" (symbol->string (.ref result 'status)))
            ("goldStatus" (symbol->string expected)) ("failures" (.ref (.ref result 'technical) 'failure-ids))
            ("input" (list input (review-file-digest input)))
            ("presentation" (list presentation (review-file-digest presentation)))))))
          (displayln "GOLD " label " " expected) (force-output))))
      (def rejection (decision authority "old-rejected" "rejected" '()))
      (check-equal? (string? rejection) #t)
      (def old-frame ((.ref authority 'frame) "approval/v1"))
      (def old-receipts (verified old-frame))
      (step "OH01-old-rejection" authority old-frame old-receipts 'approval-rejected)
      (def successor (open-owner authority))
      (def blank ((.ref successor 'frame) "approval/v1"))
      (step "OH02-reopen-before-handover" successor blank (verified blank) 'history-discovery-required)
      ;; An incomplete owner cannot become a complete predecessor for a third owner.
      (check-equal? ((.ref successor 'handover-capture)) #f)
      (def incomplete (grant authority successor "incomplete" #t))
      (check-equal? (apply (.ref successor 'accept-handover!) incomplete) 'handover-refused)
      (step "OH03-incomplete-inventory" successor blank (verified blank) 'history-discovery-required)
      (def complete (grant authority successor "complete"))
      (def supplied-complete (map string-copy complete))
      (check-equal? (apply (.ref successor 'accept-handover!) supplied-complete) 'handover-accepted)
      (string-set! (car supplied-complete) 0 #\X) (string-set! (cadr supplied-complete) 0 #\X)
      (def transferred ((.ref successor 'frame) "approval/v1"))
      (step "OH04-old-receipts-not-transferred" successor transferred old-receipts 'history-discovery-required)
      (def transferred-receipts (verified transferred))
      (step "OH05-reverified-old-rejection" successor transferred transferred-receipts 'approval-rejected)
      (def policy2 ((.ref successor 'frame) "approval/v2"))
      (step "OH06-policy-change" successor policy2 (verified policy2) 'approval-rejected)
      (def other (open-owner authority))
      (check-equal? (apply (.ref other 'accept-handover!) complete) 'handover-refused)
      (def other-frame ((.ref other 'frame) "approval/v1"))
      (step "OH07-wrong-recipient" other other-frame (verified other-frame) 'history-discovery-required)
      (check-equal? (string? (decision successor "generic-approval" "approved" '())) #t)
      (def generic ((.ref successor 'frame) "approval/v1"))
      (step "OH08-generic-new-owner-approval" successor generic (verified generic) 'approval-rejected)
      (check-equal? (string? (decision successor "explicit-resolution" "approved" (list rejection))) #t)
      (def resolved ((.ref successor 'frame) "approval/v1"))
      (def resolved-receipts (verified resolved))
      (step "OH09-explicit-resolution" successor resolved resolved-receipts 'review-admitted)
      (step "OH10-same-cut-evidence-reuse" successor resolved resolved-receipts 'review-admitted)
      (dynamic-wind (lambda () (rename-file (car complete) (p "handover.unavailable")))
        (lambda () (step "OH11-missing-handover-document" successor resolved resolved-receipts 'history-discovery-required))
        (lambda () (rename-file (p "handover.unavailable") (car complete))))
      (step "OH12-identical-document-restored" successor resolved resolved-receipts 'review-admitted)
      ;; Same members and parent cut, but a different active grant reference.
      (def before-rebind ((.ref successor 'handover-capture)))
      (def rebound-grant (grant authority successor "same-cut-new-grant"))
      (check-equal? (apply (.ref successor 'accept-handover!) rebound-grant) 'handover-accepted)
      (def after-rebind ((.ref successor 'handover-capture)))
      (check-equal? (map car (.ref before-rebind 'records)) (map car (.ref after-rebind 'records)))
      (check-equal? (equal? (.ref before-rebind 'cut) (.ref after-rebind 'cut)) #f)
      (def stale-rebind ((.ref resolved 'gate) mechanical-receipts resolved-receipts 11))
      (check-equal? (.ref stale-rebind 'status) 'history-discovery-required)
      (save (p "lineage-rebind.json") (hash ("before" (.ref before-rebind 'native))
        ("after" (.ref after-rebind 'native)) ("beforeCut" (.ref before-rebind 'cut))
        ("afterCut" (.ref after-rebind 'cut)) ("oldFrameStatus" (symbol->string (.ref stale-rebind 'status)))))
      (set! resolved ((.ref successor 'frame) "approval/v1"))
      (set! resolved-receipts (verified resolved))
      (def late (decision authority "late-old-counter" "rejected" '()))
      (check-equal? (string? late) #t)
      (step "OH13-predecessor-advanced" successor resolved resolved-receipts 'history-discovery-required)
      (check-equal? (apply (.ref successor 'accept-handover!) complete) 'handover-refused)
      (def renewed (grant authority successor "renewed"))
      (check-equal? (apply (.ref successor 'accept-handover!) renewed) 'handover-accepted)
      (def reopened ((.ref successor 'frame) "approval/v1"))
      (def reopened-receipts (verified reopened))
      (step "OH14-new-counter-retained" successor reopened reopened-receipts 'approval-rejected)
      ;; The old positive remains in the new owner's inventory, but cannot close the new counter.
      (check-equal? (length ((.ref successor 'accepted-decisions))) 4)
      (def history-before ((.ref successor 'handover-capture)))
      (check-equal? (string? (.ref history-before 'cut)) #t)
      ((.ref authority 'close!))
      (check-equal? ((.ref authority 'handover-capture)) #f)
      (step "OH15-old-owner-unavailable" successor reopened reopened-receipts 'history-discovery-required)
      (check-equal? (apply (.ref successor 'accept-handover!) renewed) 'history-discovery-required)
      (def again (open-owner authority))
      (def again-frame ((.ref again 'frame) "approval/v1"))
      (step "OH16-reopen-unavailable-owner" again again-frame (verified again-frame) 'history-discovery-required)
      (check-equal? ((.ref successor 'handover-capture)) #f)
      (save (p "steps.json") steps)
      (def work ((.ref federation 'sync-stats)))
      (save (p "sync-work.json") (hash ("rebuilds" (.ref work 'rebuilds)) ("reuses" (.ref work 'reuses)))))))
