;;; -*- Gerbil -*-
(import :std/test :clan/poo/object :gerbil-ascent/rules/interface
        (only-in :clan/poo/mop validate)
        "../library/concurrency/resource-control/backpressure-memory/rust/objects.ss"
        "../library/concurrency/resource-control/backpressure-memory/rust/types.ss"
        (only-in "../library/concurrency/resource-control/backpressure-memory/abstract/objects.ss" BackpressureModel)
        (only-in "../modules/resource-evidence/func.ss" open-resource-review)
        "../profiles/resource-lifecycle.ss")
(export library-declarative-model-test)

(def library-declarative-model-test
 (test-suite "Declarative Library values and effective receivers"
  (test-case "published method metadata has an independent literal operation oracle"
   (for-each (lambda (row)
    (def method (.ref RustMethodDefinitions (car row)))
    (validate (.get ResourceMethodDefinitionContract value-contract) method)
    (check-equal? (list (.get method operation) (.get method kind) (.get method strength) (.get method modes)) row))
    '((native implementation-execution execution (normal))
      (quint model-verification finite-model (normal early-release))
      (lean theorem-check arithmetic (normal))
      (integration model-projection correspondence (normal)))))
  (test-case "refined inputs update inherited premises after the base cache was read"
   (def original (.get RustMethodDefinitions native))
   (def held-inputs (.get original input-demands))
   (def held-premises (.get original premises))
   (def refined (.o (:: @ original) input-demands: => (cut append <> '(review-context))))
   (validate (.get ResourceMethodDefinitionContract value-contract) refined)
   (check-equal? (.get (car (.get refined premises)) inputs) (.get refined input-demands))
   (check-equal? (.get (car (.get refined limits)) inputs) (.get refined input-demands))
   (check-equal? (.get original input-demands) held-inputs)
   (check-equal? (.get (car held-premises) inputs) held-inputs)
   (check-equal? (member 'review-context held-inputs) #f))
  (test-case "declared operation selects coherent inherited requirements"
   (def native (.get RustMethodDefinitions native))
   (def quint (.get RustMethodDefinitions quint))
   (def held (.get native signature))
   (def selected (.o (:: @ native) operation: 'quint
     model-ids: (.get quint model-ids) claims: (.get quint claims) assets: (.get quint assets)))
   (validate (.get ResourceMethodDefinitionContract value-contract) selected)
   (check-equal? (.get selected identity) 'rust.resources.quint)
   (check-equal? (eq? (.get selected signature) ResourceQuintSignature) #t)
   (check-equal? (.get selected modes) '(normal early-release))
   (check-equal? (.get (car (.get selected premises)) inputs) (.get selected input-demands))
   (check-equal? (eq? (.get native signature) held) #t)
   (check-exception (validate (.get ResourceMethodDefinitionContract value-contract)
     (.cc selected 'signature ResourceNativeSignature)) (lambda (_) #t)))
  (test-case "parent policy follows effective capabilities into actual ASCENT obligations"
   (def base-rules (.get BackpressureModel rules))
   (def base-dependencies (.get BackpressureModel dependencies))
   (def parent (.o (:: @ BackpressureModel)
     capabilities: (.get BackpressureModel capabilities)
     rules: (append base-rules
       (if (memq 'strict-retention capabilities) '((bounded-retention BP-O-STRICT review)) '()))
     dependencies: (append base-dependencies
       (if (memq 'strict-retention capabilities) '((BP-O-STRICT inventory)) '()))))
   (def held (.get parent rules))
   (def ordinary (specialize-backpressure parent))
   (def strict (.o (:: @ ordinary) capabilities: => (cut cons 'strict-retention <>)))
   (def frozen (.o (:: @ ordinary) rules: (.get ordinary rules)
     capabilities: => (cut cons 'strict-retention <>)))
   (validate (.get RustResourceModelContract value-contract) strict)
   (check-equal? (and (member '(bounded-retention BP-O-STRICT review) (.get strict rules)) #t) #t)
   (check-equal? (and (member '(BP-O-STRICT inventory) (.get strict dependencies)) #t) #t)
   (check-equal? (.get parent rules) held)
   (check-equal? (member '(bounded-retention BP-O-STRICT review) (.get frozen rules)) #f)
   (def result (gerbil-ascent-session-run
     (open-resource-review strict LifecycleProfile 'strict-use "declared/strict" '())))
   (check-equal? (.get result finished) #t)
   (check-equal? (and (member '(strict-use BP-O-STRICT review) ((.get result rows-of) 'obligation)) #t) #t)
   (check-equal? (and (member '(strict-use BP-O-STRICT review) ((.get result rows-of) 'pending)) #t) #t)
   (check-equal? ((.get result rows-of) 'support) '())
   (def integrated (.o (:: @ (make-backpressure-integration ordinary))
     capabilities: => (cut cons 'strict-retention <>)))
   (validate (.get BackpressureIntegrationContract value-contract) integrated)
   (check-equal? (and (member '(bounded-retention BP-O-STRICT review) (.get integrated rules)) #t) #t))
  (test-case "case and mapping refinement recompute links, rules and dependencies"
   (def model (make-backpressure-integration (specialize-backpressure BackpressureModel)))
   (def original-cases (.get model mapping cases))
   (def first-case (car original-cases))
   (def held-obligations (.get first-case obligations))
   (def held-links (.get model case-links))
   (def renamed (.o (:: @ first-case) name: "M01-variant"))
   (def selected-cases (cons renamed (cdr original-cases)))
   (def mapped (.o (:: @ model) mapping: =>.+ (.o cases: selected-cases)))
   (validate (.get BackpressureIntegrationContract value-contract) mapped)
   (check-equal? (.get renamed obligations) '(RL-M01-variant SI-M01-variant TM-M01-variant))
   (check-equal? (.get first-case obligations) held-obligations)
   (check-equal? (.get model case-links) held-links)
   (check-equal? (car (.get mapped case-links)) (.get renamed obligations))
   (check-equal? (and (member '(normal-handoff SI-M01-variant sysml) (.get mapped rules)) #t) #t)
   (check-equal? (and (member '(TM-M01-variant quint-tool) (.get mapped dependencies)) #t) #t)
   (check-equal? (member '(normal-handoff SI-M01 sysml) (.get mapped rules)) #f))))
