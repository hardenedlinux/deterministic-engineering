;;; -*- Gerbil -*-
(import (only-in :gerbil/runtime/loader list-modules) :std/test :std/encoding/json :std/list/list :clan/poo/object (only-in :std/os/pid getpid) (only-in :std/os/signal kill SIGKILL)
        (only-in :std/crypto/digest sha256) (only-in :std/encoding/hex hex-encode)
        :yuanxu/contribution/verification
        :agentic-ai-lab/lambda-aitia/modules/sdlc/review-authority
        :deterministic-engineering/scenarios/resource-lifecycle/review/interface
        :deterministic-engineering/scenarios/resource-lifecycle/review/archive)
(export backpressure-owner-recovery-test)
(def (load path) (call-with-input-file path (cut read-json <> object-as-hash: #t)))
(def (save path value) (call-with-output-file path (cut write-json <> value)))
(def backpressure-owner-recovery-test
  (test-suite "Actual process restart and native Aitia archive recovery"
    (test-case "closed checkpoints preserve failures across actual process exits"
      (when (getenv "BACKPRESSURE_NATIVE_TEST_LIB" #f)
        (let* ((id "deterministic-engineering/t/backpressure-owner-recovery-test~0")
               (loaded (assoc id (list-modules)))
               (prefix (string-append (getenv "BACKPRESSURE_NATIVE_TEST_LIB") "/" id ".o")))
          (displayln "NATIVE-TEST " id " " (and loaded (cdr loaded))) (force-output)
          (check-equal? (and loaded (string? (cdr loaded))
            (>= (string-length (cdr loaded)) (string-length prefix))
            (equal? prefix (substring (cdr loaded) 0 (string-length prefix)))) #t)
          (def captured (assoc (cdr loaded) (hash-ref (load (getenv "BACKPRESSURE_REVIEW_SOURCES")) "files")))
          (check-equal? (and captured (equal? (review-file-digest (car captured)) (cadr captured))) #t)))
      (def root (getenv "BACKPRESSURE_RECOVERY_ROOT"))
      (def phase (getenv "BACKPRESSURE_RECOVERY_PHASE"))
      (def out (path-expand phase root))
      (create-directory out)
      (displayln "OUTPUT " out) (displayln "PHASE-ID " phase) (displayln "PROCESS " (getpid)) (force-output)
      (def reader (recovery-reader-identity))
      (def rows (load (getenv "BACKPRESSURE_REASSESSMENT_RUNS")))
      (for-each (lambda (row) (check-equal? (review-file-digest (cadr row)) (caddr row))) rows)
      (def (run label) (cadr (assoc label rows)))
      (def (history) (open-backpressure-history (getenv "BACKPRESSURE_ACCEPTANCE") (getenv "BACKPRESSURE_REVIEW_SOURCES")))
      (def started (##current-time-point))
      (def (timed label thunk)
        (def begin (##current-time-point))
        (displayln "BEGIN " label " elapsed=" (- begin started)) (force-output)
        (def result (thunk))
        (displayln "COST " label " " (- (##current-time-point) begin)) (force-output) result)
      (def group-owners (timed "history-group" (lambda () (open-cross-intake-group '("intake-a" "intake-b")
        (getenv "BACKPRESSURE_ACCEPTANCE") (getenv "BACKPRESSURE_REVIEW_SOURCES")))))
      (def a (car (.ref group-owners 'histories))) (def b (cadr (.ref group-owners 'histories)))
      ;; Force a different native prefix after every real process restart.
      ((.ref a 'observe!) (review-file-digest (getenv "BACKPRESSURE_REVIEW_SOURCES")))
      ((.ref a 'observe!) (hex-encode (sha256 (string->utf8 reader))))
      (def repairs
        (let (registered ((.ref a 'add-runs!) (map run '("A-original64" "C-repair64" "C-repair128"))))
          (append (cadr registered) (caddr registered))))
      (def source (hash-ref (load (run "C-repair64")) "source"))
      (def profile (.o (:: @ BackpressureReviewProfile) revision: "cross-intake/r1" scope: "bounded-permit-method/M04-M06"))
      (def (with-repairs selected)
        (def expected (map cadr (hash-ref (cadr ((.ref selected 'capture))) "counterevidence")))
        (def dispositions (filter-map (lambda (id)
          (def failure ((.ref selected 'entry) id))
          (def repair (find (lambda (r) (and (equal? (hash-ref r "case") (hash-ref failure "case"))
            (= (hash-ref r "payloadBytes") (hash-ref failure "payloadBytes")))) repairs))
          (and (not (hash-ref failure "diagnostic")) repair
            (let ((selected-id id) (selected-repair (hash-ref repair "id"))) (.o failure: selected-id repair: selected-repair)))) expected))
        (make-backpressure-reassessment selected profile source dispositions: dispositions))
      (def (credentials review)
        (append (list (reassessment-verify-context review 10 200) (reassessment-verify-content review 10 200))
          (map (lambda (row) (reassessment-verify-disposition review (car row) 10 200)) (.ref review 'disposition-requests))))
      (displayln "PHASE original records and repaired runs registered") (force-output)
      ;; The owner-recovery producer owns the A-only/omitted-history controls.
      ;; Durable intake and repair roles reconstruct and admit the complete real
      ;; union, but do not repeat those independent preflight controls. The
      ;; assertions below still execute in phase "producer"; no receipt or
      ;; constructed history is transferred between native processes.
      (def terminal-only? (member phase '("intake-producer" "intake-recover" "intake-partial"
        "intake-pending" "repair-checks" "repair-replay" "restart-one" "restart-two" "restart-three")))
      (def local #f) (def local-receipts '())
      (unless terminal-only?
        (set! local (timed "local-build" (lambda () (with-repairs a)))) (set! local-receipts (timed "local-credentials" (lambda () (credentials local))))
        (check-equal? (.ref (timed "local-stage" (lambda () (reassessment-stage local local-receipts 11))) 'status) 'stage-admitted))
      ;; B discovers two actual failures absent from A; their original IDs survive the union.
      ((.ref b 'add-run!) (run "B-regression64"))
      (def federation (.ref group-owners 'federation))
      (def merged ((.ref federation 'capture)))
      (check-equal? (length (hash-ref (car merged) "clues")) 46)
      (check-equal? (length (hash-ref (cadr merged) "counterevidence")) 7)
      (save (path-expand "history-capture.json" out) merged)
      (save (path-expand "intake-captures.json" out) ((.ref federation 'discover)))
      (def omitted #f)
      (when local
        (set! omitted (make-backpressure-reassessment federation profile source failures: (.ref local 'failure-ids)))
        (check-equal? (reassessment-verify-content omitted 10 100) #f))
      (displayln "PHASE complete native union queried") (force-output)
      (save (path-expand "registration-work.json" out)
        (map (lambda (binding)
          (def stats ((.ref (cdr binding) 'registration-stats)))
          (list (car binding) (.ref stats 'batches) (.ref stats 'logical-dependency-references)
            (.ref stats 'checked-dependency-paths)))
          (list (cons "intake-a" a) (cons "intake-b" b) (cons "aggregate" federation))))
      (def mechanical (timed "mechanical-build" (lambda () (with-repairs federation))))
      (unless terminal-only? (check-equal? (.ref (timed "old-receipt-stage" (lambda () (reassessment-stage mechanical local-receipts 11))) 'admitted?) #f))
      (check-equal? (hash-ref (cadr ((.ref federation 'capture))) "viewIdentity") (hash-ref (cadr merged) "viewIdentity"))
      (def mechanical-receipts (timed "mechanical-credentials" (lambda () (credentials mechanical))))
      (def diagnostic (timed "mechanical-stage" (lambda () (reassessment-stage mechanical mechanical-receipts 11))))
      (save (path-expand "mechanical-diagnostic.json" out) (hash
        ("receipts" (map (lambda (r) (and r #t)) mechanical-receipts))
        ("current" (.ref diagnostic 'current?)) ("complete" (.ref diagnostic 'history-complete?))
        ("unresolved" (.ref diagnostic 'unresolved))
        ("covers" (map cadr (.ref mechanical 'disposition-requests)))))
      (check-equal? (.ref diagnostic 'status) 'stage-admitted)
      (check-equal? (length (.ref mechanical 'failure-ids)) 7)
      (call-with-output-file (path-expand "mechanical-packet.json" out) (cut display (.ref mechanical 'packet) <>))
      (def (p name) (path-expand name out))
      (def (g name) (path-expand name root))
      ;; Setup-only counterexamples retain no authority after their assertions.
      ;; Keep the live histories, current requests, and current receipts intact.
      (set! repairs '()) (set! local #f) (set! local-receipts '())
      (set! omitted #f) (set! diagnostic #f) (set! merged #f)
      (def tools (review-signature-tools (getenv "BACKPRESSURE_OPENSSL") out))
      (def selection #f)
      (def (host-head)
        (let ((selected-path (hash-ref selection "headPath")) (selected-digest (hash-ref selection "headDigest"))
              (selected-signature (hash-ref selection "signature")))
          (.o path: selected-path digest: selected-digest signature: selected-signature)))
      (def sequence 0)
      (def (publish! state descriptor reader-value (invalid-test-input? #f))
        (when (and (equal? state "active") (not invalid-test-input?))
          (check-equal? (review-recovery-activation? (host-head) (g "root.pub") tools descriptor) #t))
        (set! sequence (+ sequence 1))
        (def name (string-append "head-" phase "-" (number->string sequence)))
        (def repair-refs (if (and selection (equal? state "active"))
          (hash-ref (load (hash-ref selection "headPath")) "repairReferences" '()) '()))
        (save (g (string-append name ".json")) (hash ("repairReferences" repair-refs) ("schema" "aitia.recovery-head/v1")
          ("state" state) ("owner" (list-ref descriptor 2)) ("cut" (list-ref descriptor 3))
          ("archive" (car descriptor)) ("archiveSha256" (cadr descriptor)) ("reader" reader-value)))
        ((.ref tools 'sign) (g "root.key") (g (string-append name ".json")) (g (string-append name ".sig")))
        (set! selection (hash ("owner" (list-ref descriptor 2)) ("cut" (list-ref descriptor 3))
          ("archive" (car descriptor)) ("archiveSha256" (cadr descriptor))
          ("headPath" (g (string-append name ".json")))
          ("headDigest" (review-file-digest (g (string-append name ".json")))) ("signature" (g (string-append name ".sig")))))
        (save (g "host-selection.json") selection))
      (def (descriptor) (list (hash-ref selection "archive") (hash-ref selection "archiveSha256")
        (hash-ref selection "owner") (hash-ref selection "cut")))
      (def (open-owner previous persistence: (persistence #f) incarnation: (owner-reader reader))
        (open-cross-intake-approval federation mechanical tools (g "directory.json") (g "directory.sig")
          (g "root.pub") (g "alice.pub") (g "bob.pub") predecessor: previous incarnation: owner-reader persistence: persistence))
      (def (verified selected)
        (filter identity (cons (yuanxu-verify (.ref selected 'adapter) (.ref selected 'discovery-request) 10 100)
          (map (lambda (row) (yuanxu-verify (.ref selected 'adapter) (cadr row) 10 100)) (.ref selected 'approval-requests)))))
      (def (decision owner name outcome supersedes)
        (save (p (string-append name ".json")) (hash ("signer" "test-reviewer-a") ("policy" "approval/v1")
          ("decision" outcome) ("reason" name) ("supersedes" supersedes) ("target" ((.ref owner 'target) "approval/v1"))))
        ((.ref tools 'sign) (g "alice.key") (p (string-append name ".json")) (p (string-append name ".sig")))
        ((.ref owner 'submit!) (p (string-append name ".json")) (p (string-append name ".sig"))))
      (def (grant source owner)
        (def capture (or ((.ref source 'handover-capture)) (error "missing complete archive capture")))
        (save (p "handover.json") (hash ("schema" "aitia.owner-handover/v1") ("from" (.ref source 'owner))
          ("to" (.ref owner 'owner)) ("technicalDigest" (.ref owner 'technical-digest))
          ("cut" (.ref capture 'cut)) ("records" (map car (.ref capture 'records)))))
        ((.ref tools 'sign) (g "root.key") (p "handover.json") (p "handover.sig"))
        (check-equal? ((.ref owner 'accept-handover!) (p "handover.json") (p "handover.sig")) 'handover-accepted))
      (def (save-receipts receipts)
        (save (p "receipt-presentation.json") (map (lambda (r)
          (list (.ref r 'identity) (.ref r 'issuer) (.ref r 'issued-at) (.ref r 'expires-at))) receipts)))
      (def (restore-presentations path)
        (map (lambda (row)
          (let ((selected-id (car row)) (selected-issuer (cadr row)) (selected-start (caddr row)) (selected-end (cadddr row)))
            (.o identity: selected-id issuer: selected-issuer issued-at: selected-start expires-at: selected-end))) (load path)))
      (def steps '())
      (def source-provider #f)
      (def (step label owner frame receipts expected)
        (when (member (substring label 0 4) '("DR04" "DR10"))
          (for-each (lambda (receipt)
            (for-each (lambda (request)
              (check-equal? (yuanxu-verification-valid? (.ref frame 'adapter) receipt request 11) #f))
              (cons (.ref frame 'discovery-request) (map cadr (.ref frame 'approval-requests))))) receipts))
        (def result ((.ref frame 'gate) mechanical-receipts receipts 11))
        (check-equal? (.ref result 'status) expected)
        (check-equal? (.ref result 'current-use-checked?) #t)
        (check-equal? (.ref result 'release-authorized?) #f)
        (def input (p (string-append label "-input.json")))
        (call-with-output-file input (cut display (.ref frame 'packet) <>))
        (def proof (p (string-append label "-proof.json")))
        (save proof (hash ("selection" selection)
          ("headWire" (and selection (call-with-input-file (hash-ref selection "headPath") read-line)))
          ("headObservedSha256" (and selection (review-file-digest (hash-ref selection "headPath"))))
          ("archiveObservedSha256" (and selection (file-exists? (hash-ref selection "archive"))
            (review-file-digest (hash-ref selection "archive"))))
          ("methodRunNow" (with-catch (lambda (_) #f) (lambda () (review-file-digest (run "B-regression64")))))
          ("recordFilesNow" (map (lambda (pair) (list (car pair)
            (with-catch (lambda (_) #f) (lambda () (review-file-digest (car pair))))))
            (append-map caddr ((.ref owner 'accepted-decisions)))))
          ("handoverFilesNow" (map (lambda (pair) (list (car pair)
            (with-catch (lambda (_) #f) (lambda () (review-file-digest (car pair))))))
            (hash-ref (call-with-input-string (.ref frame 'packet) (cut read-json <> object-as-hash: #t)) "handoverReferences")))
          ("archiveWire" (and selection (file-exists? (hash-ref selection "archive"))
            (call-with-input-file (hash-ref selection "archive") read-line)))
          ("providerStatus" (and source-provider (symbol->string ((.ref source-provider 'status)))))
          ("acceptedNow" ((.ref owner 'accepted-decisions)))
          ("nativeRequests" (map sdlc-review-authority-snapshot
            (cons (.ref frame 'discovery-request) (map cadr (.ref frame 'approval-requests)))))
          ("pid" (getpid)) ("reader" reader) ("receiptMetadataIsAuthority" #f)))
        (set! steps (append steps (list (hash ("step" label) ("status" (symbol->string (.ref result 'status)))
          ("goldStatus" (symbol->string expected)) ("pid" (getpid))
          ("failures" (.ref (.ref result 'technical) 'failure-ids))
          ("input" (list input (review-file-digest input))) ("proof" (list proof (review-file-digest proof)))))))
        (displayln "GOLD " label " " expected) (force-output))
      (def (producer)
        (for-each (lambda (name) ((.ref tools 'generate) (g (string-append name ".key")) (g (string-append name ".pub")))) '("root" "alice" "bob"))
        (save (g "directory.json") (hash ("sources" '("intake-a" "intake-b")) ("requiredSigner" "test-reviewer-a")
          ("policies" '("approval/v1" "approval/v2")) ("qualificationOnly" #t)))
        ((.ref tools 'sign) (g "root.key") (g "directory.json") (g "directory.sig"))
        (def origin (open-cross-intake-approval federation mechanical tools (g "directory.json") (g "directory.sig")
          (g "root.pub") (g "alice.pub") (g "bob.pub") incarnation: (string-append reader "/origin")))
        (def rejection (decision origin "A-rejection" "rejected" '()))
        (check-equal? (string? rejection) #t)
        (check-equal? (string? (decision origin "A-resolution" "approved" (list rejection))) #t)
        (def owner (open-owner origin))
        (grant origin owner)
        (def frame ((.ref owner 'frame) "approval/v1")) (def receipts (verified frame))
        (step "DR01-original-admission" owner frame receipts 'review-admitted)
        (save-receipts receipts)
        (def sealed ((.ref owner 'seal-history!) (p "archive.json") retire-predecessor?: #t))
        (check-equal? ((.ref origin 'handover-capture)) #f)
        (check-equal? (decision origin "A-after-seal" "rejected" '()) #f)
        (check-equal? ((.ref owner 'handover-capture)) #f)
        (publish! "sealed" sealed #f)
        (save (g "first-selection.json") selection)
        (step "DR02-sealed-owner-terminal" owner frame receipts 'history-discovery-required))
      (def (recover)
        (check-equal? (review-file-digest (g "host-selection.json")) (getenv "BACKPRESSURE_RECOVERY_SELECTION_SHA"))
        (set! selection (load (g "host-selection.json")))
        (def selected-archive (load (hash-ref selection "archive")))
        (check-equal? (= (getpid) (hash-ref selected-archive "producerPid")) #f)
        (def selected-reader reader)
        (def selected-owner (hash-ref selection "owner")) (def selected-cut (hash-ref selection "cut"))
        (def selected-path (hash-ref selection "archive")) (def selected-root (g "root.pub"))
        (def mandate (.o owner: selected-owner cut: selected-cut archive: selected-path root-public: selected-root
          reader: selected-reader head: host-head))
        (set! source-provider (open-archived-review-source mandate tools))
        (def owner (open-owner source-provider))
        (def before ((.ref owner 'frame) "approval/v1"))
        (cond
          ((equal? phase "restart-one")
            (let ()
            (check-equal? (decision owner "B-before-activation" "rejected" '()) #f)
            (check-equal? ((.ref owner 'accepted-decisions)) '())
            (step "DR03-before-activation" owner before (verified before) 'history-discovery-required)
            (publish! "active" (descriptor) reader)
            (grant source-provider owner)
            (check-exception (open-owner source-provider) (lambda (_) #t))
            (check-exception (open-archived-review-source mandate tools) (lambda (_) #t))
            (def restored ((.ref owner 'frame) "approval/v1"))
            (step "DR04-old-receipts-are-data" owner restored (restore-presentations (g "producer/receipt-presentation.json")) 'history-discovery-required)
            (def receipts (verified restored))
            (step "DR05-reverified-archive-reuse" owner restored receipts 'review-admitted)
            (save-receipts receipts)
            (check-equal? (string? (decision owner "B-new-counter" "rejected" '())) #t)
            (def denied ((.ref owner 'frame) "approval/v1"))
            (step "DR06-new-counter-before-seal" owner denied (verified denied) 'approval-rejected)
            (def sealed ((.ref owner 'seal-history!) (p "archive.json")))
            (publish! "sealed" sealed #f)
            (save (g "second-selection.json") selection)))
          ((equal? phase "restart-two")
            (let ()
            (step "DR07-next-owner-before-activation" owner before (verified before) 'history-discovery-required)
            (publish! "active" (descriptor) reader)
            (def active-selection selection)
            (def source-path (hash-ref selection "archive"))
            (def original-wire (call-with-input-file source-path read-line))
            (dynamic-wind (lambda () (rename-file source-path (p "archive.unavailable")))
              (lambda () (step "DR08-archive-unavailable" owner before (verified before) 'history-discovery-required))
              (lambda () (rename-file (p "archive.unavailable") source-path)))
            (def incomplete (load source-path))
            (hash-put! incomplete "records" (take (hash-ref incomplete "records") 2))
            (dynamic-wind (lambda ()
                (save source-path incomplete)
                (publish! "active" (list source-path (review-file-digest source-path) selected-owner selected-cut) reader #t))
              (lambda ()
                (step "DR09-signed-incomplete-inventory" owner before (verified before) 'history-discovery-required)
                (check-equal? ((.ref source-provider 'status)) 'archive-refused))
              (lambda () (call-with-output-file source-path (cut display original-wire <>)) (set! selection active-selection)))
            (grant source-provider owner)
            (def restored ((.ref owner 'frame) "approval/v1"))
            (step "DR10-second-receipts-cannot-rehydrate" owner restored (restore-presentations (g "restart-one/receipt-presentation.json")) 'history-discovery-required)
            (step "DR11-inherited-counter-remains" owner restored (verified restored) 'approval-rejected)
            (def counter (find (lambda (row) (equal? (hash-ref (cadr row) "reason") "B-new-counter")) ((.ref owner 'accepted-decisions))))
            (check-equal? (string? (decision owner "C-resolution" "approved" (list (car counter)))) #t)
            (def resolved ((.ref owner 'frame) "approval/v1")) (def receipts (verified resolved))
            (step "DR12-explicit-current-resolution" owner resolved receipts 'review-admitted)
            (step "DR13-current-owner-reuses-evidence" owner resolved receipts 'review-admitted)
            (def old-record (caar (caddr (car ((.ref owner 'accepted-decisions))))))
            (dynamic-wind (lambda () (rename-file old-record (p "old-record.unavailable")))
              (lambda () (step "DR14-required-record-unavailable" owner resolved receipts 'history-discovery-required))
              (lambda () (rename-file (p "old-record.unavailable") old-record)))
            (step "DR15-exact-record-restoration" owner resolved receipts 'review-admitted)
            (def run-path (run "B-regression64"))
            (dynamic-wind (lambda () (rename-file run-path (p "run.unavailable")))
              (lambda () (step "DR16-method-source-unavailable" owner resolved receipts 'requirements-blocked))
              (lambda () (rename-file (p "run.unavailable") run-path)))
            (step "DR17-method-source-restored" owner resolved receipts 'review-admitted)
            (save-receipts receipts)
            (check-equal? (string? (decision owner "C-unsealed-counter" "rejected" '())) #t)
            (def denied ((.ref owner 'frame) "approval/v1"))
            (step "DR18-unsealed-counter-blocks" owner denied (verified denied) 'approval-rejected)
            ;; Exit without seal. The durable head remains active for this incarnation.
            (save (g "host-selection.json") selection)))
          ((equal? phase "restart-three")
            (let ()
            (def old-reader (hash-ref (load (hash-ref selection "headPath")) "reader"))
            (check-equal? (equal? old-reader reader) #f)
            (check-exception (open-archived-review-source (.o (:: @ mandate) reader: old-reader) tools) (lambda (_) #t))
            (check-equal? (review-recovery-activation? (host-head) (g "root.pub") tools (descriptor)) #f)
            (step "DR19-unsealed-old-process-unavailable" owner before (restore-presentations (g "restart-two/receipt-presentation.json")) 'history-discovery-required)
            (def active selection)
            (def old (load (g "first-selection.json")))
            (def current-path (hash-ref selection "headPath"))
            (def original (call-with-input-file current-path read-line))
            (dynamic-wind (lambda () (call-with-output-file current-path
                (cut display (call-with-input-file (hash-ref old "headPath") read-line) <>)))
              (lambda ()
                (step "DR20-signed-old-head-rollback" owner before (verified before) 'history-discovery-required)
                (check-equal? ((.ref source-provider 'status)) 'archive-refused))
              (lambda () (call-with-output-file current-path (cut display original <>))))
            (step "DR21-active-head-is-not-a-seal" owner before (verified before) 'history-discovery-required)))
          (else (error "unknown recovery phase"))))
      ;; Same actual setup, native sources, signatures and Aitia gate as DR01-21.
      ;; Only the trusted host publication capability changes for this profile.
      (def (save-process!)
        (save (p "steps.json") steps)
        (save (p "process.json") (hash ("pid" (getpid)) ("phase" phase) ("reader" reader)
          ("technicalDigest" (.ref mechanical 'packet)) ("selection" selection))))
      (def (interrupt! boundary)
        (save-process!)
        (save (p "interrupt.json") (hash ("boundary" boundary) ("pid" (getpid)) ("selection" selection)))
        (displayln "EXPECTED-SIGKILL " boundary " " (getpid)) (force-output)
        (kill (getpid) SIGKILL)
        (error "SIGKILL returned"))
      (def crash-at #f)
      (def (durable-host)
        (def (commit! wire previous)
          (check-equal? (hash-ref selection "headDigest") previous)
          (def body (call-with-input-string wire (cut read-json <> object-as-hash: #t)))
          (def file (p (string-append "prefix-" (number->string (hash-ref body "acceptedCount")) ".json")))
          (def checkpoint (list file (hex-encode (sha256 (string->utf8 wire))) (hash-ref body "owner") (hash-ref body "cut")))
          ;; Intent becomes selected before writing. A crash cannot select an
          ;; earlier positive checkpoint as if the later intake did not exist.
          (def previous-reference (list (.ref (host-head) 'path) previous (.ref (host-head) 'signature)))
          (publish! "writing" checkpoint reader #t)
          (save (p "pending-input.json") (hash ("prior" previous-reference) ("wire" wire) ("previousHead" previous) ("intent" selection)))
          (call-with-output-file (string-append file ".pending") (lambda (port)
            (display (if (eq? crash-at 'partial) (substring wire 0 (quotient (string-length wire) 2)) wire) port)))
          (when (eq? crash-at 'partial) (interrupt! "partial-write-no-ack"))
          (rename-file (string-append file ".pending") file)
          (set! sequence (+ sequence 1))
          (def head-name (string-append "checkpoint-" phase "-" (number->string sequence)))
          (save (g (string-append head-name ".json")) (hash ("schema" "aitia.recovery-head/v1")
            ("state" "checkpoint") ("reader" #f) ("owner" (hash-ref body "owner")) ("cut" (hash-ref body "cut"))
            ("archive" file) ("archiveSha256" (list-ref checkpoint 1)) ("previousHead" previous)
            ("acceptedCount" (hash-ref body "acceptedCount"))))
          ((.ref tools 'sign) (g "root.key") (g (string-append head-name ".json")) (g (string-append head-name ".sig")))
          (set! selection (hash ("owner" (hash-ref body "owner")) ("cut" (hash-ref body "cut"))
            ("archive" file) ("archiveSha256" (list-ref checkpoint 1))
            ("headPath" (g (string-append head-name ".json")))
            ("headDigest" (review-file-digest (g (string-append head-name ".json"))))
            ("signature" (g (string-append head-name ".sig")))))
          (save (g "host-selection.json") selection)
          (when (eq? crash-at 'published) (interrupt! "published-before-ack"))
          (host-head))
        (let (selected-commit commit!) (.o selected: host-head commit!: selected-commit)))
      (def (acknowledged owner name outcome supersedes)
        (def id (timed name (lambda () (decision owner name outcome supersedes))))
        (check-equal? (string? id) #t)
        ;; This witness is written only after the public call returned its ID.
        (save (p (string-append name "-ack.json")) (hash ("id" id) ("selection" selection) ("pid" (getpid))))
        id)
      (def (intake-recover-owner)
        (check-equal? (review-file-digest (g "host-selection.json")) (getenv "BACKPRESSURE_RECOVERY_SELECTION_SHA"))
        (set! selection (load (g "host-selection.json")))
        (def archive (load (hash-ref selection "archive")))
        (check-equal? (= (getpid) (hash-ref archive "producerPid")) #f)
        (def selected-reader (string-copy reader))
        (def mandate (.o owner: (hash-ref selection "owner") cut: (hash-ref selection "cut")
          archive: (hash-ref selection "archive") root-public: (g "root.pub") reader: selected-reader head: host-head))
        (set! source-provider (open-archived-review-source mandate tools))
        ;; Activation happens before owner construction so its initial selected
        ;; custody is the actual active reference, not the older checkpoint.
        (publish! "active" (descriptor) reader)
        (def owner (open-owner source-provider persistence: (durable-host)))
        (grant source-provider owner)
        owner)
      (def (intake-producer)
        (for-each (lambda (name) ((.ref tools 'generate) (g (string-append name ".key")) (g (string-append name ".pub")))) '("root" "alice" "bob"))
        (save (g "directory.json") (hash ("sources" '("intake-a" "intake-b")) ("requiredSigner" "test-reviewer-a")
          ("policies" '("approval/v1" "approval/v2")) ("qualificationOnly" #t)))
        ((.ref tools 'sign) (g "root.key") (g "directory.json") (g "directory.sig"))
        (publish! "writing" (list (p "uninitialized") "none" reader "none") reader #t)
        (def live (timed "live-owner" (lambda () (open-owner #f))))
        (check-exception (open-owner live persistence: (durable-host)) (lambda (_) #t))
        ((.ref live 'close!))
        (save (p "live-predecessor-refusal.json") (hash ("refused" #t) ("owner" (.ref live 'owner))))
        (set! live #f)
        (def owner (timed "durable-owner" (lambda () (open-owner #f persistence: (durable-host)))))
        (def original (acknowledged owner "P-old-blocker" "rejected" '()))
        (acknowledged owner "P-resolution" "approved" (list original))
        (def positive ((.ref owner 'frame) "approval/v1"))
        (save-receipts (verified positive))
        (def counter (acknowledged owner "P-new-counter" "rejected" '()))
        (def denied ((.ref owner 'frame) "approval/v1"))
        (step "DP01-confirmed-prefix-counter" owner denied (verified denied) 'approval-rejected)
        (def previous (hash-ref selection "headDigest"))
        (check-equal? ((.ref owner 'submit!) (p "P-new-counter.json") (p "P-new-counter.sig")) counter)
        (check-equal? (hash-ref selection "headDigest") previous)
        (check-equal? (length ((.ref owner 'accepted-decisions))) 3)
        (step "DP02-identical-retry-no-duplicate" owner denied (verified denied) 'approval-rejected)
        (interrupt! "confirmed-counter-before-owner-seal"))
      (def (intake-recover)
        (def owner (intake-recover-owner))
        (def denied ((.ref owner 'frame) "approval/v1"))
        (def old (restore-presentations (g "intake-producer/receipt-presentation.json")))
        (for-each (lambda (receipt) (for-each (lambda (request)
          (check-equal? (yuanxu-verification-valid? (.ref denied 'adapter) receipt request 11) #f))
          (cons (.ref denied 'discovery-request) (map cadr (.ref denied 'approval-requests))))) old)
        (step "DP03-old-receipts-have-no-authority" owner denied old 'history-discovery-required)
        (step "DP04-confirmed-counter-survives-SIGKILL" owner denied (verified denied) 'approval-rejected)
        (def counter (hash-ref (load (g "intake-producer/P-new-counter-ack.json")) "id"))
        (acknowledged owner "R-resolution" "approved" (list counter))
        (def positive ((.ref owner 'frame) "approval/v1")) (def receipts (verified positive))
        (step "DP05-current-disposition-persisted" owner positive receipts 'review-admitted)
        (step "DP06-current-evidence-reuse" owner positive receipts 'review-admitted)
        (def archive-path (hash-ref selection "archive"))
        (dynamic-wind (lambda () (rename-file archive-path (string-append archive-path ".missing")))
          (lambda () (step "DP12-current-prefix-unavailable" owner positive receipts 'history-discovery-required))
          (lambda () (rename-file (string-append archive-path ".missing") archive-path)))
        (step "DP13-identical-prefix-restored" owner positive receipts 'review-admitted)
        (save-receipts receipts)
        (set! crash-at 'published)
        (acknowledged owner "R-published-counter" "rejected" '())
        (error "publication interruption must prevent acknowledgment"))
      (def (intake-partial)
        (def owner (intake-recover-owner))
        (check-equal? (file-exists? (g "intake-recover/R-published-counter-ack.json")) #f)
        (def denied ((.ref owner 'frame) "approval/v1"))
        (step "DP07-published-unacknowledged-counter-retained" owner denied (verified denied) 'approval-rejected)
        (check-equal? (length ((.ref owner 'accepted-decisions))) 5)
        ;; Replaying an old signed proposal cannot retarget it to this revision.
        (check-equal? ((.ref owner 'submit!) (g "intake-recover/R-published-counter.json") (g "intake-recover/R-published-counter.sig")) #f)
        (step "DP08-old-target-replay-refused" owner denied (verified denied) 'approval-rejected)
        (set! crash-at 'partial)
        (acknowledged owner "I-partial-counter" "rejected" '())
        (error "partial write must prevent acknowledgment"))
      (def (intake-pending)
        (check-equal? (review-file-digest (g "host-selection.json")) (getenv "BACKPRESSURE_RECOVERY_SELECTION_SHA"))
        (set! selection (load (g "host-selection.json")))
        (check-equal? (file-exists? (g "intake-partial/I-partial-counter-ack.json")) #f)
        (check-equal? (hash-ref (load (hash-ref selection "headPath")) "state") "writing")
        (def partial (string-append (hash-ref selection "archive") ".pending"))
        (check-equal? (file-exists? partial) #t)
        (check-exception (load partial) (lambda (_) #t))
        (check-equal? (review-recovery-activation? (host-head) (g "root.pub") tools (descriptor)) #f)
        (def selected-reader (string-copy reader))
        (def mandate (.o owner: (hash-ref selection "owner") cut: (hash-ref selection "cut")
          archive: (hash-ref selection "archive") root-public: (g "root.pub") reader: selected-reader head: host-head))
        (set! source-provider (open-archived-review-source mandate tools))
        (def owner (open-owner source-provider))
        (def before ((.ref owner 'frame) "approval/v1"))
        (step "DP09-incomplete-write-pending" owner before (verified before) 'history-discovery-required)
        (def current selection)
        (def old-selection (hash-ref (load (g "intake-producer/P-resolution-ack.json")) "selection"))
        (def old-path (hash-ref old-selection "headPath"))
        (def old-wire (call-with-input-file old-path read-line))
        (def current-path (hash-ref selection "headPath"))
        (def current-wire (call-with-input-file current-path read-line))
        (dynamic-wind (lambda () (call-with-output-file current-path (cut display old-wire <>)))
          (lambda () (step "DP10-old-positive-head-cannot-hide-intent" owner before (verified before) 'history-discovery-required)
            (check-equal? ((.ref source-provider 'status)) 'archive-refused))
          (lambda () (call-with-output-file current-path (cut display current-wire <>))))
        ;; The last committed full prefix remains intact and still contains the
        ;; unresolved counter. Pending writing is not authority to drop it.
        (def committed (hash-ref (load (g "intake-recover/pending-input.json")) "intent"))
        (def old-archive (load (hash-ref committed "archive")))
        (check-equal? (length (hash-ref old-archive "records")) 5)
        (step "DP11-restored-intent-still-pending" owner before (verified before) 'history-discovery-required))

      (def (repair-host)
        (def (publish-repair! wire path expected)
          ;; Serial host CAS; a signed document alone cannot select a head.
          (check-equal? (hash-ref selection "headDigest") expected)
          (call-with-output-file path (cut display wire <>))
          ((.ref tools 'sign) (g "root.key") path (string-append path ".sig"))
          (def head (load path))
          (set! selection (hash ("owner" (hash-ref head "owner")) ("cut" (hash-ref head "cut"))
            ("archive" (hash-ref head "archive")) ("archiveSha256" (hash-ref head "archiveSha256"))
            ("headPath" path) ("headDigest" (review-file-digest path)) ("signature" (string-append path ".sig"))))
          (save (g "host-selection.json") selection))
        (let (publisher publish-repair!) (.o selected: host-head publish-repair!: publisher)))
      (def repair-steps '())
      (def (repair-operation id auth sig expected)
        (def before (clone-selection))
        (def actual (review-repair-prefix! (repair-host) tools (g "root.pub") auth sig))
        (check-equal? actual expected)
        (set! repair-steps (append repair-steps (list (hash ("id" id) ("expected" (symbol->string expected))
          ("actual" (symbol->string actual)) ("authorization" auth) ("signature" sig)
          ("authorizationSha256" (and (file-exists? auth) (review-file-digest auth)))
          ("candidateObservedSha256" (let (path (hash-ref (load auth) "candidate"))
            (and (file-exists? path) (review-file-digest path))))
          ("before" before) ("after" (clone-selection)) ("pid" (getpid))))))
        (save (p "repair-steps.json") repair-steps))
      (def (clone-selection) (call-with-input-string (json->string selection) (cut read-json <> object-as-hash: #t)))
      (def (repair-checks)
        ;; Existing actual pending and signed rollback controls, not a fixture.
        (intake-pending)
        (def input (load (g "intake-partial/pending-input.json")))
        (def candidate (p "complete-candidate.json"))
        (def authorization (p "repair-authorization.json"))
        (def signature (p "repair-authorization.sig"))
        (def body (hash ("schema" "aitia.prefix-repair/v1") ("action" "complete-exact-prefix")
          ("writing" (list (.ref (host-head) 'path) (.ref (host-head) 'digest) (.ref (host-head) 'signature)))
          ("prior" (hash-ref input "prior")) ("candidate" candidate)
          ("outputArchive" (p "repaired-prefix.json")) ("outputHead" (p "repaired-head.json"))))
        (save authorization body)
        ((.ref tools 'sign) (g "root.key") authorization signature)
        (repair-operation "PR01-missing-complete-input" authorization signature 'repair-pending)
        (call-with-output-file candidate (cut display (hash-ref input "wire") <>))
        (check-equal? (review-file-digest candidate) (hash-ref selection "archiveSha256"))
        ((.ref tools 'sign) (g "bob.key") authorization (p "unauthorized.sig"))
        (repair-operation "PR02-untrusted-repair-signer" authorization (p "unauthorized.sig") 'repair-refused)
        (def original (hash-ref input "wire"))
        (dynamic-wind (lambda () (call-with-output-file candidate (cut display (substring original 0 (quotient (string-length original) 2)) <>)))
          (lambda () (repair-operation "PR03-truncated-candidate" authorization signature 'repair-refused))
          (lambda () (call-with-output-file candidate (cut display original <>))))
        (def writing (hash-ref body "writing"))
        (hash-put! body "writing" (hash-ref input "prior"))
        (save (p "wrong-writing.json") body)
        ((.ref tools 'sign) (g "root.key") (p "wrong-writing.json") (p "wrong-writing.sig"))
        (repair-operation "PR04-old-active-is-not-writing" (p "wrong-writing.json") (p "wrong-writing.sig") 'repair-refused)
        (hash-put! body "writing" writing)
        (def prior (hash-ref body "prior"))
        (def earlier (hash-ref (load (g "intake-producer/P-resolution-ack.json")) "selection"))
        (hash-put! body "prior" (list (hash-ref earlier "headPath") (hash-ref earlier "headDigest") (hash-ref earlier "signature")))
        (save (p "wrong-prior.json") body)
        ((.ref tools 'sign) (g "root.key") (p "wrong-prior.json") (p "wrong-prior.sig"))
        (repair-operation "PR05-old-positive-prefix-refused" (p "wrong-prior.json") (p "wrong-prior.sig") 'repair-refused)
        (hash-put! body "prior" prior)
        (def partial (string-append (hash-ref selection "archive") ".pending"))
        (def partial-sha (review-file-digest partial))
        (repair-operation "PR06-exact-authorized-completion" authorization signature 'repair-completed)
        (check-equal? (review-file-digest partial) partial-sha)
        (def repaired (hash-ref selection "headDigest"))
        (repair-operation "PR07-identical-request-reuses-checkpoint" authorization signature 'repair-reused)
        (check-equal? (hash-ref selection "headDigest") repaired)
        (check-equal? (length (hash-ref (load (hash-ref selection "archive")) "records")) 6)
        ;; Checkpoint is not activated and carries no current approval authority.
        (def selected-reader (recovery-reader-identity))
        (set! source-provider (open-archived-review-source
          (.o owner: (hash-ref selection "owner") cut: (hash-ref selection "cut")
            archive: (hash-ref selection "archive") root-public: (g "root.pub") reader: selected-reader head: host-head) tools))
        (def owner (open-owner source-provider incarnation: selected-reader))
        (def frame ((.ref owner 'frame) "approval/v1"))
        (step "PR08-repaired-checkpoint-still-pending" owner frame (verified frame) 'history-discovery-required))
      (def (repair-replay)
        (def owner (intake-recover-owner))
        (check-equal? (length ((.ref owner 'accepted-decisions))) 6)
        (def denied ((.ref owner 'frame) "approval/v1"))
        (def old (restore-presentations (g "intake-recover/receipt-presentation.json")))
        (for-each (lambda (receipt) (for-each (lambda (request)
          (check-equal? (yuanxu-verification-valid? (.ref denied 'adapter) receipt request 11) #f))
          (cons (.ref denied 'discovery-request) (map cadr (.ref denied 'approval-requests))))) old)
        (step "PR09-repair-cannot-rehydrate-receipts" owner denied old 'history-discovery-required)
        (step "PR10-both-unacknowledged-counters-retained" owner denied (verified denied) 'approval-rejected)
        (def counters (filter-map (lambda (row)
          (and (member (hash-ref (cadr row) "reason") '("R-published-counter" "I-partial-counter")) (car row)))
          ((.ref owner 'accepted-decisions))))
        (check-equal? (length counters) 2)
        (def auth (g "repair-checks/repair-authorization.json"))
        (def sig (g "repair-checks/repair-authorization.sig"))
        (repair-operation "PR11-active-reader-refuses-old-repair" auth sig 'repair-refused)
        (def candidate (g "repair-checks/complete-candidate.json"))
        (dynamic-wind (lambda () (rename-file candidate (p "candidate.missing")))
          (lambda () (repair-operation "PR17-known-stale-repair-refuses-before-missing-input" auth sig 'repair-refused))
          (lambda () (rename-file (p "candidate.missing") candidate)))
        (def resolution (acknowledged owner "N-current-resolution" "approved" counters))
        (def positive ((.ref owner 'frame) "approval/v1")) (def receipts (verified positive))
        (step "PR12-only-current-explicit-disposition-admits" owner positive receipts 'review-admitted)
        (def current (hash-ref selection "headDigest"))
        (check-equal? ((.ref owner 'submit!) (p "N-current-resolution.json") (p "N-current-resolution.sig")) resolution)
        (check-equal? (hash-ref selection "headDigest") current)
        (check-equal? (length ((.ref owner 'accepted-decisions))) 7)
        (repair-operation "PR13-new-prefix-refuses-old-repair" auth sig 'repair-refused)
        (step "PR14-current-receipts-and-records-reused" owner positive receipts 'review-admitted)
        (dynamic-wind (lambda () (rename-file auth (p "authorization.missing")))
          (lambda () (step "PR15-repair-closure-missing-after-new-prefix" owner positive receipts 'history-discovery-required))
          (lambda () (rename-file (p "authorization.missing") auth)))
        (step "PR16-exact-repair-closure-restored" owner positive receipts 'review-admitted))

      (cond ((equal? phase "intake-producer") (intake-producer))
            ((equal? phase "intake-recover") (intake-recover))
            ((equal? phase "intake-partial") (intake-partial))
            ((equal? phase "intake-pending") (intake-pending))
            ((equal? phase "repair-checks") (repair-checks))
            ((equal? phase "repair-replay") (repair-replay))
            ((equal? phase "producer") (producer)) (else (recover)))
      (save (p "steps.json") steps)
      (save (p "process.json") (hash ("pid" (getpid)) ("phase" phase) ("reader" reader)
        ("technicalDigest" (.ref mechanical 'packet)) ("selection" selection))))))
