;;; -*- Gerbil -*-
(import (only-in :gerbil/runtime/loader list-modules) :std/test :std/encoding/json :std/list/list :clan/poo/object
        :yuanxu/contribution/verification
        :agentic-ai-lab/lambda-aitia/modules/sdlc/review-authority
        :deterministic-engineering/scenarios/resource-lifecycle/review/interface)
(export backpressure-cross-intake-test)
(def (load path) (call-with-input-file path (cut read-json <> object-as-hash: #t)))
(def (save path value) (call-with-output-file path (cut write-json <> value)))
(def backpressure-cross-intake-test
  (test-suite "Real cross-intake discovery and native Aitia authority"
    (test-case "intake policy and reviewer changes cannot erase known blockers"
      ;; Observe the actual loader, not a fixture or a claimed backend label.
      (when (getenv "BACKPRESSURE_REVIEW_LIB" #f)
        (let ((files (hash-ref (call-with-input-file (getenv "BACKPRESSURE_REVIEW_SOURCES")
                       (cut read-json <> object-as-hash: #t)) "files")))
        (for-each (lambda (name)
          (def id (string-append "deterministic-engineering/scenarios/resource-lifecycle/review/" name "~0"))
          (def found (assoc id (list-modules)))
          (def prefix (string-append (getenv "BACKPRESSURE_REVIEW_LIB") "/" id ".o"))
          (displayln "NATIVE-OWNER " id " " (and found (cdr found))) (force-output)
          (check-equal? (and found (string? (cdr found))
            (>= (string-length (cdr found)) (string-length prefix))
            (equal? prefix (substring (cdr found) 0 (string-length prefix)))) #t)
          (def reference (and found (assoc (cdr found) files)))
          (check-equal? (and reference (equal? (review-file-digest (car reference)) (cadr reference))) #t))
          '("func" "reassessment" "cross-intake"))))
      (let/cc done
      (def out (getenv "BACKPRESSURE_CROSS_OUTPUT"))
      (when (file-exists? out) (error "cross-intake output must be fresh"))
      (create-directory out)
      (displayln "OUTPUT " out) (force-output)
      (def group (getenv "BACKPRESSURE_CROSS_GROUP" "all"))
      (displayln "GROUP " group) (force-output)
      (def preflight? (member group '("all" "preflight")))
      (def discovery? (member group '("all" "discovery")))
      (def rejection? (member group '("all" "rejection")))
      (def initial? (or discovery? rejection?))
      (def authority? (member group '("all" "authority")))
      (def rows (load (getenv "BACKPRESSURE_REASSESSMENT_RUNS")))
      (for-each (lambda (row) (check-equal? (review-file-digest (cadr row)) (caddr row))) rows)
      (def (run label) (cadr (assoc label rows)))
      (def (history) (open-backpressure-history (getenv "BACKPRESSURE_ACCEPTANCE") (getenv "BACKPRESSURE_REVIEW_SOURCES")))
      (def group-owners (open-cross-intake-group '("intake-a" "intake-b")
        (getenv "BACKPRESSURE_ACCEPTANCE") (getenv "BACKPRESSURE_REVIEW_SOURCES")))
      (def a (car (.ref group-owners 'histories))) (def b (cadr (.ref group-owners 'histories)))
      ;; Reused baseline interpretation cannot share mutable public entry values.
      (def baseline-id (cadr (find (lambda (row)
        (equal? (.ref ((.ref a 'reference) (cadr row)) 'case) "M06"))
        (hash-ref (cadr ((.ref a 'capture))) "counterevidence"))))
      (def public-entry ((.ref a 'entry) baseline-id))
      (def original-dependency (caar (hash-ref public-entry "dependencies")))
      (hash-put! public-entry "outcome" "pass")
      (set-car! (car (hash-ref public-entry "dependencies")) "/untrusted/cross-intake-cache")
      (check-equal? (hash-ref ((.ref b 'entry) baseline-id) "outcome") "fail")
      (check-equal? (caar (hash-ref ((.ref b 'entry) baseline-id) "dependencies")) original-dependency)
      (set! public-entry #f)
      (def repairs
        (let (registered ((.ref a 'add-runs!) (map run '("A-original64" "C-repair64" "C-repair128"))))
          (append (cadr registered) (caddr registered))))
      (def source (hash-ref (load (run "C-repair64")) "source"))
      (def profile (.o (:: @ BackpressureReviewProfile) revision: "cross-intake/r1" scope: "bounded-permit-method/M04-M06"))
      (def (with-repairs selected)
        (def expected (map cadr (hash-ref (cadr ((.ref selected 'capture))) "counterevidence")))
        (def dispositions (filter-map (lambda (id)
          (def failure ((.ref selected 'entry) id))
          (def repair (find (lambda (r) (and (equal? (hash-ref r "case") (hash-ref failure "case"))
            (= (hash-ref r "payloadBytes") (hash-ref failure "payloadBytes")))) repairs))
          (and (not (hash-ref failure "diagnostic")) repair
            (let ((selected-id id) (selected-repair (hash-ref repair "id"))) (.o failure: selected-id repair: selected-repair)))) expected))
        (make-backpressure-reassessment selected profile source dispositions: dispositions))
      (def (credentials review)
        (append (list (reassessment-verify-context review 10 200) (reassessment-verify-content review 10 200))
          (map (lambda (row) (reassessment-verify-disposition review (car row) 10 200)) (.ref review 'disposition-requests))))
      (displayln "PHASE original records and repaired runs registered") (force-output)
      (def local #f) (def local-receipts '()) (def local-result #f)
      (when preflight?
        (set! local (with-repairs a)) (set! local-receipts (credentials local))
        (set! local-result (reassessment-stage local local-receipts 11))
        (check-equal? (.ref local-result 'status) 'stage-admitted))
      ;; B discovers two actual failures absent from A; their original IDs survive the union.
      ((.ref b 'add-run!) (run "B-regression64"))
      (def federation (.ref group-owners 'federation))
      (def merged ((.ref federation 'capture)))
      (check-equal? (length (hash-ref (car merged) "clues")) 46)
      (check-equal? (length (hash-ref (cadr merged) "counterevidence")) 7)
      (save (path-expand "history-capture.json" out) merged)
      (save (path-expand "intake-captures.json" out) ((.ref federation 'discover)))
      (def omitted #f) (def omitted-result #f)
      (when preflight?
        (set! omitted (make-backpressure-reassessment federation profile source failures: (.ref local 'failure-ids)))
        (set! omitted-result (reassessment-verify-content omitted 10 100))
        (check-equal? omitted-result #f))
      (displayln "PHASE complete native union queried") (force-output)
      (save (path-expand "registration-work.json" out)
        (map (lambda (binding)
          (def stats ((.ref (cdr binding) 'registration-stats)))
          (list (car binding) (.ref stats 'batches) (.ref stats 'logical-dependency-references)
            (.ref stats 'checked-dependency-paths)))
          (list (cons "intake-a" a) (cons "intake-b" b) (cons "aggregate" federation))))
      (def mechanical (with-repairs federation))
      (def old-receipts-result #f)
      (when preflight?
        (set! old-receipts-result (reassessment-stage mechanical local-receipts 11))
        (check-equal? (.ref old-receipts-result 'admitted?) #f)
        (check-equal? (.ref old-receipts-result 'status) 'context-verification-required)
        (check-equal? (.ref old-receipts-result 'current?) #t)
        (check-equal? (.ref old-receipts-result 'history-complete?) #t))
      ((.ref federation 'current!))
      (check-equal? (hash-ref (cadr ((.ref federation 'capture))) "viewIdentity") (hash-ref (cadr merged) "viewIdentity"))
      (when (equal? group "preflight")
        (save (path-expand "preflight.json" out) (hash ("schema" "aitia.cross-intake-preflight/v1")
          ("localStatus" (symbol->string (.ref local-result 'status)))
          ("omittedVerified" (and omitted-result #t))
          ("oldReceiptsAdmitUnion" (.ref old-receipts-result 'admitted?))
          ("oldReceiptsStatus" (symbol->string (.ref old-receipts-result 'status)))
          ("unionCurrent" (.ref old-receipts-result 'current?))
          ("unionComplete" (.ref old-receipts-result 'history-complete?))
          ("localPacket" (.ref local 'packet)) ("omittedPacket" (.ref omitted 'packet))
          ("unionPacket" (.ref mechanical 'packet))
          ("receiptMetadataIsAuthority" #f)))
        (displayln "PREFLIGHT-OK actual local admission, omitted inventory refusal and old receipt isolation") (force-output)
        (done #t))
      ;; Completed previews are not owners of the current authority worker.
      (set! local #f) (set! local-result #f) (set! omitted #f) (set! omitted-result #f)
      (set! old-receipts-result #f) (set! local-receipts '()) (set! repairs '())
      (def mechanical-receipts (credentials mechanical))
      (def diagnostic (reassessment-stage mechanical mechanical-receipts 11))
      (save (path-expand "mechanical-diagnostic.json" out) (hash
        ("receipts" (map (lambda (r) (and r #t)) mechanical-receipts))
        ("current" (.ref diagnostic 'current?)) ("complete" (.ref diagnostic 'history-complete?))
        ("unresolved" (.ref diagnostic 'unresolved))
        ("covers" (map cadr (.ref mechanical 'disposition-requests)))))
      (check-equal? (.ref diagnostic 'status) 'stage-admitted)
      (check-equal? (length (.ref mechanical 'failure-ids)) 7)
      (call-with-output-file (path-expand "mechanical-packet.json" out) (cut display (.ref mechanical 'packet) <>))
      ;; Completed setup controls retain neither requests nor full dependency copies.
      (set! repairs '()) (set! local #f) (set! local-receipts '())
      (set! omitted #f) (set! diagnostic #f) (set! merged #f)
      (def tools (review-signature-tools (getenv "BACKPRESSURE_OPENSSL") out))
      (def (p name) (path-expand name out))
      (for-each (lambda (name) ((.ref tools 'generate) (p (string-append name ".key")) (p (string-append name ".pub")))) '("root" "alice" "bob"))
      (save (p "directory.json") (hash ("sources" '("intake-a" "intake-b")) ("requiredSigner" "test-reviewer-a")
        ("policies" '("approval/v1" "approval/v2")) ("qualificationOnly" #t)))
      ((.ref tools 'sign) (p "root.key") (p "directory.json") (p "directory.sig"))
      (def changed-body (load (p "mechanical-packet.json")))
      (hash-put! changed-body "scope" "bounded-permit-method/M04")
      (def changed-mechanical (.o (:: @ mechanical) packet: (json->string changed-body)))
      (check-exception (open-cross-intake-approval federation changed-mechanical tools
        (p "directory.json") (p "directory.sig") (p "root.pub") (p "alice.pub") (p "bob.pub")) (lambda (_) #t))
      (set! changed-body #f) (set! changed-mechanical #f)
      (def authority (open-cross-intake-approval federation mechanical tools (p "directory.json") (p "directory.sig")
        (p "root.pub") (p "alice.pub") (p "bob.pub")))
      (def original-target ((.ref authority 'target) "approval/v1"))
      (string-set! (.ref authority 'technical-digest) 0 #\X)
      (check-equal? ((.ref authority 'target) "approval/v1") original-target)
      (def frame (.ref authority 'frame)) (def submit! (.ref authority 'submit!))
      (def (verified selected (until 100))
        (filter identity (cons (yuanxu-verify (.ref selected 'adapter) (.ref selected 'discovery-request) 10 until)
          (map (lambda (row) (yuanxu-verify (.ref selected 'adapter) (cadr row) 10 until)) (.ref selected 'approval-requests)))))
      (def steps '())
      (def (finish!)
        (save (p "steps.json") steps)
        (def sync-work ((.ref federation 'sync-stats)))
        (save (p "sync-work.json") (hash ("rebuilds" (.ref sync-work 'rebuilds)) ("reuses" (.ref sync-work 'reuses))))
        (save (p "query-work.json") (map (lambda (pair)
          (def stats ((.ref (cadr pair) 'capture-stats)))
          (list (car pair) (.ref stats 'queries)))
          (list (list "intake-a" a) (list "intake-b" b) (list "aggregate" federation)))))

      (def (record-step label selected receipts expected (now 11))
        (def gate ((.ref selected 'gate) mechanical-receipts receipts now))
        (check-equal? (.ref gate 'current-use-checked?) #t)
        (check-equal? (.ref gate 'status) expected)
        (check-equal? (.ref gate 'release-authorized?) #f)
        (def input-path (p (string-append label "-input.json")))
        (def presented-path (p (string-append label "-presentation.json")))
        (call-with-output-file input-path (cut display (.ref selected 'packet) <>))
        (def input (load input-path))
        (def current-decisions ((.ref authority 'accepted-decisions)))
        (def authority-files (delete-duplicates/hash (append (hash-ref input "rootReferences")
          (append-map caddr current-decisions))))
        (save presented-path (hash ("receiptMetadataIsAuthority" #f)
          ("nativeRequests" (map sdlc-review-authority-snapshot
            (cons (.ref selected 'discovery-request) (map cadr (.ref selected 'approval-requests)))))
          ("acceptedNow" current-decisions) ("intakesNow" ((.ref federation 'discover)))
          ("authorityFilesNow" (map (lambda (pair) (list (car pair)
            (with-catch (lambda (_) #f) (lambda () (review-file-digest (car pair)))))) authority-files))
          ("checker" (list (getenv "BACKPRESSURE_OPENSSL") (review-file-digest (getenv "BACKPRESSURE_OPENSSL"))))
          ("receipts" (map (lambda (receipt) (list (.ref receipt 'identity) (.ref receipt 'issuer)
            (.ref receipt 'issued-at) (.ref receipt 'expires-at))) receipts))))
        (set! steps (append steps (list (hash ("step" label) ("status" (symbol->string (.ref gate 'status))) ("goldStatus" (symbol->string expected))
          ("allFailures" (.ref (.ref gate 'technical) 'failure-ids))
          ("unresolved" (.ref (.ref gate 'technical) 'unresolved)) ("receiptCount" (length receipts)) ("boundary" "current-use-check")
          ("inputPacket" input-path) ("inputPacketSha256" (review-file-digest input-path))
          ("presentationPacket" presented-path) ("presentationPacketSha256" (review-file-digest presented-path))
          ("authorityRecords" (map (lambda (row) (caar row)) (.ref selected 'approval-requests)))))))
        (displayln "GOLD " label " " expected) (force-output))
      (def (step label selected receipt-thunk expected (now 11))
        (def n (string->number (substring label 2 4)))
        (when (or (equal? group "all")
                  (and (equal? group "discovery") (or (<= n 6) (= n 27)))
                  (and (equal? group "rejection") (<= 7 n 10))
                  (and (equal? group "authority") (<= 11 n 19))
                  (and (equal? group "reuse") (or (<= 20 n 26) (= n 28))))
          (record-step label selected (receipt-thunk) expected now)))
      (def (decision name signer key policy outcome supersedes)
        (save (p (string-append name ".json")) (hash ("signer" signer) ("policy" policy) ("decision" outcome)
          ("supersedes" supersedes) ("target" ((.ref authority 'target) policy))))
        ((.ref tools 'sign) (p key) (p (string-append name ".json")) (p (string-append name ".sig")))
        (list (p (string-append name ".json")) (p (string-append name ".sig"))))
      (def initial (and initial? (frame "approval/v1")))
      (def initial-receipts (if initial? (verified initial) '()))
      (when discovery? (let ()
      (step "CI01-no-discovery" initial (lambda () '()) 'history-discovery-required)
      (def altered (frame "approval/v1"))
      (set-cdr! (.ref (.ref altered 'discovery) 'required) '())
      (set-cdr! (.ref (.ref altered 'discovery) 'sources) '())
      (check-equal? (yuanxu-verify (.ref altered 'adapter) (.ref altered 'discovery-request) 10 100) #f)
      (step "CI27-edited-discovery-cannot-weaken-mandate" altered (lambda () '()) 'history-discovery-required)
      (def incomplete (frame "approval/v1" '("intake-a")))
      (check-equal? (yuanxu-verify (.ref incomplete 'adapter) (.ref incomplete 'discovery-request) 10 100) #f)
      (step "CI02-switch-to-a" incomplete (lambda () (verified incomplete)) 'history-discovery-required)
      (def only-b (frame "approval/v1" '("intake-b")))
      (step "CI03-switch-to-b" only-b (lambda () (verified only-b)) 'history-discovery-required)
      (step "CI04-complete-history-no-approval" initial (lambda () initial-receipts) 'approval-verification-required)
      (set! altered #f) (set! incomplete #f) (set! only-b #f)
      (def ungranted (decision "ungranted" "test-reviewer-b" "bob.key" "approval/v1" "approved" '()))
      (check-equal? (apply submit! ungranted) #f)
      (step "CI05-ungranted-reviewer" initial (lambda () initial-receipts) 'approval-verification-required)
      (def forged (decision "wrong-key" "test-reviewer-a" "bob.key" "approval/v1" "approved" '()))
      (check-equal? (apply submit! forged) #f)
      (step "CI06-renamed-reviewer" initial (lambda () initial-receipts) 'approval-verification-required)
      ))
      (when (equal? group "discovery") (finish!) (done #t))
      (def rejected (decision "rejected" "test-reviewer-a" "alice.key" "approval/v1" "rejected" '()))
      (def rejection-id (apply submit! rejected)) (check-equal? (string? rejection-id) #t)
      (step "CI07-old-frame-after-rejection" initial (lambda () initial-receipts) 'history-discovery-required)
      (set! initial #f) (set! initial-receipts '())
      (when rejection? (let ()
      (def denied (frame "approval/v1"))
      (step "CI08-authenticated-rejection" denied (lambda () (verified denied)) 'approval-rejected)
      ;; Public native values own their strings; a bad proposal cannot mutate
      ;; the private project, directory digest or accepted decision identity.
      (def malformed (frame "approval/v1"))
      (def malformed-discovery (.ref malformed 'discovery))
      (def malformed-approval (.ref (.ref (cadar (.ref malformed 'approval-requests)) 'facts) 'approval))
      (string-set! (.ref malformed-discovery 'subject) 0 #\X)
      (string-set! (.ref malformed-discovery 'directory) 0 #\X)
      (string-set! (.ref malformed-approval 'identity) 0 #\X)
      (check-exception (yuanxu-verify (.ref malformed 'adapter) (.ref malformed 'discovery-request) 10 100) (lambda (_) #t))
      (def isolated (frame "approval/v1"))
      (check-equal? (.ref (.ref isolated 'discovery) 'subject) "rust.backpressure-lifecycle")
      (check-equal? (.ref (.ref isolated 'discovery) 'directory) (review-file-digest (p "directory.json")))
      (check-equal? (.ref (.ref (.ref (cadar (.ref isolated 'approval-requests)) 'facts) 'approval) 'identity) rejection-id)
      (check-equal? (.ref ((.ref isolated 'gate) mechanical-receipts (verified isolated) 11) 'status) 'approval-rejected)
      (save (p "native-value-isolation.json") (hash ("malformedProposalRefused" #t)
        ("freshSubject" (.ref (.ref isolated 'discovery) 'subject))
        ("freshDirectory" (.ref (.ref isolated 'discovery) 'directory)) ("retainedRejection" rejection-id)))
      (set! denied #f) (set! malformed #f) (set! malformed-discovery #f)
      (set! malformed-approval #f) (set! isolated #f)
      (def policy2 (frame "approval/v2"))
      (step "CI09-policy-cannot-hide-rejection" policy2 (lambda () (verified policy2)) 'approval-rejected)
      ))
      (def unclosed (decision "unclosed" "test-reviewer-a" "alice.key" "approval/v2" "approved" '()))
      (check-equal? (string? (apply submit! unclosed)) #t)
      (def still-denied (and rejection? (frame "approval/v2")))
      (step "CI10-approval-without-disposition" still-denied (lambda () (verified still-denied)) 'approval-rejected)
      (set! still-denied #f)
      (when (equal? group "rejection") (finish!) (done #t))
      (def resolution (decision "resolved" "test-reviewer-a" "alice.key" "approval/v2" "approved" (list rejection-id)))
      (check-equal? (string? (apply submit! resolution)) #t)
      (def resolved (and authority? (frame "approval/v2"))) (def resolved-receipts (if authority? (verified resolved) '()))
      (step "CI11-explicit-signed-disposition" resolved (lambda () resolved-receipts) 'review-admitted)
      (step "CI12-same-cut-reuse" resolved (lambda () resolved-receipts) 'review-admitted 12)
      (def cloned (map (lambda (receipt) (.o (:: @ receipt))) resolved-receipts))
      (step "CI13-cloned-receipts" resolved (lambda () cloned) 'history-discovery-required)
      (step "CI14-expired-receipts" resolved (lambda () resolved-receipts) 'history-discovery-required 100)
      (when authority? (let ()
      (def resolution-row (find (lambda (row) (equal? (caar row) (review-file-digest (car resolution)))) (.ref resolved 'approval-requests)))
      (def resolution-receipt (find (lambda (receipt) (yuanxu-verification-valid? (.ref resolved 'adapter) receipt (cadr resolution-row) 11)) resolved-receipts))
      (yuanxu-revoke-verification! (.ref resolved 'adapter) resolution-receipt)
      (step "CI15-revoked-resolution-reopens" resolved (lambda () resolved-receipts) 'approval-rejected)
      (def old-policy (frame "approval/v1"))
      (step "CI16-new-policy-approval-not-portable" old-policy (lambda () (verified old-policy)) 'approval-rejected)
      ))
      (set! resolved #f) (set! resolved-receipts '()) (set! cloned '())
      ;; A real signed target-bound delegation is the only alternative reviewer route.
      (def delegated (decision "delegated" "test-reviewer-b" "bob.key" "approval/v2" "approved" (list rejection-id)))
      (save (p "delegation.json") (hash ("delegate" "test-reviewer-b") ("publicKey" (review-file-digest (p "bob.pub")))
        ("target" ((.ref authority 'target) "approval/v1")) ("supersedes" (list rejection-id))))
      ((.ref tools 'sign) (p "alice.key") (p "delegation.json") (p "delegation.sig"))
      (check-equal? (submit! (car delegated) (cadr delegated) (p "delegation.json") (p "delegation.sig")) #f)
      (save (p "delegation.json") (hash ("delegate" "test-reviewer-b") ("publicKey" (review-file-digest (p "bob.pub")))
        ("target" ((.ref authority 'target) "approval/v2")) ("supersedes" (list rejection-id))))
      ((.ref tools 'sign) (p "alice.key") (p "delegation.json") (p "delegation.sig"))
      (check-equal? (string? (submit! (car delegated) (cadr delegated) (p "delegation.json") (p "delegation.sig"))) #t)
      (def handoff (frame "approval/v2")) (def handoff-receipts (verified handoff))
      (dynamic-wind (lambda () (rename-file (p "delegation.sig") (p "delegation.unavailable")))
        (lambda () (step "CI17-unneeded-positive-unavailable" handoff (lambda () handoff-receipts) 'review-admitted))
        (lambda () (rename-file (p "delegation.unavailable") (p "delegation.sig"))))
      (def handoff-alice-row (find (lambda (row) (equal? (caar row) (review-file-digest (car resolution)))) (.ref handoff 'approval-requests)))
      (def handoff-alice-receipt (find (lambda (receipt) (yuanxu-verification-valid? (.ref handoff 'adapter) receipt (cadr handoff-alice-row) 11)) handoff-receipts))
      (yuanxu-revoke-verification! (.ref handoff 'adapter) handoff-alice-receipt)
      (step "CI18-authorized-handoff" handoff (lambda () handoff-receipts) 'review-admitted)
      (dynamic-wind (lambda () (rename-file (p "directory.sig") (p "directory.unavailable")))
        (lambda () (step "CI19-authority-unavailable" handoff (lambda () handoff-receipts) 'history-discovery-required))
        (lambda () (rename-file (p "directory.unavailable") (p "directory.sig"))))
      (when (equal? group "authority") (finish!) (done #t))
      (step "CI20-identical-authority-restored" handoff (lambda () handoff-receipts) 'review-admitted)
      (dynamic-wind (lambda () (rename-file (p "delegation.sig") (p "delegation.unavailable")))
        (lambda () (step "CI21-delegation-unavailable" handoff (lambda () handoff-receipts) 'approval-rejected))
        (lambda () (rename-file (p "delegation.unavailable") (p "delegation.sig"))))
      (step "CI22-identical-delegation-restored" handoff (lambda () handoff-receipts) 'review-admitted)
      (def unknown-policy (decision "unknown-policy" "test-reviewer-a" "alice.key" "approval/unknown" "approved" '()))
      (check-equal? (apply submit! unknown-policy) #f)
      ;; Rewriting a source record cannot relabel a previously accepted rejection.
      (def preserved-rejection (p "rejection-preserved.json"))
      (def preserved-signature (p "rejection-preserved.sig"))
      (dynamic-wind (lambda () (rename-file (car rejected) preserved-rejection) (rename-file (cadr rejected) preserved-signature))
        (lambda ()
          (decision "rejected" "test-reviewer-a" "alice.key" "approval/v2" "approved" '())
          (def tampered (frame "approval/v2"))
          (def original-row (find (lambda (row) (equal? (caar row) rejection-id)) (.ref tampered 'approval-requests)))
          (check-equal? (.ref (.ref (.ref (cadr original-row) 'facts) 'approval) 'decision) 'rejected)
          (step "CI23-rewritten-negative-retained" tampered (lambda () (verified tampered)) 'approval-verification-required)
          (rename-file (car rejected) (p "rewritten-rejection.json"))
          (rename-file (cadr rejected) (p "rewritten-rejection.sig")))
        (lambda ()
          (when (file-exists? (car rejected)) (delete-file (car rejected)))
          (rename-file preserved-rejection (car rejected))
          (when (file-exists? (cadr rejected)) (delete-file (cadr rejected)))
          (rename-file preserved-signature (cadr rejected))))
      ;; New accepted denial invalidates every old frame, including an admitted one.
      (def late (decision "late-rejection" "test-reviewer-a" "alice.key" "approval/v2" "rejected" '()))
      (check-equal? (string? (apply submit! late)) #t)
      (step "CI24-late-denial-invalidates-old-frame" handoff (lambda () handoff-receipts) 'history-discovery-required)
      (set! handoff #f) (set! handoff-receipts '())
      (set! handoff-alice-row #f) (set! handoff-alice-receipt #f)
      (def late-frame (frame "approval/v2"))
      (step "CI25-late-denial-retained" late-frame (lambda () (verified late-frame)) 'approval-rejected)
      ;; Same members with a new native source cut invalidate the technical capture too.
      ((.ref b 'observe!) (review-file-digest (run "B-regression64")))
      (step "CI26-source-cut-invalidates" late-frame (lambda () (verified late-frame)) 'requirements-blocked)
      (set! late-frame #f)
      (def changed-frame (frame "approval/v2"))
      (check-equal? (yuanxu-verify (.ref changed-frame 'adapter) (.ref changed-frame 'discovery-request) 10 100) #f)
      (step "CI28-fresh-frame-cannot-promote-old-technical-cut" changed-frame (lambda () (verified changed-frame)) 'requirements-blocked)
      (finish!)))))
