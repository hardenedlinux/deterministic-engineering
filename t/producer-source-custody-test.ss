;;; -*- Gerbil -*-
(import :std/test :std/encoding/json :std/list/list :clan/poo/object
        :deterministic-engineering/scenarios/resource-lifecycle/review/profile
        :deterministic-engineering/scenarios/resource-lifecycle/review/func
        :deterministic-engineering/scenarios/resource-lifecycle/review/reassessment)
(export producer-source-custody-test)
(def (load path) (call-with-input-file path (cut read-json <> object-as-hash: #t)))
(def (save path value) (call-with-output-file path (cut write-json <> value)))
(def (clone value) (call-with-input-string (json->string value) (cut read-json <> object-as-hash: #t)))
(def producer-source-custody-test
  (test-suite "Exact historical producer bytes and fresh native consumer authority"
    (test-case "custody preserves identities without retargeting or dropping inputs"
      (def custody-path (getenv "BACKPRESSURE_PRODUCER_CUSTODY"))
      (def sources-path (getenv "BACKPRESSURE_REVIEW_SOURCES"))
      (def acceptance (getenv "BACKPRESSURE_ACCEPTANCE"))
      (def custody (load custody-path)) (def sources (load sources-path))
      (def out (getenv "BACKPRESSURE_CUSTODY_OUTPUT"))
      (when (file-exists? out) (error "custody output must be fresh"))
      (create-directory out) (displayln "OUTPUT " out) (force-output)
      (def steps '())
      (def (gold id result)
        (set! steps (append steps (list (list id result))))
        (displayln "GOLD " id " " result) (force-output))
      (check-equal? (validate-producer-source-custody custody-path sources-path acceptance) #t)
      (def review (make-backpressure-review BackpressureReviewProfile acceptance))
      (def cr (verify-review-context review 10 100))
      (def er (verify-review-content review 10 100))
      (check-equal? (.ref (backpressure-stage review (list cr er) 11) 'status) 'stage-admitted)
      (gold "SC01" "exact-source-custody-admitted")
      (def (refuse id mutate)
        (def candidate (clone custody)) (mutate candidate)
        (def path (path-expand (string-append id ".json") out)) (save path candidate)
        ;; This is an untrusted input declaration for the data validator only.
        ;; It never installs the process reader or issues a native receipt.
        (def declaration (clone sources))
        (hash-put! declaration "files" (cons (list path (review-file-digest path)) (hash-ref declaration "files")))
        (def manifest (path-expand (string-append id "-sources.json") out)) (save manifest declaration)
        (check-exception (validate-producer-source-custody path manifest acceptance) (lambda (_) #t))
        (gold id "refused"))
      (refuse "SC02" (lambda (c)
        (hash-put! c "references" (cons (car (hash-ref c "references")) (hash-ref c "references")))))
      (refuse "SC03" (lambda (c)
        (def refs (hash-ref c "references"))
        (set-car! refs (list "/untrusted/live-rust/main.rs" (cadar refs) (caddar refs)))))
      (refuse "SC04" (lambda (c) (set-car! (cddar (hash-ref c "references")) "/untrusted/other-location.ss")))
      (refuse "SC05" (lambda (c) (set-car! (cdar (hash-ref c "references")) (make-string 64 #\0))))
      (def original-methods (find (lambda (row) (string-contains (car row) "/rust/methods.ss")) (hash-ref custody "references")))
      (def archived (caddr original-methods)) (def preserved (path-expand "preserved-methods.ss" out))
      (displayln "PRODUCER-CUSTODY-BACKUP " archived " " preserved " " (cadr original-methods)) (force-output)
      (dynamic-wind
        (lambda () (rename-file archived preserved))
        (lambda ()
          (check-equal? (and (verify-review-context review 10 100) #t) #t)
          (check-exception (verify-review-content review 10 100) (lambda (_) #t))
          (check-exception (validate-producer-source-custody custody-path sources-path acceptance) (lambda (_) #t))
          (gold "SC06" "missing-archive-blocks-content"))
        (lambda () (rename-file preserved archived)))
      (check-equal? (review-file-digest archived) (cadr original-methods))
      (def fresh (verify-review-content review 10 100))
      (check-equal? (.ref (backpressure-stage review (list cr fresh) 11) 'status) 'stage-admitted)
      (gold "SC07" "restored-bytes-rechecked")
      ;; A real consumer-source change remains outside historical custody.
      (def live (path-expand "live-source.rs" out)) (call-with-output-file live (cut display "original\n" <>))
      (def before (review-file-digest live))
      (call-with-output-file (list path: live append: #t) (cut display "changed\n" <>))
      (check-equal? (review-reference-path live before) live)
      (check-equal? (equal? (review-file-digest live) before) #f)
      (gold "SC08" "live-source-is-not-relocated")
      (save (path-expand "steps.json" out) steps))))
