;;; -*- Gerbil -*-
;;; Actual Rust runs, full byte checks, and independent native ASCENT snapshots.
(import :std/test :std/encoding/json :std/list/list :clan/poo/object
        (only-in :std/os/pid getpid) (only-in :gerbil/runtime/loader list-modules)
        :deterministic-engineering/scenarios/resource-lifecycle/review/interface)
(export backpressure-registration-batch-test)
(def (load path) (call-with-input-file path (cut read-json <> object-as-hash: #t)))
(def (save path value) (call-with-output-file path (cut write-json <> value)))
(def backpressure-registration-batch-test
  (test-suite "Native registration shares checks only within one operation"
    (test-case "complete real batches preserve blockers and reject partial input"
      (def out (getenv "BACKPRESSURE_REGISTRATION_OUTPUT")) (create-directory out)
      (displayln "OUTPUT " out) (displayln "PROCESS " (getpid)) (force-output)
      (when (getenv "BACKPRESSURE_NATIVE_TEST_LIB" #f)
        (let* ((id "deterministic-engineering/t/backpressure-registration-batch-test~0")
               (loaded (assoc id (list-modules)))
               (owner-id "deterministic-engineering/scenarios/resource-lifecycle/review/reassessment~0")
               (owner (assoc owner-id (list-modules))))
          (check-equal? (and loaded (cdr loaded))
            (string-append (getenv "BACKPRESSURE_NATIVE_TEST_LIB") "/" id ".o1"))
          (check-equal? (and owner (cdr owner))
            (string-append (getenv "BACKPRESSURE_REVIEW_LIB") "/" owner-id ".o1"))))
      (def runs (load (getenv "BACKPRESSURE_REASSESSMENT_RUNS")))
      (for-each (lambda (row) (check-equal? (review-file-digest (cadr row)) (caddr row))) runs)
      (def (run name) (cadr (assoc name runs)))
      (def paths (map run '("A-original64" "C-repair64" "C-repair128")))
      (def history (open-backpressure-history (getenv "BACKPRESSURE_ACCEPTANCE") (getenv "BACKPRESSURE_REVIEW_SOURCES")))
      (def initial ((.ref history 'capture)))
      (def (ids capture) (map (cut hash-ref <> "id") (hash-ref (car capture) "clues")))
      (def old-counters (map cadr (hash-ref (cadr initial) "counterevidence")))
      (check-equal? (length (ids initial)) 22)
      (def steps '())
      (def (step name expected-count)
        (def current ((.ref history 'capture)))
        (check-equal? (length (ids current)) expected-count)
        (for-each (lambda (id) (check-equal? (and (member id (map cadr (hash-ref (cadr current) "counterevidence"))) #t) #t)) old-counters)
        (def stats ((.ref history 'registration-stats)))
        (set! steps (append steps (list (hash ("id" name) ("capture" current)
          ("batches" (.ref stats 'batches)) ("logicalReferences" (.ref stats 'logical-dependency-references))
          ("checkedPaths" (.ref stats 'checked-dependency-paths))))))
        (displayln "GOLD " name " clues=" expected-count) (force-output) current)
      (check-exception ((.ref history 'add-runs!) (list (car paths) (car paths))) (lambda (_) #t))
      (def duplicate (step "BR01-duplicate-path-refused" 22))
      (check-equal? (hash-ref (cadr initial) "viewIdentity") (hash-ref (cadr duplicate) "viewIdentity"))
      (def raw (hash-ref (load (cadr paths)) "observations"))
      (def raw-sha (review-file-digest raw))
      (def backup (path-expand "observations.unavailable" out))
      (displayln "REGISTRATION-BACKUP " raw " " backup " " raw-sha) (force-output)
      (dynamic-wind (lambda () (rename-file raw backup))
        (lambda ()
          (check-exception ((.ref history 'add-runs!) paths) (lambda (_) #t))
          (def refused (step "BR02-missing-input-no-partial-publication" 22))
          (check-equal? (hash-ref (cadr initial) "viewIdentity") (hash-ref (cadr refused) "viewIdentity")))
        (lambda () (rename-file backup raw)))
      (check-equal? (review-file-digest raw) raw-sha)
      (def groups ((.ref history 'add-runs!) paths))
      (check-equal? (map length groups) '(6 6 6))
      (step "BR03-complete-batch-registered" 40)
      (def entry (caar groups)) (def entry-id (hash-ref entry "id"))
      (def record-sha (hash-ref entry "recordSha256"))
      (hash-put! entry "recordSha256" "public-mutation")
      (check-equal? (hash-ref ((.ref history 'entry) entry-id) "recordSha256") record-sha)
      (step "BR04-public-entry-isolated" 40)
      (check-equal? (length ((.ref history 'add-run!) (run "B-regression64"))) 6)
      (def completed (step "BR05-next-operation-rechecks-dependencies" 46))
      (check-equal? (length (hash-ref (cadr completed) "counterevidence")) 7)
      (check-exception ((.ref history 'add-runs!) (list (car paths) (cadr paths))) (lambda (_) #t))
      (def final (step "BR06-duplicate-ids-no-partial-publication" 46))
      (check-equal? (hash-ref (cadr completed) "viewIdentity") (hash-ref (cadr final) "viewIdentity"))
      (save (path-expand "steps.json" out) steps)
      (save (path-expand "input.json" out) (hash ("paths" paths) ("nextPath" (run "B-regression64"))
        ("sourceRuns" runs) ("raw" (list raw raw-sha)) ("receiptMetadataIsAuthority" #f))))))
