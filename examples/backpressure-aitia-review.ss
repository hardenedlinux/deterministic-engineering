#!/usr/bin/env gxi

;;; -*- Gerbil -*-
(import :clan/poo/object :std/encoding/json
        :deterministic-engineering/scenarios/resource-lifecycle/review/interface)
(export main)
(def (main acceptance sources output)
  (when (file-exists? output) (error "review output must be a fresh directory"))
  (create-directory output)
  (def transitions '())
  (def (stage name review receipts instant expected)
    (def result (backpressure-stage review receipts instant))
    (unless (eq? (.ref result 'status) expected) (error "independent stage gold differs" name))
    (set! transitions (append transitions
      (list (hash ("step" name) ("status" (symbol->string expected))
                  ("releaseAuthorized" (.ref result 'release-authorized?))
                  ("reportedFailures" (length (.ref result 'reported-failures))))))))
  (def (save-packet name review)
    (def destination (path-expand name output))
    (call-with-output-file destination (lambda (port) (display (.ref review 'packet) port)))
    (unless (equal? (review-file-digest destination) (.ref review 'packet-digest))
      (error "saved packet bytes differ from native criterion digest")))
  (def safe (make-backpressure-review BackpressureReviewProfile acceptance sources: sources))
  (save-packet "safe-r1.json" safe)
  (stage "01-no-context-receipt" safe '() 11 'context-verification-required)
  (def sc (verify-review-context safe 10 20))
  (stage "02-context-only" safe (list sc) 11 'content-verification-required)
  (def se (verify-review-content safe 10 20))
  (stage "03-verified-content" safe (list sc se) 11 'stage-admitted)
  (stage "04-same-basis-reuse" safe (list sc se) 12 'stage-admitted)
  (def revision-profile (.o (:: @ BackpressureReviewProfile) revision: "accepted-owner-slice/r2"))
  (def revised (make-backpressure-review revision-profile acceptance previous: safe sources: sources))
  (save-packet "safe-r2.json" revised)
  (stage "05-old-receipts-new-revision" revised (list sc se) 12 'context-verification-required)
  (def rc (verify-review-context revised 11 21))
  (stage "06-new-context-old-content-receipt" revised (list rc se) 12 'content-verification-required)
  (def re (verify-review-content revised 11 21))
  (stage "07-content-reuse-fresh-admission" revised (list rc re) 12 'stage-admitted)
  (def unsafe-profile (.o (:: @ BackpressureReviewProfile) target: 'caller-owned scope: "bounded-permit-method/M06"))
  (def unsafe-review (make-backpressure-review unsafe-profile acceptance sources: sources))
  (save-packet "caller-owned-failure.json" unsafe-review)
  (def uc (verify-review-context unsafe-review 10 20))
  (def ue (verify-review-content unsafe-review 10 20))
  (stage "08-real-counter-selected" unsafe-review (list uc ue) 11 'requirements-blocked)
  (def narrowed (make-backpressure-review revision-profile acceptance previous: unsafe-review sources: sources))
  (save-packet "narrowed-unresolved-history.json" narrowed)
  (def nc (verify-review-context narrowed 11 21))
  (def ne (verify-review-content narrowed 11 21))
  (stage "09-safe-content-unresolved-failure" narrowed (list nc ne) 12 'requirements-blocked)
  (def result
    (hash ("schema" "aitia.backpressure-review-run/v1")
          ("qualified" #t) ("boundary" "Native bounded SWE-061/p1 coding-method review; no institutional classification or release authorization")
          ("acceptance" acceptance) ("acceptanceSha256" (review-file-digest acceptance))
          ("consumerSources" sources) ("consumerSourcesSha256" (review-file-digest sources))
          ("evidenceRecords" 22) ("historicalQueries" 9) ("historicalExchanges" 7)
          ("newRustQntLeanRuns" 0) ("transitions" transitions)))
  (call-with-output-file (path-expand "review-run.json" output) (cut write-json <> result))
  (displayln "AITIA-REAL-BACKPRESSURE-REVIEW-OK"))
