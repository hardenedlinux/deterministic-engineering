;;; -*- Gerbil -*-
(import :deterministic-engineering/init :deterministic-engineering/profiles/resource-lifecycle
        :clan/poo/object :std/encoding/json :gerbil-ascent/program/session
        (only-in :agentic-ai-lab/modules/temporal-causality/trajectory/ascent-ledger ascent-trajectory)
        (only-in :std/misc/ports read-all-as-string))
(export main)
(def (read-text p) (call-with-input-file p read-all-as-string))
(def (write-text p s) (call-with-output-file (list path: p truncate: #t) (cut display s <>)))
(def (wire rows) (map (lambda (r) (map (lambda (v) (if (symbol? v) (symbol->string v) v)) r)) rows))
(def (require label condition) (unless condition (error "native mechanism gold mismatch" label)))
(def (rejects? thunk) (with-catch (lambda (_) #t) (lambda () (thunk) #f)))
(def (main output cargo rustc quint lean)
  (def root (current-directory)) (set! output (path-expand output root))
  (create-directory output)
  ((.get deterministic-engineering.init.exports std-make-spec) '("init" "profiles/resource-lifecycle" "examples/resource-lifecycle-evidence"))
  (.call deterministic-engineering.init.exports admit-current)
  (def scene (.get (.get deterministic-engineering.init.exports Scenarios) resource-lifecycle scope))
  (def entry (.ref scene 'entry)) (def m (.ref scene 'methods))
  (def digest (.ref m 'file-digest)) (def value-digest (.ref m 'value-digest))
  (def save (.ref m 'write-json)) (def record (.ref m 'record))
  (def rules (path-expand "library/drivers/evidence/func.ss" root))
  (def crate (path-expand "languages-engineering/rust/concurrency/resource-control/backpressure-memory" root))
  (def records '()) (def queries '()) (def exchanges '())
  (def session #f) (def trajectory #f) (def usage #f) (def scopes #f)
  (def (add xs) (set! records (append records xs)))
  (def (phase name) (displayln "RESOURCE-PHASE " name) (force-output))
  (def (begin-cut profile selected-crate id name (mode 'normal))
    (set! usage id)
    (def context ((.ref scene 'capture) root profile selected-crate cargo rustc id mode))
    (set! scopes (.ref context 'scopes))
    (def cut (.ref context 'snapshot))
    (if session
      (gerbil-ascent-session-replace-sources! session
        (list (cons 'application (list (list id cut (.ref entry 'identity))))
              (cons 'factor (map (lambda (f) (list id f)) (.ref profile 'factors)))
              (cons 'scope scopes)))
      (set! session ((.ref scene 'open-review) context)))
    (set! trajectory (hash-ref (ascent-trajectory (hash ("action" "open")
      ("task" name) ("sourceIdentity" cut))) "trajectory")))
  (def (register)
    (displayln "RESOURCE-REGISTER validating " (length records)) (force-output)
    (def snapshot (ascent-trajectory (hash ("action" "snapshot") ("trajectory" trajectory))))
    (def prior (hash-ref snapshot "events"))
    (for-each (lambda (r)
      (def id ((.ref m 'id) r))
      (unless (find (lambda (event) (equal? (hash-ref event "id") id)) prior)
        (ascent-trajectory (hash ("action" "append") ("trajectory" trajectory)
          ("event" (hash ("id" id) ("kind" "evidence")
            ("sourceIdentity" (hash-ref snapshot "sourceIdentity"))
            ("resultReference" ((.ref m 'reference) r))
            ("pathIdentity" ((.ref m 'claim) r)))))))) records)
    (def exchange ((.ref m 'register) session records trajectory rules))
    (def path (path-expand (string-append "exchange-" (number->string (length exchanges)) ".json") output))
    (save path (hash ("exchange" (exchange 'snapshot))
      ("views" (map (lambda (r) (exchange 'query ((.ref m 'claim) r))) records))
      ("trajectory" (ascent-trajectory (hash ("action" "snapshot") ("trajectory" trajectory))))))
    (set! exchanges (append exchanges (list (list path (digest path))))))
  (def (capture name supports counters witnesses)
    (def result (gerbil-ascent-session-run session))
    (require 'completed (.ref result 'finished))
    (def q (make-hash-table))
    (for-each (lambda (relation) (hash-put! q (symbol->string relation) (wire ((.ref result 'rows-of) relation))))
      '(application obligation requires scope support counter pending mismatch witness t_use))
    (require (list name 'support) (= (length (hash-ref q "support")) supports))
    (require (list name 'counter) (= (length (hash-ref q "counter")) counters))
    (require (list name 'witness) (= (length (hash-ref q "witness")) witnesses))
    (def path (path-expand (string-append name ".json") output)) (save path q)
    (set! queries (append queries (list (list path (digest path))))) result)
  (phase "discover-mechanism-Library")
  (begin-cut LifecycleProfile crate 'base "native-64")
  (capture "01-discovery" 0 0 0)
  (save (path-expand "catalog.json" output) (hash ("entry" (symbol->string (.ref entry 'identity)))
    ("rules" (wire (.ref entry 'rules))) ("dependencies" (wire (.ref entry 'dependencies)))))
  (phase "actual-QNT-TLC-and-Lean")
  (add (list ((.ref m 'quint) root LifecycleProfile quint (path-expand "qnt" output))
             ((.ref m 'lean) root LifecycleProfile lean (path-expand "lean64" output))))
  (register) (capture "02-formal-results" 2 0 2)
  (phase "actual-native-six-cases-and-independent-oracle")
  (def baseline-native ((.ref m 'native) root crate cargo rustc 64 (path-expand "native64" output)))
  (add baseline-native) (register)
  (def frozen (capture "03-native-results" 7 1 8))
  (phase "actual-source-change-invalidates-native-correspondence")
  (def revised (path-expand "revised-source" output)) (create-directory revised)
  (create-directory (path-expand "src" revised))
  (for-each (lambda (f) (write-text (path-expand f revised) (read-text (path-expand f crate))))
    '("Cargo.toml" "Cargo.lock" "src/main.rs"))
  (write-text (path-expand "src/main.rs" revised)
    (string-append (read-text (path-expand "src/main.rs" revised)) "\n// Source identity variant; ownership protocol unchanged.\n"))
  (begin-cut LifecycleProfile revised 'revised "source-revised") (register)
  (capture "04-source-old-native" 2 0 8)
  (add ((.ref m 'native) root revised cargo rustc 64 (path-expand "native-revised64" output)))
  (register) (capture "05-source-revalidated" 7 1 14)
  (phase "workload-change-reuses-model-rechecks-arithmetic-and-native")
  (begin-cut LargerPayloadProfile revised 'larger "larger-payload") (register)
  (capture "06-larger-before-checks" 1 0 14)
  (add (list ((.ref m 'lean) root LargerPayloadProfile lean (path-expand "lean128" output))))
  (add ((.ref m 'native) root revised cargo rustc 128 (path-expand "native-revised128" output)))
  (register) (capture "07-larger-revalidated" 7 1 21)
  (require 'frozen-retains-own-uses (= (length ((.ref frozen 'rows-of) 'support)) 7))
  (phase "reject-changed-lock-and-artifact-without-erasing-history")
  (def lock (path-expand "Cargo.lock" revised)) (def lock-text (read-text lock))
  (write-text lock (string-append lock-text "\n"))
  (require 'changed-lock-refused (rejects? (lambda () (register)))) (write-text lock lock-text)
  (def artifact (path-expand "native-revised128/input/src/main.rs" output)) (def original (read-text artifact))
  (write-text artifact (string-append original "\n// tamper\n"))
  (require 'changed-owned-source-refused (rejects? (lambda () (register)))) (write-text artifact original)
  (require 'JSON-is-not-issuer (rejects? (lambda () ((.ref m 'current!) (record (car baseline-native))))))
  (capture "08-rejections-preserve-history" 7 1 21)
  (phase "actual-QNT-counter-for-native-early-release-alternative")
  (begin-cut LargerPayloadProfile revised 'early "early-release" 'early-release)
  (add (list ((.ref m 'quint) root LargerPayloadProfile quint
    (path-expand "qnt-early-release" output) 'early-release)))
  (register) (capture "09-early-release-model-counter" 6 2 22)
  (.call deterministic-engineering.init.exports admit-current)
  (def report (hash ("schema" "rust.resource-investigation.v1") ("status" "passed")
    ("queries" queries) ("nativeExchanges" exchanges) ("results" (map record records))
    ("nativeCases" 6) ("nativeRuns" 3) ("nativePerformanceMeasured" #f)
    ("correspondence" "bounded cut-to-owner mapping reviewed; no whole-program refinement proof")
    ("sourceInputs" (map (lambda (p) (def full (path-expand p root)) (list full (digest full)))
      '("init.ss" "build.ss" "gerbil.pkg" "profiles/resource-lifecycle.ss" "examples/resource-lifecycle-evidence.ss"
        "library/concurrency/resource-control/backpressure-memory/abstract/objects.ss"
        "library/concurrency/resource-control/backpressure-memory/abstract/types.ss"
        "library/concurrency/resource-control/backpressure-memory/abstract/interface.ss"
        "library/concurrency/resource-control/backpressure-memory/abstract/config.ss"
        "library/concurrency/resource-control/backpressure-memory/tokio-rayon/types.ss"
        "library/concurrency/resource-control/backpressure-memory/tokio-rayon/objects.ss"
        "library/concurrency/resource-control/backpressure-memory/tokio-rayon/config.ss"
        "library/concurrency/resource-control/backpressure-memory/tokio-rayon/interface.ss"
        "library/drivers/rust-resources/interface.ss" "library/drivers/rust-resources/types.ss" "library/drivers/rust-resources/config.ss"
        "library/drivers/rust-resources/objects.ss" "library/drivers/rust-resources/func.ss"
        "library/drivers/rust-resources/methods.ss" "library/drivers/rust-resources/oracle.ss"
        "library/drivers/evidence/func.ss" "library/drivers/evidence/interface.ss"
        "library/drivers/evidence/types.ss" "library/drivers/evidence/config.ss" "library/drivers/evidence/objects.ss"
        "scenarios/resource-lifecycle/func.ss" "scenarios/resource-lifecycle/interface.ss"
        "scenarios/resource-lifecycle/types.ss" "scenarios/resource-lifecycle/objects.ss" "scenarios/resource-lifecycle/config.ss"
        "library/concurrency/resource-control/backpressure-memory/model.qnt" "library/concurrency/resource-control/backpressure-memory/budget.lean")))
    ("rejections" '("changed-lock" "changed-owned-source" "JSON-is-not-issuer"))))
  (save (path-expand "report.json" output) report)
  (displayln "RESOURCE-REAL-EVIDENCE-OK " (path-expand "report.json" output)))
