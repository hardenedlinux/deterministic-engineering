;;; -*- Gerbil -*-
;;; A replayable engineering investigation selected by the LLM-based AI agent.
;;; This is one example, not an Agent scheduler or a mandatory implementation plan.
(import :deterministic-engineering/init :deterministic-engineering/profiles/gateway
        :clan/poo/object :std/encoding/json
        (only-in :std/misc/ports read-all-as-string)
        :gerbil-ascent/program/session
        (only-in :gerbil-ascent/program/trajectory ascent-trajectory))
(export main run-gateway-investigation)
(def (read-text path) (call-with-input-file path read-all-as-string))
(def (write-text path value)
  (call-with-output-file (list path: path truncate: #t) (cut display value <>)))
(def (wire rows)
  (map (lambda (row) (map (lambda (value) (if (symbol? value) (symbol->string value) value)) row)) rows))
(def (require label value) (unless value (error "gateway investigation gold mismatch" label)))
(def (rejects? thunk) (with-catch (lambda (_) #t) (lambda () (thunk) #f)))
(def (run-gateway-investigation root output quint lean)
  (create-directory output)
  (init.build-spec '("init" "examples/gateway-evidence"))
  (init.build-current!)
  (def scene (.get init.Scenarios gateway-review scope))
  (def entry (.ref scene 'entry))
  (def methods (.ref scene 'methods))
  ;; Issuer-owned observations must use this SAME Scenario scope's operations.
  ;; A direct helper import can carry a distinct private type in a prepared source epoch.
  (def gateway-digest-file (.ref methods 'file-digest))
  (def gateway-digest-value (.ref methods 'value-digest))
  (def gateway-write-json (.ref methods 'write-json))
  (def gateway-result-record (.ref methods 'record))
  (def gateway-result-reference (.ref methods 'reference))
  (def gateway-result-claim (.ref methods 'claim))
  (def gateway-result-current! (.ref methods 'current!))
  (def application-source (path-expand "application-source.ss" output))
  (write-text application-source (read-text (path-expand "profiles/gateway.ss" root)))
  ;; Actual design inputs; no invented Cargo.lock, measurements or Rust source.
  (def baseline (.cc LocalProfile 'lock "unresolved/no-Rust-implementation"
    'runtime "declared/Tokio-Rayon-topology" 'workload "bounded-five-job-review"
    'inventory "declared/model-lifecycle-partition"))
  (def cap2 (.cc baseline 'identity 'C2 'capacity 4))
  (def cache (.cc cap2 'identity 'C2-cache 'cache-bytes 128
    'factors '(bounded-retention tokio rayon cache)))
  (def rules (path-expand "modules/resource-evidence/func.ss" root))
  (def queries '()) (def exchanges '()) (def records '()) (def events '())
  (def session #f) (def trajectory #f) (def scopes #f) (def current-profile #f)
  (def current-usage #f) (def frozen #f) (def late-proof #f)
  (def (phase name)
    (displayln "GATEWAY-PHASE " name) (force-output)
    (set! events (append events (list name))))
  (def (capture name)
    (def result (gerbil-ascent-session-run session))
    (require 'completed-query (.ref result 'finished))
    (def query (make-hash-table))
    (for-each (lambda (relation)
      (hash-put! query (symbol->string relation) (wire ((.ref result 'rows-of) relation))))
      '(application obligation requires scope support counter pending mismatch witness t_use))
    (hash-put! query "profile"
      (list->hash-table (map (lambda (key)
        (cons (symbol->string key) (let (v (.ref current-profile key))
          (if (symbol? v) (symbol->string v) v))))
        '(identity capacity queue item fixed cache-bytes budget runtime lock workload
          inventory tokio-workers rayon-workers cpu-budget))))
    (hash-put! query "phase" name)
    (def path (path-expand (string-append name ".json") output))
    (gateway-write-json path query)
    (set! queries (append queries (list (list path (gateway-digest-file path)))))
    query)
  (def (count query relation) (length (hash-ref query relation)))
  (def (begin-cut profile usage name source (mode 'normal))
    (set! current-profile profile) (set! current-usage usage)
    (set! scopes ((.ref methods 'scopes) root profile usage source mode))
    (def snapshot (gateway-digest-value (list name (wire scopes) (.ref entry 'revision))))
    (if session
      (gerbil-ascent-session-replace-sources! session
        (list (cons 'application (list (list usage snapshot (.ref entry 'identity))))
              (cons 'factor (map (lambda (f) (list usage f)) (.ref profile 'factors)))
              (cons 'scope scopes)))
      (set! session ((.ref scene 'open-review) profile usage snapshot source scopes)))
    (set! trajectory (hash-ref (ascent-trajectory
      (hash ("action" "open") ("task" name) ("sourceIdentity" snapshot))) "trajectory")))
  (def (register)
    (for-each (lambda (r)
      (def descriptor (gateway-result-record r))
      (def reference (gateway-result-reference r))
      (ascent-trajectory (hash ("action" "append") ("trajectory" trajectory)
        ("event" (hash ("id" (hash-ref descriptor "id")) ("kind" "evidence")
          ("sourceIdentity" (hash-ref (ascent-trajectory
            (hash ("action" "snapshot") ("trajectory" trajectory))) "sourceIdentity"))
          ("resultReference" reference) ("pathIdentity" (gateway-result-claim r))))))) records)
    (def exchange ((.ref methods 'register) session records trajectory rules))
    (def views
      (map (lambda (pair)
        (def key (car pair))
        (def basis (caddr (find (lambda (row) (eq? (cadr row) key)) scopes)))
        (exchange 'query (string-append (cadr pair) ":"
          (gateway-digest-value (list (list (symbol->string key) basis))))))
        '((model "BP-O02") (arithmetic "BP-O03"))))
    (def view-path (path-expand (string-append "exchange-" (number->string (length exchanges)) "-" (symbol->string current-usage) ".json") output))
    (gateway-write-json view-path
      (hash ("exchange" (exchange 'snapshot)) ("currentClaims" views)))
    (set! exchanges (append exchanges (list (list view-path (gateway-digest-file view-path)))))
    ;; Preserve the actual native trajectory and independently owned clue view.
    (gateway-write-json (path-expand (string-append "trajectory-" (number->string (length exchanges)) "-" (symbol->string current-usage) ".json") output)
      (ascent-trajectory (hash ("action" "snapshot") ("trajectory" trajectory))))
    exchange)
  (def (new-result result) (set! records (append records (list result))))
  (phase "discover-Library-and-derive-C1")
  (begin-cut baseline 'c1 "C1" application-source)
  (def discovery (capture "01-discovery"))
  (require 'eight-obligations (= (count discovery "obligation") 8))
  (require 'zero-invented-support (= (count discovery "support") 0))
  (require 'quint-obligation (member '("c1" "BP-O02" "quint") (hash-ref discovery "obligation")))
  (require 'lean-obligation (member '("c1" "BP-O03" "lean") (hash-ref discovery "obligation")))
  (gateway-write-json (path-expand "catalog-discovery.json" output)
    (hash ("entry" (symbol->string (.ref entry 'identity))) ("revision" (.ref entry 'revision))
          ("rules" (wire (.ref entry 'rules))) ("dependencies" (wire (.ref entry 'dependencies)))))
  (phase "run-real-QNT-TLC-and-Lean")
  (new-result ((.ref methods 'quint) root baseline quint (path-expand "c1-qnt" output)))
  (new-result ((.ref methods 'lean) root baseline lean (path-expand "c1-lean" output)))
  (register)
  (set! frozen (gerbil-ascent-session-run session))
  (def c1 (capture "02-C1-real-support"))
  (require 'two-real-methods (= (count c1 "support") 2))
  (require 'remaining-correspondence (= (count c1 "pending") 6))
  (phase "capacity-change-invalidates-old-applicability")
  (begin-cut cap2 'c2 "C2" application-source)
  (register)
  (def old (capture "03-C2-old-results"))
  (require 'old-results-not-C2-support (= (count old "support") 0))
  (require 'retain-two-old-observations (= (count old "witness") 2))
  (phase "check-new-capacity-inputs")
  (new-result ((.ref methods 'quint) root cap2 quint (path-expand "c2-qnt" output)))
  (new-result ((.ref methods 'lean) root cap2 lean (path-expand "c2-lean" output)))
  ;; A fresh native trajectory window records the enlarged evidence set.
  (begin-cut cap2 'c2 "C2-rechecked" application-source)
  (register)
  (def rechecked (capture "04-C2-rechecked"))
  (require 'C2-new-support (= (count rechecked "support") 2))
  (require 'C2-retained-history (= (count rechecked "witness") 4))
  (phase "enable-cache-reuse-model-and-check-budget-counter")
  (begin-cut cache 'cache "C2-cache" application-source)
  (register)
  (def cache-before (capture "05-cache-before-budget"))
  (require 'model-reuse-only (= (count cache-before "support") 1))
  (require 'cache-obligation (= (count cache-before "obligation") 9))
  (new-result ((.ref methods 'lean) root cache lean (path-expand "cache-lean-counter" output)))
  (begin-cut cache 'cache "C2-cache-checked" application-source)
  (register)
  (def cache-after (capture "06-cache-budget-counter"))
  (require 'real-budget-counter (= (count cache-after "counter") 1))
  (require 'conditional-model-still-supported (= (count cache-after "support") 1))
  (phase "source-change-reuses-conditional-results-with-new-T-use")
  (def changed-source (path-expand "application-source-v2.ss" output))
  (write-text changed-source (string-append (read-text application-source)
    "\n;; New source review generation; actual source correspondence remains unproved.\n"))
  (begin-cut baseline 'source2 "source-change" changed-source)
  (register)
  (def source2 (capture "07-source-reuse"))
  (require 'two-conditional-results-reused (= (count source2 "support") 2))
  (require 'source-mapping-pending (member '("source2" "BP-O04" "review") (hash-ref source2 "pending")))
  (require 'new-T-uses (andmap (lambda (row) (equal? (car row) "source2")) (hash-ref source2 "t_use")))
  (phase "check-real-early-release-counter-on-its-own-model-scope")
  (new-result ((.ref methods 'quint) root baseline quint (path-expand "qnt-early-release" output) 'early-release))
  (begin-cut baseline 'bug "early-release-proposal" application-source 'early-release)
  (register)
  (def bug (capture "08-real-model-counter"))
  (require 'real-QNT-counter (= (count bug "counter") 1))
  (require 'normal-model-not-bug-support (= (count bug "support") 1))
  (phase "late-real-old-model-result-is-retained-without-backflow")
  (set! late-proof ((.ref methods 'quint) root baseline quint (path-expand "late-C1-qnt" output)))
  (new-result late-proof)
  (begin-cut baseline 'bug "early-release-late-result" application-source 'early-release)
  (register)
  (def late (capture "09-late-real-result"))
  (require 'no-late-backflow (and (= (count late "counter") 1) (= (count late "support") 1)))
  (require 'all-real-observations-retained (= (count late "witness") 7))
  (require 'frozen-C1-replay (= (length ((.ref frozen 'rows-of) 'support)) 2))
  (phase "reject-tampered-artifact-and-plain-JSON-issuer")
  (def late-record (gateway-result-record late-proof))
  (def copy (path-expand "BackpressureOwners.qnt" (path-expand "late-C1-qnt" output)))
  (def original (read-text copy))
  (write-text copy (string-append original "\n// tampered after real method completion\n"))
  (require 'changed-artifact-refused
    (rejects? (lambda () ((.ref methods 'register) session records trajectory rules))))
  (write-text copy original)
  (require 'plain-JSON-cannot-attest (rejects? (lambda () (gateway-result-current! late-record))))
  ;; Compare with the current pre-rejection snapshot, not the intentionally older C1.
  (def after-rejection (capture "10-rejection-preserves-current"))
  (require 'exact-retained-observations (equal? (hash-ref after-rejection "witness") (hash-ref late "witness")))
  (require 'all-observations-preserved (= (count after-rejection "witness") 7))
  (require 'no-rejection-created-support (= (count after-rejection "support") 1))
  (init.build-current!)
  (def result
    (hash ("schema" "gateway.real-investigation.v1") ("status" "passed")
          ("actor" "LLM-based AI agent selected this investigation; replay is a host program")
          ("phases" events) ("queries" queries) ("nativeExchanges" exchanges)
          ("results" (map gateway-result-record records))
          ("sourceInputs" (map (lambda (relative)
            (def f (path-expand relative root)) (list f (gateway-digest-file f)))
            '("init.ss" "build.ss" "gerbil.pkg" "examples/gateway-evidence.ss"
              "library/concurrency/resource-control/backpressure-memory/abstract/objects.ss"
        "library/concurrency/resource-control/backpressure-memory/abstract/types.ss"
        "library/concurrency/resource-control/backpressure-memory/abstract/interface.ss"
        "library/concurrency/resource-control/backpressure-memory/abstract/config.ss"
              "profiles/gateway.ss" "library/concurrency/resource-control/backpressure-memory/rust/objects.ss"
              "library/concurrency/resource-control/backpressure-memory/rust/types.ss" "library/concurrency/resource-control/backpressure-memory/rust/interface.ss"
              "library/concurrency/resource-control/backpressure-memory/rust/config.ss" "modules/resource-evidence/func.ss"
              "modules/resource-evidence/types.ss" "modules/resource-evidence/interface.ss"
              "modules/resource-evidence/objects.ss" "modules/resource-evidence/config.ss"
              "scenarios/gateway-review/interface.ss" "scenarios/gateway-review/types.ss"
              "scenarios/gateway-review/objects.ss" "scenarios/gateway-review/config.ss"
              "scenarios/gateway-review/func.ss" "library/concurrency/resource-control/backpressure-memory/rust/methods.ss"
              "library/concurrency/resource-control/backpressure-memory/rust/oracle.ss" "library/concurrency/resource-control/backpressure-memory/model.qnt"
              "library/concurrency/resource-control/backpressure-memory/budget.lean")))
          ("rejections" '("changed-artifact" "plain-JSON-is-not-an-issuer"))
          ("methodEvidence" "real-Core-Ops-QNT-TLC-Lean-native-ASCENT")
          ("rustImplementationVerified" #f) ("nativePerformanceMeasured" #f)))
  (gateway-write-json (path-expand "report.json" output) result)
  (displayln "GATEWAY-REAL-EVIDENCE-OK " (path-expand "report.json" output)) (force-output)
  result)
(def (main out quint lean)
  (run-gateway-investigation (path-normalize (current-directory))
    (path-normalize out) quint lean))
