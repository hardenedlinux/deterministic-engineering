;;; -*- Gerbil -*-
(import :deterministic-engineering/init :deterministic-engineering/profiles/resource-lifecycle
        :clan/poo/object :std/encoding/json :gerbil-ascent/program/session
        (only-in :agentic-ai-lab/modules/temporal-causality/trajectory/ascent-ledger ascent-trajectory))
(export main)
(def (wire rows) (map (lambda (row) (map (lambda (v) (if (symbol? v) (symbol->string v) v)) row)) rows))
(def (need label ok) (unless ok (error "integration acceptance failed" label)))
(def (main output cargo rustc quint lean sysml)
  (def root (current-directory)) (set! output (path-expand output root))
  (when (file-exists? output) (error "fresh integration output required" output))
  (create-directory output)
  ((.get deterministic-engineering.init.exports std-make-spec) '("init" "profiles/resource-lifecycle" "examples/resource-integration-evidence"))
  (.call deterministic-engineering.init.exports admit-current)
  (def scene (.get (.get deterministic-engineering.init.exports Scenarios) resource-lifecycle scope))
  (def methods (.ref scene 'methods))
  (def entry (.ref scene 'integration-entry))
  (def crate (path-expand "languages-engineering/rust/concurrency/resource-control/backpressure-memory" root))
  (def context ((.ref methods 'native-context) root entry LifecycleProfile crate cargo rustc 'integration))
  (def extra ((.ref methods 'integration-scopes) context sysml quint))
  (def scopes (append (.ref context 'scopes) extra))
  (def digest (.ref methods 'value-digest)) (def save (.ref methods 'write-json))
  (def snapshot (digest (list (.ref context 'snapshot) scopes)))
  (def session ((.get (.get deterministic-engineering.init.exports Library) evidence scope open-review)
    entry LifecycleProfile 'integration snapshot scopes))
  (displayln "INTEGRATION-PHASE native") (force-output)
  (def native ((.ref methods 'native) root crate cargo rustc 64 (path-expand "native" output)))
  (displayln "INTEGRATION-PHASE quint-lean") (force-output)
  (def formal (list ((.ref methods 'quint) root LifecycleProfile quint (path-expand "quint" output))
    ((.ref methods 'lean) root LifecycleProfile lean (path-expand "lean" output))))
  (displayln "INTEGRATION-PHASE sysml-correspondence") (force-output)
  (def facets ((.ref methods 'integration) context native sysml quint (path-expand "facets" output)))
  (def results (append native formal facets))
  (need 'result-inventory (= (length results) 20))
  ((.ref methods 'context-current!) context)
  (need 'current-method-scope (equal? extra ((.ref methods 'integration-scopes) context sysml quint)))
  (def trajectory (hash-ref (ascent-trajectory (hash ("action" "open")
    ("task" "Backpressure six-case integrated evidence") ("sourceIdentity" snapshot))) "trajectory"))
  (for-each (lambda (r)
    (ascent-trajectory (hash ("action" "append") ("trajectory" trajectory)
      ("event" (hash ("id" ((.ref methods 'id) r)) ("kind" "evidence")
        ("sourceIdentity" snapshot) ("resultReference" ((.ref methods 'reference) r))
        ("pathIdentity" ((.ref methods 'claim) r))))))) results)
  (def rules (path-expand "library/drivers/evidence/func.ss" root))
  (def exchange ((.ref methods 'register) session results trajectory rules))
  (def (query)
    (def result (gerbil-ascent-session-run session))
    (need 'completed (.ref result 'finished))
    (def q (make-hash-table))
    (for-each (lambda (relation) (hash-put! q (symbol->string relation) (wire ((.ref result 'rows-of) relation))))
      '(obligation requires support counter pending mismatch witness t_use)) q)
  (def current (query))
  (need 'positive-method-facets (= (length (hash-ref current "support")) 17))
  (need 'preserved-negative-facets (= (length (hash-ref current "counter")) 3))
  (need 'native-history (= (length (hash-ref current "witness")) 20))
  (save (path-expand "current.json" output) current)
  (save (path-expand "exchange.json" output) (exchange 'snapshot))
  (def (standing id)
    (cond ((find (lambda (r) (equal? (cadr r) id)) (hash-ref current "counter")) "counter")
          ((find (lambda (r) (equal? (cadr r) id)) (hash-ref current "support")) "support")
          (else "pending")))
  (def diagram (string-append
    "direction: down\nlabel: \"Observed backpressure evidence\\nSnapshot " snapshot "\\nFinite cases; no native approval or universal refinement\"\n"
    "ascent: \"ASCENT\\n17 support / 3 counter\\nHistorical witnesses retained\"\n"
    "quint: \"BP-O02: " (standing "BP-O02") "\\nFinite ownership model\"\n"
    "lean: \"BP-O03: " (standing "BP-O03") "\\nConditional arithmetic\"\nquint -> ascent\nlean -> ascent\n"
    (apply string-append (map (lambda (link)
      (def ids (map symbol->string link))
      (def group (substring (car ids) 3 (string-length (car ids))))
      (string-append group ": {\n label: \"" (car ids) "\"\n"
        " native: \"" (car ids) ": " (standing (car ids)) "\"\n"
        " sysml: \"" (cadr ids) ": " (standing (cadr ids)) "\\nObserved cut assertions\"\n"
        " trace: \"" (caddr ids) ": " (standing (caddr ids)) "\\nBounded abstract path\"\n"
        " native -> sysml: observed cuts\n native -> trace: event mapping\n}\n"
        group ".native -> ascent\n" group ".sysml -> ascent\n" group ".trace -> ascent\n")) (.ref entry 'case-links)))))
  (call-with-output-file (path-expand "evidence.d2" output) (cut display diagram <>))
  ;; A changed mapping selection invalidates both new facets while preserving
  ;; native/formal evidence and all historical witnesses, including counters.
  (gerbil-ascent-session-replace-sources! session
    (list (cons 'scope (map (lambda (r) (if (eq? (cadr r) 'correspondence)
      (list (car r) (cadr r) "changed-mapping-control") r)) scopes))))
  (def changed (query))
  (need 'mapping-change-isolation (= (length (hash-ref changed "support")) 7))
  (need 'native-counter-retained (= (length (hash-ref changed "counter")) 1))
  (need 'history-retained (= (length (hash-ref changed "witness")) 20))
  (save (path-expand "mapping-changed.json" output) changed)
  (def report (hash ("schema" "backpressure.integrated-evidence.v1")
    ("status" "passed") ("snapshot" snapshot) ("scopes" (wire scopes))
    ("caseLinks" (wire (.ref entry 'case-links)))
    ("results" (map (.ref methods 'record) results))
    ("gerbilLoadpath" (getenv "GERBIL_LOADPATH" ""))
    ("current" current) ("mappingChanged" changed)
    ("completeRustRefinement" #f) ("nativeAuthorityIssued" #f)
    ("boundary" "One captured six-case workload; M02 uses declared queued-cancellation extension; no universal Rust refinement")))
  (save (path-expand "report.json" output) report)
  (displayln "RESOURCE-INTEGRATION-OK " (path-expand "report.json" output)))
