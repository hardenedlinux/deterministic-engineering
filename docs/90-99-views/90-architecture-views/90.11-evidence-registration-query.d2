# org-target: docs/10-19-design/10-architecture/10.06-poo-ascent-integration.org::#gateway-query-contract
# Discovery, content attestation and engineering admission are distinct.
direction: down
classes: {
  native: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  domain: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  boundary: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
publication: "Admitted Module exports\nDeclaration references + constructors\nRegistration is inert metadata" {class: domain}
host: "Host-bound input records\nChecked source/reference bytes\nContent attestations only" {class: native}
exchange: "Existing source-bound Clue projection\nScheme projection -> clue / factor / link\nAttested source label and digest" {class: native}
agent: "Caller-selected question / predicate\nNovel hypotheses and deeper reads\nNo mandatory navigator" {class: domain}
read: "Claim discovery and read\nSupport + counter + conditional\nA matched claim is not a witness filter" {class: native}
verification: "Independent method/result verification\nProducer, proposition, source mapping\nCompleteness and method policy" {class: boundary}
applicability: "Domain applicability + admission\nExact target and same-witness factors\nQ1-Q6 fixture checks in Org 20.04\nAll applicable opposing evidence" {class: boundary}
use: "Scoped current result\nCoherent cut before consumption/effect\nNo authority from a query" {class: boundary}
publication -> exchange: "explicit constructor demand"
host -> exchange: "source-content binding"
agent -> read: "explicit claim or selector"
exchange -> read: "existing native query rules"
host -> verification: "genuine artifact/result references"
read -> applicability: "candidate evidence view"
verification -> applicability: "separate checked premises"
applicability -> use: "required slots, scope and currentness hold"
read -> agent: "truthful expandable evidence" {style.stroke-dash: 4}
