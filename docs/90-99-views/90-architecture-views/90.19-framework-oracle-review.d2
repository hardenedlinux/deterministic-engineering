# org-target: docs/30-39-evaluation/30-benchmarks/30.04-oracle-review-data-contracts.org::#framework-owned-evaluation
# Framework-native ownership and independent review; not an Agent execution script.
direction: down
classes: {
  native: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  evidence: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  boundary: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
library: "Our engineering Library\nPOO objects, contracts, composition and extension\nCore Module / Profile / Scenario" {class: native}
methods: "Our established method owners\nSMP source / model / native discipline\nQNT properties and Lean / lean-poo laws" {class: native}
spec: "Domain-owned input / gold contracts\nOrg argument + D2 projection + JSON interchange\nTyped closures, stages, policies and cuts" {class: evidence}
input: "Frozen independent input specification\nExplicit present / absent / invalid / unknown\nOwn case revision and review provenance" {class: evidence}
candidate: "ASCENT candidate evidence view\nExisting DSL / Session / Clue\nOpen discovery and reasoning trajectories" {class: native}
gold: "Independent oracle gold route\nReviewed bodies / matrices / reference graphs\nO2 / O3 / O4 semantic oracles retained" {class: evidence}
compare: "Versioned comparison contract\nExact stage / subject / cut / polarity\nSetup defect and incomplete outcome retained" {class: boundary}
sdlc: "Lambda Aitia / Host consumption\nGenuine method evidence and actual scoped A\nSeparate authorization and fenced effects" {class: boundary}
research: "Optional external research: Specula / TLAPS-Bench\nQuestions and separately qualified imported assets\nNo production architecture, gold authority or native-case prerequisite" {class: boundary}
library -> spec: "domain obligations and consumer contracts"
methods -> spec: "declared semantic obligations and evidence boundaries"
spec -> input: "freeze exact case and review inputs"
input -> candidate: "candidate evaluates; not the gold producer"
input -> gold: "independent reviewed derivation"
candidate -> compare: "candidate output reference"
gold -> compare: "frozen expected judgments"
compare -> sdlc: "comparison is one prerequisite, not an issued receipt"
