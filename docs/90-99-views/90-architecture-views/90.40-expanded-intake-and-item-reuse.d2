# org-target: docs/20-29-cases/20-gateway/20.15-late-outcome-origin-and-expanded-intake-reuse.org::#expanded-intake-reuse-packet
direction: down
classes: {
  input: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  state: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  gate: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
old: "MR00 old exact item closure\nGenuine VOldInvalid / authorized DOld\nICounter = E+ and ELateCounter\nNo old aggregate all-clear assumed" {class: input}
new: "MR01 new counter / new capture\nIExpanded adds ENew\nRaw P0 family19 / total23 / one conflict\nNew method and review initially absent" {class: input}
scope: "MR02 / MR03 old item reuse check\nExact subject / issuer / method / policy / reason roots\nWhole-intake or no-other-counter reason: reassess\nUnknown reuse scope: pending, not automatic carry" {class: gate}
carry: "Actual policy allows counter-local carry\nAll reason dependencies unchanged\nFresh current use can retain old item closure\nOriginal DOld and intake are not rewritten" {class: state}
recheck: "MR04 / MR05 new item\nOld reason never substitutes for VNew / DNew\nInvalid + authorized review may close this item\nValid accepted counter remains a defeat\nIncomplete checker remains pending" {class: gate}
aggregate: "MR06 expanded full-domain review\nRecheck membership / negative coverage / item uses\nOld complete coverage stays true for old domain only\nPositive slots / argument / A / current authority separate" {class: gate}
paths: "Three independent change paths\nC-CAP: old P0 reason not Pcap proof\nC-CACHE: owner / permission / new members\nC-SOURCE: source-dependent applicability\nRetain history; invalidate affected uses and aggregates" {class: input}
old -> new -> scope -> carry -> recheck -> aggregate -> paths
scope -> recheck: "intake-bound reason requires actual reassessment"
