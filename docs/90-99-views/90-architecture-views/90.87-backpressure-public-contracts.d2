# org-target: docs/10-19-design/10-architecture/10.26-backpressure-public-contracts.org::#backpressure-public-contracts
# render-layout: elk; theme: 0; pad: 24; timeout: 30
direction: down
library: "Library publishes\nEngineering model, duties and case IDs\nExpected Profile Contract and method capabilities"
profile: "Independent Profile selects\nCapacity, payload, runtime and workload premises\nDerived values retain inherited requirements"
scenario: "Scenario binds one use\nRequires Library and Evidence publications\nOwns mandatory cases and allowed investigation"
native: "Existing native framework\nPOO inheritance and ObjectContract / Function Types\nCore requirements and contextual admission"
capture: "One admitted capture\nFinal validated Profile, occurrence and subject\nComplete selected inputs, mappings, tools and coverage"
methods: "Explicit method execution\nCore Ops and existing method observers\nRaw outcomes, budgets and issued results"
evidence: "Existing ASCENT / Aitia\nCurrent applicability, support, counter and pending\nReview authority stays separate from tool verdicts"
views: "D2 / Org views\nShared RL / SI / TM identities\nNo authority from rendering"
library -> scenario: publication
profile -> scenario: selected value
native -> scenario: reused contracts
scenario -> capture: capture once
capture -> methods: current bound use
capture -> evidence: same occurrence and closure
methods -> evidence: issued results
evidence -> views: query projection
