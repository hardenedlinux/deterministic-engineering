# org-target: docs/30-39-evaluation/30-benchmarks/30.03-gateway-variant-contracts.org::#variant-map
# Case node MBnn_H / MBnn_A maps to Org CUSTOM_ID mbnn-h / mbnn-a.
# Blue and amber identify control types, not executed pass/fail results.
grid-columns: 3
grid-gap: 24
classes: {
  healthy: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 8; font-size: 15}}
  adverse: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 8; font-size: 15}}
}
MB01: "Inventory and method coverage" {
  grid-columns: 2
  MB01_H: "MB01-H\nComplete inventory" {class: healthy}
  MB01_A: "MB01-A\nMissing method" {class: adverse}
}
MB02: "Permit ownership" {
  grid-columns: 2
  MB02_H: "MB02-H\nUnique owner" {class: healthy}
  MB02_A: "MB02-A\nRelease / queue / bytes / epoch" {class: adverse}
}
MB03: "Local and remote scope" {
  grid-columns: 2
  MB03_H: "MB03-H\nLocal guarantee" {class: healthy}
  MB03_A: "MB03-A\nRemote stop / replay leap" {class: adverse}
}
MB04: "Conditional progress" {
  grid-columns: 2
  MB04_H: "MB04-H\nFair-cycle check + witness" {class: healthy}
  MB04_A: "MB04-A\nOwner starved" {class: adverse}
}
MB05: "Authorization and cache" {
  grid-columns: 2
  MB05_H: "MB05-H\nCurrent context" {class: healthy}
  MB05_A: "MB05-A\nWrong / revoked right" {class: adverse}
}
MB06: "Proof and measurement reuse" {
  grid-columns: 2
  MB06_H: "MB06-H\nChecked theorem transfer" {class: healthy}
  MB06_A: "MB06-A\nMismatch / scope / grounding" {class: adverse}
}
MB07: "Evidence association" {
  grid-columns: 2
  MB07_H: "MB07-H\nSame witness + polarity" {class: healthy}
  MB07_A: "MB07-A\nSplit witnesses" {class: adverse}
}
MB08: "Current support" {
  grid-columns: 2
  MB08_H: "MB08-H\nBound verified reference" {class: healthy}
  MB08_A: "MB08-A\nStale packet / use race" {class: adverse}
}
MB09: "POO Module test scope" {
  grid-columns: 2
  MB09_H: "MB09-H\nPinned Graph + complete exit" {class: healthy}
  MB09_A: "MB09-A\nChanged helper" {class: adverse}
}
MB10: "Org / D2 / formal target" {
  grid-columns: 2
  MB10_H: "MB10-H\nSame interpretation" {class: healthy}
  MB10_A: "MB10-A\nUnits / target altered" {class: adverse}
}
MB11: "Authority and execution" {
  grid-columns: 2
  MB11_H: "MB11-H\nSeparate valid receipts" {class: healthy}
  MB11_A: "MB11-A\nRevoked / unknown / plan" {class: adverse}
}
MB12: "Extensible consumer contracts" {
  grid-columns: 2
  MB12_H: "MB12-H\nCompatible local scope" {class: healthy}
  MB12_A: "MB12-A\nUnsupported global claim" {class: adverse}
}
