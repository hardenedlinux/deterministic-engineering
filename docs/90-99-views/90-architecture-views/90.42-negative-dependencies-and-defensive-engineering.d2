# org-target: docs/20-29-cases/20-gateway/20.16-unknown-order-negative-dependencies-and-defensive-engineering.org::#negative-review-recheck-packet
direction: down
classes: {
  input: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  state: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  gate: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
old: "ND00 original complete frozen domain\nNo additional required counter at kOld\nDOld reason depends on that negative condition\nIndependent VOldInvalid has separate method scope" {class: input}
new: "ND01 known relevant required ENew\nCurrent no-additional-member condition false\nOld NegOld stays true in old frozen domain\nRaw23 / P0 family19 / one conflict" {class: input}
affected: "ND02 / ND03 scoped impact\nDirect current DOld carry fails changed reason guard\nReassess review / aggregate / negative coverage\nKeep history; check independent method guards\nNew item needs its own method and review" {class: gate}
review: "ND04 / ND05 / ND06 actual reassessment\nNew authorized supported reason may close old item\nRepeating false absence cannot qualify\nAccepted new counter keeps applicable defeat\nReview closure != positive slots / A / effect authority" {class: gate}
defense: "DE01 defensive-engineering case\nKeep established facts; name unresolved guards\nBlock affected use, not all Agent discovery\nDo not convert unknown into violation\nDo not purge independent reusable evidence\nExtra checks need a named obligation / owner" {class: state}
paths: "Resolve through existing evidence paths\nC-CAP: changed property applicability\nC-CACHE: owner / tenant / permission domain\nC-SOURCE: source / reason / method dependencies\nNo new harness, receipt class or runtime claimed" {class: input}
old -> new -> affected -> review -> defense -> paths
