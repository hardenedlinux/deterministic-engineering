# org-target: docs/10-19-design/10-architecture/10.11-live-capacity-full-cleanup-and-joint-budgets.org::#live-capacity-generation-packet
direction: down
classes: {
  input: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  state: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  gate: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
old: "LG00 old live model state\nq700 / w40 / a80 =820 retained old requests\nCurrent request allowance3600 MiB\nShared surrounding1568 -> point total5168\nNo native memory measurement supplied" {class: input}
select: "LG01 / LG02 select W-B2\nTarget512 / 32 / 64; cold plan4256\nNo physical drain or generation migration\nRequire old/new producer, holder and pool closure" {class: gate}
envelope: "LG03 / LG04 closed-cohort overlap candidate\nOld820 requests may promote4 ->8 MiB\nOld a<=256: old allowance4304 MiB\nNew request allowance2688 + surrounding1568\nTransition envelope8560 cannot certify8192 fit\nOversized upper bound not actual violation evidence" {class: gate}
drain: "LG05 actual drain-before-new companion\nLast-retention and old producer/future-input coverage\nResidual allocator / platform mapping still required\nOnly then cold target application may qualify\nUnknown old effect does not disappear" {class: input}
alternate: "LG06 / LG07 bounded alternative\nInterim new448 / 32 / 32 -> envelope8048 MiB\nActual phase limits / old closure / policy / source mapping\nGeneric arithmetic may reuse under exact premises\nOld finite/run artifacts remain original-scoped\nCurrent transition / progress / performance separate" {class: state}
old -> select -> envelope
envelope -> drain
envelope -> alternate
drain -> alternate
