  style.fill: "#ecfdf5"
  style.stroke: "#059669"

  datalog: "DurableGovernanceMetaAuditProgram (B1-B10)\n• 4-Hop B3 Revocation -> B8 TMS Poisoning\n• Multi-Hop B7 DIFC Exfiltration Closure\n• B9 Split-View & B10 Byzantine Double-Sign\n• Pure Relational 2f+1 Quorum & Cross-Log Fence\n• Catastrophic Split-World Finality Detection"
}

gate: "N-Version Fail-Closed Agreement Gate\n(Avizienis 1985 x Necula POPL 1997)" {
  style.fill: "#fef9c3"
  style.stroke: "#ca8a04"

  verdict: "Dual-Language Consensus\n• TS ADMIT + Scheme ADMIT -> Proven M1 Receipt\n• TS ADMIT + Scheme REFUSE -> oracle-disagreement-fail-closed\n• Missing Runtime -> PendingMethod (Never ok:true)"
}

pillars.b1_b5 -> pillars.b6_b8: "Attenuated & Approved"
pillars.b6_b8 -> pillars.b9_b10: "Log Entry & STH"
pillars -> m1_core: "M1 Cuts / R3 Guard Blocks 7 Key Types"
