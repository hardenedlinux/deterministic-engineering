pillars -> gate.verdict: "Imperative Verdict"
gate.verdict -> m1_core: "Pinned Dual-Oracle / Forensic Receipt" {
  style.stroke: "#059669"
}
gate.verdict -> pillars: "Disagreement -> Fail-Closed Block" {
  style.stroke: "#dc2626"
  style.stroke-dash: 4
}
