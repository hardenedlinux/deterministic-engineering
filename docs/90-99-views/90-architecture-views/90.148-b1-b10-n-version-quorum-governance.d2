direction: right

title: {
  label: "90.148 Full B1-B10 Stratified OP & N-Version Cross-Runtime Quorum Governance Architecture (10.170)"
  near: top-center
  shape: text
  style.font-size: 20
  style.bold: true
}

pillars: "Imperative TypeScript Governance Runtimes (B1-B10)" {
  style.fill: "#eef2ff"
  style.stroke: "#4f46e5"

  b1_b5: "Execution & Custody (B1-B5)\n• B1 SoD Release & Canary Rollback\n• B2 Multi-Tenant AEAD Replay (R5)\n• B3 Macaroon Attenuation & Cascade\n• B4 AST Symbol-Level SSI (TS + .ss)\n• B5 Cold HITL Pause/Resume & Veto"
  b6_b8: "Effects, Confidentiality & Memory (B6-B8)\n• B6 Compensable Sagas & Linear Budget\n• B7 DIFC Taint + CaMeL Control-Flow\n• B8 ATMS/TMS Causal Retraction & Quarantine"
  b9_b10: "Cryptographic Finality (B9-B10)\n• B9 RFC 6962 Log + Ed25519 STH\n• B10 2f+1/3f+1 Witness Quorum Finality\n• Offline Eclipse-Resistant QC Verifier"
}

m1_core: "Stratified Orthogonal Persistence Core (10.156)\nM1 Immutable Merkle DAG (Pinned Cuts & Receipts)\nM2 Recomputable Drift & Quarantine Manifests (R1/R4)\nM3 7 Non-Serializable Live Capability Classes (R3)" {
  style.fill: "#f8fafc"
  style.stroke: "#334155"
}

bridge: "M1 Proof-Carrying Projection Bridge\n(ascent-meta-audit-bridge.ts)" {
  style.fill: "#fff7ed"
  style.stroke: "#ea580c"

  proj: "Zero-Handcrafted S-Expr Projection\n• 20 Canonical Source Relations\n• Injection-Safe Escaped Scheme Alist\n• Content-Addressed Fact Bundle Hash"
}

