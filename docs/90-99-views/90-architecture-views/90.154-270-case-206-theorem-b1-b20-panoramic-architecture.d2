direction: right

title: {
  label: "270-Case B1-B20 Durable AI Governance & 19-Module / 206-Theorem Pure LeanPoo Landmark Architecture (10.199 / 90.154)"
  near: top-center
  shape: text
  style.font-size: 20
  style.bold: true
}

library: "Reusable Formal Library (deterministic-engineering-qnt — ZERO Mathlib, ZERO Cedar)" {
  style.fill: "#F4F8FB"
  style.stroke: "#2C5E8A"
  style.stroke-width: 2

  p1: "Paradigm 1: Quint / Apalache + F3 + MBT" {
    style.fill: "#E8F1FA"
    style.stroke: "#2C5E8A"
    q28: "28 Defense Models (B1-B19)\n(Apalache PLAN-OK + 100% F3 essential)\n28/28 MBT SUT State Isomorphism"
  }

  p2: "Paradigm 2: Gerbil Scheme ASCENT" {
    style.fill: "#E9F7EF"
    style.stroke: "#1E8449"
    ascent: "52 Sources x 28 Outputs (B1-B19)\nLive gxi Stratified Datalog Oracle\nN-Version Disagreement Fail-Closed"
  }

  p3: "Paradigm 3: CBMC & 5-Language Harnesses" {
    style.fill: "#FEF9E7"
    style.stroke: "#B7950B"
    langs: "C (CBMC 50/50) | C++20 | Rust | TS | Scheme\n270-Case Benchmark (AG01-AG270 / 48 Suites)\n17/17 R3 Non-Leakable M3 Capabilities"
  }

  p4: "Paradigm 4: Pure Lean 4 + LeanPoo (19 Modules / 206 Theorems!)" {
    style.fill: "#F5EEF8"
    style.stroke: "#7D3C98"
    m1_16: "Modules 1-16 (176 Theorems)\nB1-B17, R1-R5, Export, 4-Paradigm, Offline Cert, TEE, PQ Hybrid"
    m17: "Module 17: ZeroKnowledgeSelectiveDisclosure\n(B18: 10 Theorems — Schnorr Sigma + Anti-Over-Disclosure)"
    m18: "Module 18: GeoResidencyAndSovereignty\n(B19: 10 Theorems — GDPR Ch. V + LLM Residency Fence)"
    m19: "Module 19: FederatedOrgReciprocity\n(B20: 10 Theorems — Bilateral Reciprocity + Dispute Freeze)"
    m1_16 -> m17 -> m18 -> m19
  }

  gate: "Single-Shot 206-Theorem Fleet Gate\njust audit-leanpoo-fleet --json\n(28 Quint x 52x28 ASCENT x 206/206 Axioms)" {
    style.fill: "#D6EAF8"
    style.stroke: "#1B4F72"
    style.bold: true
  }

  p1 -> gate
  p2 -> gate
  p3 -> gate
  p4.m19 -> gate
}

custody: "Air-Gapped Sovereign & Multi-Org Federation Custody" {
  style.fill: "#FDEDEC"
  style.stroke: "#922B21"
  style.stroke-width: 2

  cert: "SignedLibraryReleaseCertificate\nPublisher Ed25519 + 3-of-4 Witness QC\n+ B17 PQ Hybrid + B18 ZK Compliance"
  fed: "B19 Sovereign Geo-Residency + B20 Multi-Org Reciprocity\nBilateral Org-A <-> Org-B Countersignatures\nRatified Treaty + Active Dispute-Freeze Preemption"
  cert -> fed: "Binds Verified Library -> Federated Execution"
}

host: "Consuming Authorization Host (cedar-poo-spec)" {
  style.fill: "#EAFAF1"
  style.stroke: "#145A32"
  style.stroke-width: 2

  dual: "Dual-Sovereign Release Gate\nLibrary Finality AND Host Policy Permit\n(Monotonic LeanPoo ObjectContract.refine)"
  policies: "CedarPooSpec.{Authorization,Governance,Admission,Data}\nStrict Library <-> Host Separation (0 Cedar in Library)"
  dual -> policies
}

library.gate -> custody.cert: "M1 Pinned 206-Theorem Digest"
custody.fed -> host.dual: "Verified Bilateral + Sovereign Receipts"
