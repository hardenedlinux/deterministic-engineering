}}}
consumer: "Downstream repositories\nSelected Library and render APIs"
project: "Project-owned declarations" {
  profile: "Profile\nSelects models, policies and methods"
  scenario: "Scenario\nBinds real project inputs"
  inputs: "Repository inputs\nSysML / Org / D2 / decisions"
}
library: "Engineering Library\nModels / obligations / policies\nScheme method bindings"
framework: "Upstream capabilities\nPOO / Yuanxu / Core contracts and Scope\nASCENT Programs / selected methods"
render: "Static Render Library\nD2 / HTML / SVG / PNG\nThemes and icon packs"
review: "Aitia integration\nTarget independent review boundary"
consumer -> library: adopts definitions
consumer -> render: uses static views
render -> project.inputs: reads model and Questions
project.profile -> library: selects definitions
project.scenario -> project.profile: binds selection
project.scenario -> project.inputs: captures actual inputs
library -> framework: uses public capabilities
review -> framework: requires qualified query context
