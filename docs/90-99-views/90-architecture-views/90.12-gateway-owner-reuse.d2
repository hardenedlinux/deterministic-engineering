# org-target: docs/10-19-design/10-architecture/10.06-poo-ascent-integration.org::#gateway-integration-changes
# Read hints, derivation reuse and engineering transfer have different authority.
direction: down
classes: {
  current: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  changed: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
  open: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
}
change: "Change classification\nProfile / declaration / source / policy\nOr display-only selector/checkpoint change" {class: changed}
read: "Read-hint reuse\nCurrent source + actual shown/content bindings\nLost hint -> safe replay" {class: open}
owner: "New source owner when required\nEffective Profile, declarations and references\nNot a watcher; history retained independently" {class: changed}
fragment: "Derivation fragment reuse\nComplete point / absence / aggregate footprint\nGrounded support stays applicable" {class: current}
transfer: "Engineering artifact transfer\nUniversal law + checked target application\nC1 admission is not C2 admission" {class: changed}
pending: "Changed concrete methods pending\nQNT instance, correspondence, workload\nOld measurement remains C1 / W0" {class: changed}
new: "New target admission\nC-CAP / C-CACHE / C-SOURCE checks\nComplete required slots + current cut\nAuthority/effect checked separately" {class: current}
history: "Existing durable history\nOriginal artifacts, failed attempts and effects\nSurvives Session close / owner replacement" {class: current}
change -> read: "display/relevance only; no support withdrawal"
change -> owner: "source/config/applicability changed"
owner -> fragment: "recheck supported dependencies"
owner -> transfer: "preserve candidate mathematical artifact"
owner -> pending: "withdraw affected concrete applications"
fragment -> new: "current scoped support only"
transfer -> new: "checked new application"
pending -> new: "genuine new checks or justified transfer"
new -> history: "append new scoped admission; keep prior records" {style.stroke-dash: 4}
read -> history: "no deletion or milestone reset" {style.stroke-dash: 4}
