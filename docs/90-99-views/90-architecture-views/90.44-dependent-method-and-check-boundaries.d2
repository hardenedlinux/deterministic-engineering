# org-target: docs/20-29-cases/20-gateway/20.17-sufficient-evidence-and-bounded-revalidation.org::#dependent-method-requalification-packet
direction: down
classes: {
  input: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  state: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  gate: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
old: "MV00 old VOldDep / DOld\nActual MDep requires no additional required counter\nComplete old input supports original precondition\nAuthentic old result and scope retained" {class: input}
changed: "MV01 / MV02 known relevant ENew\nCurrent mandatory method premise false\nCurrent method and review carry fail changed guard\nUnchanged artifact / binary not current applicability" {class: gate}
work: "MV03 bounded reassessment\nKeep stable artifact / trace / checker inputs\nOld-scope replay reproduces history only\nFalse-precondition reruns cannot qualify current V\nNo global evidence purge" {class: input}
alternative: "MV04 / MV05 actual permitted evidence route\nGenuine complete VFresh with accepted method mapping\nNew actual authorized review may close old item\nNo relabeling of old V; no positive Q proof\nUnadmitted / incomplete result remains unresolved" {class: gate}
remaining: "MV06 independent remaining obligations\nENew method / review / applicable defeats\nFull intake and negative coverage\nPositive slots / argument / A / current effect authority" {class: gate}
defense: "DE01 check boundaries\nStop extra search when scoped evidence is sufficient\nKeep authenticity / applicability / use-time checks\nNo universal preflight or mandatory receipt format\nAgent evidence paths remain open under actual policy" {class: state}
old -> changed -> work -> alternative -> remaining -> defense
