}}}
agent: "LLM-based AI agent\nEngineering reasoning\nQuestions, alternatives,\nnew hypotheses"
library: "POO design Library\nDomains, contracts,\nextensible knowledge"
ascent: "ASCENT\nEvidence Chain + DAG\n+ Trajectory"
view: "Progressive evidence view\nSupport, counterevidence, unknowns\nCurrent references and deeper reads"
experiments: "LLM-based AI agent investigation\nSource inspection, QNT,\nLean, experiments"
observations: "Bound observations\nPremises, source,\nresult, scope"
aitia: "Aitia / Host boundary\nScoped admission,\nauthorization, effects"
library -> ascent: "domain facts and associations"
agent -> ascent: "caller-selected questions and scope"
ascent -> view: "current truthful evidence"
view -> agent: "inform; do not rank or choose"
agent -> experiments: "choose, revise, or invent"
experiments -> observations: "record results and failures"
observations -> ascent: "checked support and changed premises"
ascent -> aitia: "references with explicit scope"
aitia -> observations: "actual execution / operational feedback"
agent -> library: "propose reviewed extensions" {style.stroke-dash: 4}
