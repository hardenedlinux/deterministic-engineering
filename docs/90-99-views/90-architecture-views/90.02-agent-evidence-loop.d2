    ],
    "evidenceRefs": []
  },
  "copy": {
    "status": "Formation authority is design-only. Consuming hosts own actual execution/evidence; this view grants no application authorization.",
    "description": "An LLM investigates. ASCENT exposes evidence. Aitia controls effects.",
    "agent-purpose": "Ask questions, compare alternatives,\nchoose or invent investigations.",
    "ascent-purpose": "Expose support, counterevidence\nand changed premises.",
    "aitia-purpose": "Keep admission, authorization\nand effects within explicit scope.",
    "agent-purpose-title": "Explore alternatives",
    "ascent-purpose-title": "Inspect the evidence",
    "aitia-purpose-title": "Keep effects authorized",
    "takeaway": "LLM judgment stays open. Evidence stays inspectable. Effects stay authorized."
  },
  "themes": [
    "sketchbook",
    "compact"
  ],
  "icons": [
    "engineering"
  ],
  "design": {
    "audience": "Engineering Library users",
    "medium": "README explanatory overview",
    "message": "The LLM chooses investigations; ASCENT exposes evidence; Aitia owns admission and authorization.",
