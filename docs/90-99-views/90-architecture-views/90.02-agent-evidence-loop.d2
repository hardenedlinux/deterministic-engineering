# Current authored view; arrows mean the relation explicitly written on each edge.
vars: {d2-config: {layout-engine: elk; pad: 24; data: {figure: |json
{
  "title": "Question-led engineering workflow and current capture boundary",
  "purpose": "workflow",
  "kind": "engineering-lifecycle",
  "language": "en",
  "width": 1120,
  "primary": "scope",
  "questions": [
    {
      "ref": "scope",
      "text": "How do confirmed ideas reach checked models and review without promoting candidates to evidence?",
      "focusRefs": [
        "source"
      ]
    }
  ],
  "references": {
    "source": "docs/90-99-views/90-architecture-views/90.02-agent-evidence-loop.d2"
  },
  "basis": {
    "captureRef": "design-candidate:current-readme",
    "modelRefs": [
      "project.sysml"
    ],
    "obligationRefs": [
      "docs/10-19-design/10-architecture/10.142-declarative-render-extensibility-audit.org"
    ],
    "evidenceRefs": []
  },
  "copy": {
    "status": "Design candidate \u00b7 current source associations retained \u00b7 no C/Q/R issued",
    "description": "Current preparation is blocked. Target integration requires a separately qualified capture."
  },
  "themes": [
    "sketchbook",
    "compact"
  ],
  "icons": [
    "engineering"
  ],
  "presentation": {
    "scenes": [
      {
        "heading": "preparation",
        "graph": {
          "id": "90.02-agent-evidence-loop-scene-1",
          "children": [
            {
              "id": "preparation.intent"
            },
            {
              "id": "preparation.selection"
            },
            {
              "id": "preparation.scenario"
            },
            {
              "id": "preparation.stop"
            }
          ],
          "layoutOptions": {
            "elk.algorithm": "layered",
            "elk.direction": "RIGHT",
            "elk.edgeRouting": "ORTHOGONAL",
            "elk.spacing.nodeNode": "40",
            "elk.layered.spacing.nodeNodeBetweenLayers": "52",
            "elk.layered.considerModelOrder.strategy": "NODES_AND_EDGES"
          }
        },
        "icons": {
          "preparation.intent": "question",
          "preparation.selection": "selection",
          "preparation.scenario": "capture",
          "preparation.stop": "pending"
        },
        "roles": {
          "preparation.stop": "pending"
        }
      },
      {
        "heading": "integration",
        "graph": {
          "id": "90.02-agent-evidence-loop-scene-2",
          "children": [
            {
              "id": "integration.capture"
            },
            {
              "id": "integration.methods"
            },
            {
              "id": "integration.inference"
            },
            {
              "id": "integration.review"
            }
          ],
          "layoutOptions": {
            "elk.algorithm": "layered",
            "elk.direction": "RIGHT",
            "elk.edgeRouting": "ORTHOGONAL",
            "elk.spacing.nodeNode": "40",
            "elk.layered.spacing.nodeNodeBetweenLayers": "52",
            "elk.layered.considerModelOrder.strategy": "NODES_AND_EDGES"
          }
        },
        "icons": {
          "integration.capture": "capture",
          "integration.methods": "obligation",
          "integration.inference": "model",
          "integration.review": "evidence"
        },
        "roles": {
          "integration.capture": "pending",
          "integration.methods": "pending",
          "integration.inference": "pending",
          "integration.review": "pending"
        }
      }
    ]
  }
}
|
}}}
preparation: Current preparation {
  intent: "Confirmed idea / Questions\nOriginal source and role scope"
  selection: "Library / Profile\nModels, policies and methods"
  scenario: "Scenario preparation\nActual inputs and observations"
  stop: "Current DE-CASE-01\ncapture-blocked / capture = #f"
  intent -> selection: select
  selection -> scenario: bind
  scenario -> stop: current return
}
integration: Target integration after qualified capture {
  capture: "Qualified C\nRequired integration gate"
  methods: "Selected methods\nBound results and findings"
  inference: "ASCENT query view\nSupport / counters / gaps"
  review: "Independent Aitia review\nPolicy / revision / roles"
  capture -> methods: same inputs
  methods -> inference: explicit facts
  inference -> review: context, not authority
}
preparation.scenario -> integration.capture: after qualification
