# org-target: docs/30-39-evaluation/30-benchmarks/30.04-oracle-review-data-contracts.org::#dc-mb-bindings
# Contract bindings are review obligations, not executed coverage or qualification.
direction: down
classes: {
  contract: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 16}}
  case: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 15}}
  boundary: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 16}}
}
dc: "DC01-DC16 data judgments\nCase-qualified stage, reference closure and cut\nIdentity / witness / V / review / A / impact / hints" {class: contract}
bind: "BenchmarkBinding: reviewed typed mapping\nNo copied B0 / A0 or blind raw-query aliases\nEach parent retains all mandatory subcontrols" {class: contract}
families: "Twenty-four native-framework variant contracts" {
  grid-columns: 3
  grid-gap: 20
  MB01: "MB01-H / MB01-A: Inventory\nDC01 / 03 / 09 / 16\nO1 exact sets + O6\nGAP01 / 09 / 12" {class: case}
  MB02: "MB02-H / MB02-A: Permit ownership\nDC02 / 05 / 06 / 07 / 08\nO2 state + O3 trace\nGAP02 / 03" {class: case}
  MB03: "MB03-H / MB03-A: Local / remote\nDC02 / 10 / 15\nO2 / O3 / O6 scope\nGAP03 / 04 / 10" {class: case}
  MB04: "MB04-H / MB04-A: Conditional progress\nDC07 / 08 / 09 / 10 / 16\nO3 / O4 fair cycles\nGAP03 / 08 / 12" {class: case}
  MB05: "MB05-H / MB05-A: Cache authorization\nDC03 / 05 / 12 / 13 / 15\nO1 / O3 / O6 policy\nGAP02 / 07 / 09" {class: case}
  MB06: "MB06-H / MB06-A: Proof / measurement\nDC02 / 09 / 10 / 13\nO1 / O5 / O6 transfer\nGAP02 / 10 / 12" {class: case}
  MB07: "MB07-H / MB07-A: Witness / counter / hints\nDC06 / 07 / 08 / 11 / 14\nO5 / O6 raw + review\nGAP01 / 06 / 09" {class: case}
  MB08: "MB08-H / MB08-A: Concurrent revision\nDC01 / 07 / 12 / 14\nO5 / O6 current use\nGAP06 / 11" {class: case}
  MB09: "MB09-H / MB09-A: Selected Module tests\nDC04 / 07 / 09 / 12 / 16\nO1 / O3 / O6 process\nGAP03 / 05 / 06" {class: case}
  MB10: "MB10-H / MB10-A: Semantic projections\nDC01 / 02 / 04 / 05 / 09 / 15\nO1 / O3 / O5 meaning\nGAP03 / 09 / 12" {class: case}
  MB11: "MB11-H / MB11-A: Authority / monitor / effect\nDC03 / 07 / 12 / 15 / 16\nO3 / O6 actual records\nGAP07 / 08 / 11" {class: case}
  MB12: "MB12-H / MB12-A: Composition / consumers\nDC01 / 02 / 03 / 09 / 10 / 13 / 15\nO1 / O2 / O5 / O6 scope\nGAP01 / 04 / 10 / 11" {class: case}
}
gaps: "GAP01-GAP12 remain qualification obligations\nContract precision is design closure only\nIndependent semantics, real producers and Host fences still required" {class: boundary}
limits: "Preserve all 24 parents and required subcases\nDC16 is a common guard, not a 25th score\nUnknown / setup defect / inconclusive is not a semantic counterexample" {class: boundary}
dc -> bind: "review shape; no automatic gold transfer"
bind -> families: "case-specific bodies and additional semantic oracles"
families -> gaps: "exact obligations and residual owners"
gaps -> limits: "no documentation-based pass or efficacy claim"
