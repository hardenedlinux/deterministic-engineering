  state: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  gate: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
sources: "Linked working sources\nCore / POO include local changes\nWorking-source hashes qualify dirty content" {class: input}
capture: "Direct original source links\nRepair existing Core reader in place\nAlign ASP / ASCENT dependency pins\nHistorical snapshot receipts remain in .data" {class: input}
poo: "Native POO package build\nSupported library scope\nOne shared object ABI" {class: state}
core: "Native Core package build\nModule projection + artifact issuance\nNative package identity owns SDK tools" {class: state}
asp: "Native ASP package build\nPackageSpec + std/make" {class: state}
crypto: "Host linker prerequisite\nApple ld before Nix wrapper in PATH\nInstalled crypto library search directory\nMatched system + crypto link probe\nBoth failed package logs retained" {class: input}
ascent: "Native ASCENT package build\nScheme library + ABI targets\nExisting compiler-output and source checks" {class: state}
project: "gerbil build\nNative root version manifest\nCore-selected project source units\nNested foreign SDK tools remain dependencies\nModules + Scenario plans + init" {class: state}
metadata: "Native manifest closure check\nVersions match registered Git sources\nPins match actual dependency heads\nOne root version for each dependency" {class: state}
imports: "Package namespace + compatibility checks\nTwo Modules + one gateway Scenario\nProfile inheritance + invalid input rejection\nASCENT literal oracle with 1 / 2 workers" {class: state}
local: "Ordinary local .ssi / .o1 artifacts\nNo external compiled namespace links\nNo ASCENT source fallback namespace\nBuild exits and logs retained" {class: state}
semantics: "Remaining domain qualification\nFinite Library rules and queries qualified\nReal result admission / Rust execution remain open\nWorking-source changes are not upstream releases" {class: gate}
