direction: down

domains: "34 Co-Located Scheme POO AST Units\npackages/quint-models/<domain>/<subdomain>/<model>/\n5 Engineering subdomains (12) + 5 Threat subdomains (22)\nEmergent invariants + guard-pruned countermodels"
profiles: "library/quint-profiles (Yuanxu Design 165)\nassurance.* (runtime) | bound.* (assembly)\ngovernance.* (Band-5 monotonic meet floor)"
config: "config.ss + init.ss (11 Yuanxu mounts)\nlanguages.quint profile: 'assurance.bounded-proof"
methods: "library/quint-methods (Pure)\nast.ss validator + guard pruning\nquint-module / quint-plan / quint-model-readme"
quintModels: "packages/quint-models (git subtree mirror)\nSelf-contained pure *.qnt (// @quint-* headers)\nAuto-projected README.org (zero JSON sidecars)"
quintModulesResolver: "packages/quint-modules-resolver\nPackage resolver, AST compose, run-plan, verify-deps\nPure zero-eval ITF predicate verifier"
quint: "@informalsystems/quint 0.33.0 + Apalache 0.62.1\nPeer dependency, unmodified"
development: "t/yanxu/<Mount>/<owner>/ + t/support/\nDynamic Yuanxu projection, 38 suites, differential compose"
consumer: "Consuming host (e.g. cedar-poo-spec)\nPins mirror SHA, supplies consts/overlays\nRuns verify-deps, run-plan --verify & --mbt ITF replay"
config -> profiles
domains -> methods
profiles -> methods
methods -> quintModels: "dynamic same-commit projection"
quintModels -> quintModulesResolver
quint -> quintModulesResolver
quintModulesResolver -> development
quintModulesResolver -> consumer
quintModels -> consumer
