direction: down

domains: "Domain Modules\nthreat-capabilities / authority-currentness\neffect-handoff / effect-containment / state-rollback\nCountermodel = weakened descendant"
profiles: "threat-model-profiles\nComposition, depth, seed, required counterexamples"
config: "config.ss\nlanguages.quint enable + settings"
methods: "quint-methods\nPure quint-module and quint-plan\nDispatch on prototype ancestry"
quintModels: "packages/quint-models\nthreat/ concurrency/\nX.qnt + plan.json + receipt.json"
quintModulesResolver: "packages/quint-modules-resolver\nPackage-aware resolver\nOfficial Quint stages unchanged"
quint: "@informalsystems/quint 0.33.0\nPeer dependency, unmodified"
development: "t/\nActual quint / Apalache, ITF checks"
consumer: "Consuming host\nSupplies parameters, executes plan.json\nVerifies receipt digests"
config -> profiles
domains -> methods
profiles -> methods
methods -> quintModels: "same-commit projection"
quintModels -> quintModulesResolver
quint -> quintModulesResolver
quintModulesResolver -> development
quintModulesResolver -> consumer
quintModels -> consumer
