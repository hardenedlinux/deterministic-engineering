# org-target: docs/10-19-design/10-architecture/10.122-declarative-library-models-and-functional-projection.org::#functional122-scope
# render-layout: elk; theme: 0; pad: 24
direction: down
title: "Declarative Library models and functional projection" {shape: text}
declarations: {
  direction: right
  model: "Parent Library -> Rust -> integration\nNative prototype / => refinement\nInherited policy uses effective capabilities"
  methods: "Published method requirements\nNamed operation / models / claims / assets\nIdentity, inputs and premises follow receiver"
  cases: "Named case and transition values\nObligations follow case name\nOne case inventory supplies native and SI/TM facts"
}
validation: "Existing contracts and checked method binding\nIndependent published expectations\nFalse signature / strength / incomplete input still refuse"
native: "Existing ASCENT Program / Session\nStrict policy derives new obligation + pending\nNo checked witness -> no support or permission"
projection: "Validated unique formation candidate\nSelected sorted rows -> pure part / edge / section fragments\nOne SysML string; acquisition and publication stay separate"
checks: "FD01-FD05 actual receiver, cache and mapping controls\nHeld base values remain unchanged\nDefault metadata / ordered facts / renderer compatibility probes"
boundary: "Existing Scenario / review / runtime owners\nCapture, currentness, receipts and actual use checks\n2 GiB / 180-second build; unchanged assertions\nNo new object system, DSL or workflow runner"
title -> declarations.model: {style.opacity: 0}
declarations.model -> validation
declarations.methods -> validation
declarations.cases -> validation
validation -> native
validation -> projection
native -> checks
projection -> checks
checks -> boundary
