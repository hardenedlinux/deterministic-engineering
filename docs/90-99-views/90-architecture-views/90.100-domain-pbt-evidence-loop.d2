# org-target: docs/10-19-design/10-architecture/10.118-domain-property-testing-and-evidence-trajectories.org::#pbt118-scope
# render-layout: elk; theme: 0; pad: 24
direction: down
title: "Domain PBT in existing owners / proposed design only" {shape: text}
library: "Domain Library / POO parent obligations\nProperties + premises + generator + shrinker + oracle"
selection: "Existing Module / Profile / Scenario\nSpecialize mapping; acquire actual subject and input cut"
generation: "Finite state-aware generation\nEnabled actions + separate expected-refusal branch\nRecord coverage, discards and concrete replay inputs"
mechanisms: {
  direction: right
  bp: "Backpressure\nReservation / holder ledger\nCancel caller != dispose CPU payload\nRetain overlapping retry charges"
  bc: "Broadcast\nSender / cursor / future generation\nRe-poll readiness != notification progress\nNo exact-one-wake assumption"
}
formal: "Quint / Lean correspondence\nExplicit event abstraction and finite domains\nConditional arithmetic / proof premises\nModel result != native implementation proof"
execution: "Existing native method execution\nSelected real source / Cargo.lock / features\nControlled schedule where supported\nFixed selected resource policy; retain raw events"
oracle: "Independent oracle\nSimple ledger or legal public histories\nComplete events + negative controls\nInstrumented scope stays explicit"
classification: "Separate execution status / semantic verdict\nBounded support | reproducible refutation | undetermined\nTimeout alone is not a safety counter\nClosed failing prefix and cleanup verdict stay separate"
shrink: "Domain-preserving shrinking + independent replay\nPreserve object lifetimes, ordering and failure predicate\nPB-B / PB-C packet gold: paired view90.102\nKeep original witness and reduction lineage"
admission: "Existing issuer / Evidence admission\nBind property, method, subject, capture and closure\nNo saved JSON or LLM self-attestation"
ascent: "Existing ASCENT Program / Session\nFinite obligation / support / counter / pending joins\nDependency change -> stale current use, retain history\nNative pending is not counter-free readiness"
agent: "LLM-based AI agent\nDiscover knowledge; choose method; diagnose failure\nRevise design / code; independently review oracle changes"
review: "Existing Aitia SDLC review\nOld failure identity + disposition + broader regression\nSupport does not erase counter or pending"
reuse: "Fresh target checked-use\nReuse definitions / conditional proofs / concrete corpus\nAffected source, oracle or scheduler needs revalidation"
title -> library: {style.opacity: 0}
library -> selection -> generation -> mechanisms
selection -> formal: "Require correspondence"
mechanisms.bp -> execution
mechanisms.bc -> execution
formal -> oracle: "Mapped premises and obligations"
execution -> oracle -> classification
classification -> shrink: "Refutation; original stays preserved"
classification -> admission: "Completed supported result or incomplete status"
shrink -> admission: "Actual replay and original/reduced references"
admission -> ascent -> agent -> review -> reuse
next: "Next invocation of the same selection boundary\nRevised source or new target -> fresh capture / applicability\nNo old snapshot or receipt authority transport"
agent -> next: "Design revision" {style.stroke-dash: 4}
reuse -> next: "New target" {style.stroke-dash: 4}
