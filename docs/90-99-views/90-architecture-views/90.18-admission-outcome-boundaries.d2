# org-target: docs/20-29-cases/20-gateway/20.05-expanded-admission-controls.org::#outcome-algebra
# Illustrative conclusion dependencies, not a mandatory Agent action sequence.
direction: down
classes: {
  data: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  pending: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
  record: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
}
input: "Frozen typed input and actual cut\nIndependent gold fixed before evaluation" {class: data}
checks: "Checked stages and exact subjects\nIdentity / binding / method / review / use" {class: data}
reject: "Known malformed or incompatible attempt\nRJ01-RJ12 at its checked stage\nNo fabricated downstream diagnosis" {class: pending}
pending: "Unknown or missing required premise\nIdentity / binding / method / scope\nUnknown is not mismatch" {class: pending}
conflict: "Opposing evidence or unresolved review\nComplete intake independent of selector\nBoth provenance paths retained" {class: pending}
eligible: "Complete current eligibility\nSlots check required propositions\nChecked argument supports owner claim" {class: record}
a: "Externally supplied authentic A\nExact owner / obligation / references / cut\nNo automatic issuance or effect authority" {class: record}
change: "Relevant before / after dependency cut\nSource / policy / negative scope / grounding" {class: data}
withdraw: "Withdraw affected present use\nUnknown footprint: conservative withdrawal\nAttempted known stale use: RJ10" {class: pending}
history: "Immutable evidence and as-of history\nRetain original T / V / A meaning\nRe-evaluate or check transfer for reuse" {class: record}
limit: "Instance resource budget exhausted\nINCONCLUSIVE; no semantic-counterexample credit\nIncomplete rows are not complete absence" {class: pending}
input -> checks
checks -> reject: "known defect"
checks -> pending: "required premise unavailable"
checks -> conflict: "opposing review blocks clean scope"
checks -> eligible: "all declared prerequisites established"
eligible -> a: "validate actual A; eligibility creates none"
a -> change: "recheck relevant inputs before present use"
change -> withdraw: "affected dependency or lost grounded base"
withdraw -> history: "retain records; change applicability"
input -> limit: "otherwise valid but evaluation cannot complete"
