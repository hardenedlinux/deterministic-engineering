# org-target: docs/10-19-design/10-architecture/10.19-standard-identities-and-aitia-review-traceability.org::#history-counter-policy-packets
# render-layout: elk; theme: 0; pad: 24; timeout: 30
direction: down
classes: {
  owner: {style.fill: "#E6F5F3"; style.stroke: "#19756C"; style.border-radius: 10}
  design: {style.fill: "#EAF2FF"; style.stroke: "#315B8A"; style.border-radius: 10}
  boundary: {style.fill: "#FFF2DD"; style.stroke: "#9B6C25"; style.border-radius: 10}
}
input: "DESIGN / bounded existing review artifacts\nWork product + predecessor closure + evidence owners + intake cut\nIndependent expected inventory / original obligations and policy\nSame existing Aitia Profile, native requests and focused requirements" {class: design}
history: "A05-6.2 / history completeness\nCompare original identities AND captured contents\nEmpty, partial or substituted list is insufficient\nUnavailable coverage / exact archive routes: see 90.72\nTrack open actions; retain original failures after closure" {class: design}
counter: "A06-6.7 / expanded intake\nRaw challenge -> independent relevance / method review\nValidated coverage defect reopens completion\nReuse old covered-case results and stable proofs\nRecheck affected checklist, actions and review inventory" {class: design}
change: "A08-8.5 / controlled boundaries\nRevision label does not resolve an issue\nReduced policy is not full-work approval\nDifferent scope cannot use native rebase\nLimited work retains original actions/owners: see 90.72" {class: design}
bundle: "DESIGN / existing criterion-content boundary\nCaptured inventory difference + action / coverage matrix\nEight paragraph locators / T-V lineage / new A and requests\nTrusted operation compares expected policy, history and scope\nMissing completion judgment -> no matching p3 receipt" {class: design}
native: "EXISTING Aitia gate / explicit now\nCurrent submitted fail blocks selected requirement\nP8 without content receipts remains unverified\nOriginal historical records keep original revision\nNo automatic scan of external histories" {class: owner}
limits: "NATIVE LIMITS / required Scenario discipline\nOld receipts can still admit the old input after external intake\nGate can admit a supplied reduced policy subset\nExplicit revoke / check / actual-use ordering: see 90.72\nDo not present those results as expanded or full-work approval" {class: boundary}
output: "DESIGN GOLD / not executed\nHistory difference + action status + U / RF + exact gate scope\nOld frozen results preserved; new intake gets a new review\nNo new implementation, collector or policy framework\nConcurrency, authority and use-time enforcement remain unqualified" {class: boundary}
input -> history
input -> counter
input -> change
history -> bundle
counter -> bundle
change -> bundle
bundle -> native -> limits -> output
