# org-target: docs/20-29-cases/20-gateway/20.18-policy-required-checks-and-evidence-admission.org::#policy-rule-trajectory
direction: down
classes: {
  input: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  state: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  gate: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
agent: "Agent engineering investigation\nPropose hypotheses / factors / rules / evidence paths\nChoose alternative plans and implementation options\nConfidence does not authenticate a premise" {class: input}
inputs: "Existing Module / Profile / Scenario + Evidence DSL\nActual subject / source / policy / authority / methods\nKeep hypotheses separate from attested observations\nFixed independent gold and required-domain closure" {class: input}
infer: "ASCENT Scheme / Datalog reasoning\nNative support / counter / conditional / conflict\nDomain rule contracts derive scoped obligations\nCheck policy requirements / method applicability\nDomain lowering not implemented here" {class: state}
queries: "Concrete policy packet queries\nOP: ownership true, required order unknown\nBR: history retained, required record absent\nAM: real method result, mapping unknown or forbidden\nPending use and refused offer are separate" {class: gate}
feedback: "Reasoning feedback to Agent\nWhich premise supports this candidate?\nWhich actual rule/policy requires missing evidence?\nWhat counter or changed dependency affects this use?\nDefault explanation is not automatic per-row proof" {class: input}
actual: "Actual later tool / checker / reviewer evidence\nNew captured inputs and exact reference closure\nRe-evaluate affected current associations\nRetain frozen input / gold / historical evidence" {class: state}
agent -> inputs -> infer -> queries -> feedback
feedback -> agent: "open investigation, not a compulsory action order"
agent -> actual: "actual work / genuine external outcomes"
actual -> infer: "new scoped facts; no old-snapshot backfill"
