# org-target: docs/20-29-cases/20-gateway/20.14-partial-delivery-consumption-authority-and-blocker-closure.org::#partial-relation-packet
direction: down
classes: {
  input: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  state: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  gate: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
request: "BP00 exact B2 / sigma2\nInherited expand L0; four retained items\nR2 = matched / unknown_binding / conjunction_gap\nOld R1 stays historical" {class: input}
native: "BP01 actual native P2\nAll three short bodies shown\nNative checkpoint acknowledges R1 + R2 = 6\nNo external completion established" {class: state}
partial: "BP02 / BP04 / BP05 actual consumer contract\nOnly genuine complete units become owned\nr2m only -> r2m + r2u -> all R2\nWhole-payload contract cannot imply arbitrary subset" {class: gate}
reuse: "BP06 exact historical ownership / fresh use\nNew consumer or sigma requires exact binding\nLate completion stays with original P2\nNo Pcap proof or operational permission" {class: input}
auth: "UA00 / UA01 separate law-use packet\nExact auth-1 / reviewer-1 / RL / tenant-A / Xsrc\nallow40 lookup -> deny41 -> dispatch\nActual consumption and effect initially unknown" {class: input}
boundary: "UA02 actual authority / Host boundary\nCheck subject, incarnation, version, order, coverage\nKnown stale allowed-use claim: RJ10\nLocal checks do not prove remote no-effect" {class: gate}
outcomes: "Independent actual outcome companions\nUA03 refusal: only covered nonexecution\nUA04 unauthorized completion: retain violation\nUA05 earlier permitted completion: historical\nUA06 allow42: fresh use, old effect still unresolved" {class: state}
request -> native -> partial -> reuse
auth -> boundary -> outcomes
reuse -> boundary: "delivery ownership is not permission"
