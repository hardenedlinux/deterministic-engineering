# org-target: docs/10-19-design/10-architecture/10.11-live-capacity-full-cleanup-and-joint-budgets.org::#joint-budget-reuse-packet
direction: down
classes: {
  input: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  state: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  gate: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
local: "JB00 actual-to-be-supplied local contracts\nCleanup scope <=32 / retry scope <=32\nSelected auxiliary32; process plan1904\nLocal artifacts retained in exact original scopes" {class: input}
gap: "JB01 / JB02 joint32 not established\nIsolated-to-joint certificate rebinding refused\nActual union / compatibility unknown: aggregate pending\nNo inferred actual budget violation" {class: gate}
conservative: "JB03 conservative evidence route\nBoth local bounds concurrently applicable\nSame metric / actual complete holder union\n32 +32 =64 safe upper candidate even with overlap\nNo mandatory exact dedup to justify64" {class: input}
tighter: "JB05 tighter evidence route\nActual shared late/metadata mapping\nCleanup16 + retry16 + late8 + remaining8 =48\nNo subtraction from common label alone\nExtra overlap evidence needed for this route" {class: input}
policy: "JB04 / JB07 actual selected application\nPermitted aux64 -> process plan1936\nPermitted aux48 -> process plan1920\nNeither silently changes required aux32\nSource / union / policy / argument guards retained" {class: gate}
lower: "JB06 actual lower-bound companion\nApplicable reachable simultaneous bytes >32\nMay refute selected aux32 in that model\nUpper64 or48 alone supplies no violation witness\nNative process/effect claims still separate" {class: state}
local -> gap
gap -> conservative
gap -> tighter
conservative -> policy
tighter -> policy
gap -> lower: "independent counter companion"
