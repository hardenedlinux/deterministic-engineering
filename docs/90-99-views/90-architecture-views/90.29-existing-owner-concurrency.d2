# org-target: docs/20-29-cases/20-gateway/20.10-existing-owner-concurrency-and-delivery.org::#existing-owner-allocation
# Existing owners and proposed gateway data associations; no new runtime component.
direction: down
classes: {
  input: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  owner: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  gate: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
selection: "Linked Core init.ss\nOne selection epoch / two windows\nMount paths preserve publication identity\nSelection does not execute work" {class: input}
profile: "gateway-domain\nPure Profile / effective receiver Contracts\nC-CAP / C-CACHE / C-SOURCE\nNo mutable exchange in prototype defaults" {class: input}
evidence: "gateway-evidence\nEvidence DSL / typed source-output bindings\nExisting I / gold / cut / closure associations\nConstructor exposure is not a result" {class: input}
review: "Existing gateway-review occurrence\nExplicit selected Profile / source / request\nCapture demanded values and relevant roots\nNo aliasing solely by N_L" {class: owner}
capture: "C01-C03 / C07 capture consistency\nComplete no-ABA versions or coherent snapshot\nMixed / unknown capture stays unqualified\nNo new transaction or lock service asserted" {class: gate}
raw: "Existing Host-bound exchange owner\nIndependent eCap / eCache / eSrc\nRust N_L / read contract / facts / Session\nOr explicitly separate Scheme closure / context" {class: owner}
producer: "Existing resource / workload occurrence\nExplicit producer invocation at captured input\nCandidate artifact + genuine completion status\nNo method V / A from completion alone" {class: owner}
intake: "Existing result intake / review owner\nOriginal request / capture + actual intake order\nIndependent gold and fresh checked usage\nRetain late results and frozen earlier bodies" {class: owner}
consumer: "Existing consumer / Host owner\nAuthentic external delivery and current access\nCurrent-use / effect qualification separate\nNo authority from native shown checkpoint" {class: gate}
selection -> profile: "select publication"
selection -> evidence: "select publication"
profile -> review: "explicit occurrence binding"
evidence -> review: "typed constructor / query inputs"
review -> capture: "before dependent cut / request"
capture -> raw: "actual coherent raw inputs"
capture -> producer: "actual captured task inputs"
raw -> intake: "query output about its own input"
producer -> intake: "candidate about its own input"
intake -> consumer: "checked application; separate delivery"
