# org-target: docs/20-29-cases/20-gateway/20.13-binding-confirmation-use-race-and-counter-disposition.org::#binding-confirmation-full-packet
# Existing record/owner review; no new receipt API or remote fencing implementation.
grid-columns: 2
grid-gap: 32
classes: {
  input: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  state: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  gate: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
bindings: "BC: new binding confirmations" {
  direction: down
  input: "BC00 / BC01 actual B2 replaces B1\nSame Bsel / Nsel / RCsel\nInherited expand=[L0]; no Pcap question\nNew sigma2; raw current scope L0" {class: input}
  units: "BC02 exact new R2 units\nmatched empty / unknown cap=2 / gap\nAll 3 pending; old R1 retained as history\nCurrent 4 L0 items unchanged" {class: state}
  native: "BC03 checked short-body rendering\nAll 3 R2 bodies inline on complete output\nNative acknowledgement R1 union R2 = 6\nNo external completion from native shown" {class: state}
  own: "BC04 actual owned completion\nNo receipt: none newly confirmed\nUnit-scoped receipt: exact proven subset\nWhole genuine completion: all R2\nNo assumed transport fragment capability" {class: gate}
  scope: "BC05 / BC06 old tuple is not new tuple\nKnown false completion RJ11\nUnknown ownership / access pending\nNo opposing-intake or Pcap proof from R2" {class: gate}
  input -> units: "actual new selector identity"
  units -> native: "independent encoding-size inequalities"
  native -> own: "native output is not transport outcome"
  own -> scope: "exact consumer / payload / scope"
}
use: "UC: check versus actual consumption" {
  direction: down
  check: "UC00 / UC01 old L0 use and allow40\nExact consumer / action / resource / incarnation\nPre-use lookup retained at its version\nNo future authority granted" {class: input}
  update: "UC02 / UC03 deny41 after lookup\nDispatch may be attempted\nActual outcome / authority boundary unknown\nNo permission or no-effect from local check" {class: gate}
  boundary: "UC04 genuine authority / Host facts\nKnown deny at use: stale RJ10\nScoped enforced refusal: retain receipt\nReal denied completion: record violation\nUnknown boundary: pending" {class: gate}
  fresh: "UC05 new allow42 and fresh binding\nActual current boundary evidence required\nNot a replayed old receipt or fresh name\nLaw bytes reusable only if applicable" {class: state}
  history: "UC06 retain real old effects / failures\nCompletion occurrence != authorization\nReview rejection cannot undo real action\nNo automatic compensation or exactly-once claim" {class: gate}
  check -> update: "independent authoritative order"
  update -> boundary: "actual subject / point / outcome coverage"
  boundary -> history: "record actual reached outcome"
  update -> fresh: "independent reauthorization fork"
  fresh -> history: "new input never rewrites old evidence"
}
