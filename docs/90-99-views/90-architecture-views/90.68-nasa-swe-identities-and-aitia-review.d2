# org-target: docs/10-19-design/10-architecture/10.19-standard-identities-and-aitia-review-traceability.org::#standards-and-local-numbering
# render-layout: elk; theme: 0; pad: 24; timeout: 30
direction: down
classes: {
  context: {style.fill: "#EAF2FF"; style.stroke: "#315B8A"; style.border-radius: 10}
  design: {style.fill: "#FFF2DD"; style.stroke: "#9B6C25"; style.border-radius: 10}
  existing: {style.fill: "#E6F5F3"; style.stroke: "#19756C"; style.border-radius: 10}
}
status: "DESIGN MAPPING / EXISTING SOURCES INSPECTED\nReuse Aitia standards and SDLC owners\nExisting owner tests qualified; packet gold remains design\nNo installed adapter or compliance decision" {class: design}
standard: "NASA source requirement identity\nNPR 7150.2D / selected edition and locked source\nSWE-061, SWE-080/081, SWE-088 etc.\nParagraph criteria resolved by existing Catalog" {class: context}
local: "Local identity and navigation\nJohnny.Decimal 10.18 / 10.19: document locations\nAR05 / AR06 / AR08: local scenarios\nALG-INV etc.: proposed local obligations\nNone is a replacement SWE identifier" {class: context}
owner: "EXISTING Aitia NASA Profile / Standards provider\nSource lock / criterion Catalog / applicability and tailoring\nProject context and source digest must remain explicit" {class: existing}
poo: "PROPOSED project / Library composition\nPreserve applicable parent requirements\nSelect local coding / explanation criteria and domain methods\nMany-to-many SWE <-> local obligation <-> case mapping" {class: design}
validation: "Future actual method and independent review\nComplete artifact inputs and method coverage\nCriterion contribution uses existing Aitia request boundary\nNo plain JSON or confident prose creates checked evidence" {class: design}
ascent: "EXISTING ASCENT relations and native exchange\nSupport / counter / pending / t_use preserve scoped evidence\nKeep both polarities, original cut and complete method references" {class: existing}
aitia: "EXISTING Aitia assessment / lifecycle / authority owners\nIf applicable: current failure precedes all-criteria-present\nUnknown context remains unknown; source revision mismatch is not current evidence\nLocal support does not authorize release or certify compliance" {class: existing}
status -> standard -> owner -> poo
local -> poo
poo -> validation -> ascent -> aitia
