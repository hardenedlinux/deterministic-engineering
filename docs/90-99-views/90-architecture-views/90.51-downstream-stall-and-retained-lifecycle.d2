# org-target: docs/10-19-design/10-architecture/10.10-backpressure-capacity-stall-and-retry-trajectories.org::#downstream-stall-packet
direction: down
classes: {
  input: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  state: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  gate: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
start: "DS00 / DS01 W-D independent W-A reset\nPlan1904 under original bounds\nr1 waiting -> queued -> active\nModeled active retained state256 KiB" {class: input}
stall: "DS02 / DS03 downstream stall10s / deadline2s\nClient response may complete first\nTask / buffer / callback can remain retained\nActive charge and retention permit stay held" {class: gate}
cancel: "DS04 cancellation signal\nNot actual quiescence or remote no-effect\nPremature charge release creates omitted holder\nRetry permission and old effect remain independent" {class: gate}
release: "DS05 actual last-retention evidence\nRelease only covered original resources\nUnknown remote outcome may remain\nLate reply belongs to original op1 / a1" {class: state}
handoff: "DS06 bounded cleanup companion\nh <=64 at256 KiB ->16 MiB\nOther auxiliary16 -> total32\nNo accounting gap or hidden65th holder\nNew handoff/source/model evidence required" {class: input}
current: "DS07 current claims\nChanged cleanup -> holders / model / source mapping\nMemory / progress / fault / argument uses rechecked\nMemory bound need not imply progress\nNo unconditional drain under permanent stall" {class: gate}
start -> stall -> cancel
cancel -> release
cancel -> handoff
release -> current
handoff -> current
