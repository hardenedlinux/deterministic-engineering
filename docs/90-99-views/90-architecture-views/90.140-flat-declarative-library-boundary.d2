{
  "title": "Declarative Library: ownership and selection",
  "purpose": "architecture",
  "kind": "library-architecture",
  "language": "en",
  "width": 1400,
  "primary": "ownership",
  "questions": [
    {
      "ref": "ownership",
      "text": "Which responsibilities belong to the Library, its development tools and consuming ecosystems?",
      "focusRefs": [
        "authority",
        "declaration"
      ],
      "subjectRefs": [
        "selection",
        "plans",
        "external"
      ]
    }
  ],
  "references": {
    "authority": "docs/10-19-design/10-architecture/10.148-flat-declarative-library-boundary.org",
    "declaration": "docs/90-99-views/90-architecture-views/90.140-flat-declarative-library-boundary.d2",
    "package": "gerbil.pkg",
    "selection": "init.ss",
    "build": "build.ss",
    "example": "examples/source-contracts.ss",
    "disabled-example": "examples/source-contracts-disabled.ss",
    "profiles": "library/source-contract-profiles/interface.ss",
    "config": "library/source-contracts/config.ss",
    "plans": "library/source-contracts/methods.ss",
    "native-case": "t/source-contract-owner-config-test.ss"
  },
  "basis": {
    "captureRef": "design-candidate:90.140-flat-declarative-library-boundary",
    "modelRefs": [
      "docs/10-19-design/10-architecture/10.148-flat-declarative-library-boundary.org"
    ],
