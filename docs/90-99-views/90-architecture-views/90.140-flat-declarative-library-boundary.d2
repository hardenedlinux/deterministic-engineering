|}}}
direction: down

package: "gerbil.pkg\nOne AI Agentic Lab dependency"
selection: "Root init.ss\nFlat library/<module-name>/\nNative tag Profiles and yuanxu!"
domains: "Parent domain Modules\nCapacity, lifetime and organization"
specialization: "Language-specialized Modules\nRust / Tokio / Rayon correspondence"
profiles: "Profile Modules\nConfig.verification assignment\nNative dependency refinement + sealed Config Type"
plans: "Source-contract declarations\nConfig: enable + typed settings\nFinal-scope plan / disabled refusal\nStep-derived external tool closure"
rules: "ASCENT declarations\nObligations and evidence relations"
build: "Root build.ss\ninit.exports std-make-spec only\nNative build and compiled metadata pass"
sysml: "SysML declarations\nResponsibilities and relationships"
development: "Development boundary: t/*-test.ss\nActual tools, independent gold and real subjects"
external: "External consuming ecosystem\nMarlin / Aitia / other Runtime\nSessions, approval and recovery"
pending: "Open acceptance gates\nCandidate cohort / full install / CI\nPartial Settings merge not implemented\nCurrent whole-product acceptance pending"
example: "User Examples\nImport Config; direct or plain object assignment\nInternal inheritance stays in Library"
example -> profiles: "assigned Config; native admission"
package -> selection
selection -> domains
selection -> build
sysml -> domains
domains -> specialization
domains -> profiles -> plans
domains -> rules
plans -> development
rules -> development
plans -> external: "declarations"
rules -> external: "data contracts"
development -> pending
