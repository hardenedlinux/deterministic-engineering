# org-target: docs/20-29-cases/20-gateway/20.06-oracle-packet-integration.org::#packet-poo-allocation
# Data and ownership dependencies, not a prescribed Agent workflow or an implemented adapter.
direction: down
classes: {
  native: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  data: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  boundary: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
core: "Existing Core selection epoch\nModule / Profile / Scenario identity\nSelection does not execute or register results" {class: native}
domain: "gateway-domain role owners\nTypes: nine review record Contracts\nObjects / config: pure Profile values; func: pure transforms" {class: data}
evidence: "gateway-evidence role owners\nTyped associations + native Evidence constructors\nDeclare dependency; no new oracle Module" {class: native}
occurrence: "Explicit selected gateway-review occurrence\nFinal receiver / source / policy / cut capture\nExisting Scenario / Case work owners" {class: native}
registry: "Existing application source / component / View registry\nAdmitted source, export and relation handles\nExisting journal retains immutable history" {class: native}
result: "Actual producer or review artifact references\nInput / closure / source / outcome / completeness\nPaper premises remain paper premises" {class: data}
program: "Existing ASCENT Program / Session / Clue\nCandidate input subset and typed relation joins\nNative T binds bytes; proposed domain use checks remain" {class: native}
query: "Raw queries + scoped packet review questions\nSupport / counter / unknown separate from V / A\nOpen reasoning and independent discovery retained" {class: data}
gold: "Independently authored input-bound gold artifact\nReview scope uses its own allowed input subset\nNot a positive gateway observation" {class: data}
compare: "Existing explicit independent review work\nFixed candidate output + input + gold + cut\nNative labels do not enforce access isolation" {class: boundary}
consume: "Existing method / Aitia / Host consumers\nGenuine verifier and scoped admission references\nSeparate authority, fencing and actual effect receipt" {class: boundary}
core -> domain: "inert publication and value access"
core -> occurrence: "select configuration; later work is explicit"
domain -> evidence: "shared domain Contracts"
evidence -> registry: "R0-R1 export and source binding"
occurrence -> result: "R2 actual work or explicit hypothetical fixture input"
registry -> program: "explicit owner creation with admitted constructor"
result -> program: "R3-R4 content-checked selected inputs"
program -> query: "native queries and proposed domain associations"
query -> compare: "freeze candidate result; not gold generation"
gold -> compare: "independent expected judgments"
compare -> consume: "bound review is one input, never self-issued V / A"
