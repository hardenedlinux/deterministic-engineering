direction: right
library: {
  label: "Domain Library / authored meaning"
  generic: "backpressure-memory\nGeneric ownership / QNT / Lean\nTyped finite factor-rule shape"
  specialization: "backpressure-tokio-rayon\nNative Module / Record contracts\nStates / cases / policies / SysML\nTokio + Rayon implication as data"
  generic -> specialization: "actual parent Scope / inherited obligations"
}
driver: {
  label: "Scheme driver / native effects"
  assembly: "rust-resources Interface\nRequires generic + specialization\nAdmitted policies / explicit method refs"
  binding: "One native POO binding prototype\nOne explicit implementation table"
  execution: "Capture / execute / independent oracle\nIssue and validate original result handles"
  assembly -> binding -> execution
}
rust: "languages-engineering/rust\nCargo.toml / Cargo.lock / src/main.rs"
evidence: {
  label: "Shared ASCENT driver / no Rust names"
  rules: "Catalog-scoped binary implications\nCatalog-scoped dependency joins"
  facts: "Actual witnesses / checked results\nFive supports + M06 counter\nPending and frozen history retained"
  rules -> facts
}
closure: "One canonical model Scope\nNative close-validation + private proof\n5 driver nodes / original policy anchors\nNo repeated Function normalization"
library.specialization -> driver.assembly: "admitted model capabilities"
library.generic -> driver.assembly: "original parent identity"
library.specialization -> evidence.rules: "typed Catalog facts"
rust -> driver.execution: "source and Cargo input capture"
driver.execution -> evidence.facts: "actual exchange registration"
closure -> driver.assembly: "stable parent / policy / wrapper identity"
evidence.facts -> driver.execution: "reuse only current exact bases"
