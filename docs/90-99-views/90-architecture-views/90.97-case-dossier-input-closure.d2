# org-target: docs/10-19-design/10-architecture/10.34-case-design-review-dossier-draft.org::#case-reference-closure
# render-layout: elk; theme: 0; pad: 24; timeout: 30
direction: down
policy: "C1 design-review selection\nExpected D01-D10; actual + target; roles unresolved\nNo policy change or submission"
bindings: "C4 exact product bindings\nNamed Org sections + per-duty input demands\nOne section can fulfill several roles"
candidate: "Current candidate\nDOC / SRC / EXT / VIEW catalog\nLocal byte identities; not native capture"
history: "Historical H1-H3\nAnchored report and 1,299 expected file pairs\n20 review/result references; no methods rerun"
missing: "Missing M1-M2\nProject-content results/query; assignees\nAdmitted capture/request and disposition"
closure: "Bounded declared reference closure\nSelected local inputs indexed\nRuntime transitive closure / recipient access open"
draft: "D10 dossier / output\nScope, inventory, provenance, gaps and questions\nExcluded from own input hash table"
future: "Future existing Aitia owner\nQualified roles, policy and admitted current content\nNo request or disposition created now"
policy -> bindings: required inventory
bindings -> candidate: actual selected content
bindings -> history: scoped historical reference
bindings -> missing: explicit absence
candidate -> closure
history -> closure
closure -> draft: candidate basis
missing -> draft: blockers retained
draft -> future: separate qualified submission {
  style.stroke-dash: 4
}
