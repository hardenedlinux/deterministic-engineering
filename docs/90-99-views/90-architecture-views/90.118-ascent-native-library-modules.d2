direction: right
init: "ASCENT init.ss\nyuanxu! :load-modules"
core: "Native Yuanxu / POO\nRole admission + source closure\nOwned build specification"
modules: {
  label: "Existing domain owners, native publications"
  relations: "Relations\nIndex + storage providers"
  inference: "Inference\nRelation constructor + program\nEvaluation + sessions"
  evidence: "Evidence\nSnapshot + receipt lifecycle\nFinite replay + verification"
}
package: "ASCENT package owner\nC ABI + link outputs\nCompiler outputs + source receipts"
checks: "Real query + independent expected rows\nChanged source rejects reuse\nOriginal snapshot remains verifiable"
branches: "Verified history bundle\nRetire obsolete refs\nPreserve active dirty worktree"
init -> core
core -> modules.relations
core -> modules.inference
core -> modules.evidence
core -> package: "exact owned spec"
modules.evidence -> checks
modules.inference -> checks
package -> checks: "native products"
branches -> init: "existing PR branch"
