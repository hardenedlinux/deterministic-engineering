direction: right
domain: "Existing Domain owner\nNative Profile + Context contracts\nCurrentness and actual capture"
evidence: "Existing Evidence owner\nTyped native methods\nRecorded-only policy"
declaration: "Native Scenario declaration\nExplicit actual owner Contract\nNo global cohort substitute"
assembly: "Existing POO producer\nEffective owner fields / inheritance\nParent caches remain independent"
admission: "Owner-dependent Record + Function\nOne native close-validation graph\nNormalize methods once"
materialize: "Native map-object-values\nAdmitted values before metadata\nStable function identities"
holder: "Private normalization holder\nBinds issuer to native graph\nNo execution authority"
use: "Scenario method body\nAssociation checks + current!\nActual use boundary retained"
session: "Real ASCENT Session\nOld result remains frozen\nFresh capture does not create support"
reject: "LC01-LC07\nWrong owner / replaced methods\nForeign or relabeled graph"
domain -> declaration
evidence -> declaration
declaration -> assembly -> admission -> materialize -> holder
holder -> use -> session
domain -> admission: "actual owner membership"
domain -> use: "source currentness"
holder -> reject: "exact canonical identities"
