  "variants": [
    {
      "name": "sketchbook",
      "themes": [
        "sketchbook",
        "ember",
        "compact",
        "layered-right"
      ]
    }
  ]
}
|
}}}
authoring: Authoring and model input {
  question: "Questions and model/source refs\nProject-owned D2 declaration"
  proposal: "Human / LLM candidate\nContent and organization"
  compile: "Official D2 compilation\nmodel and metadata"
  question -> proposal: author
  proposal -> compile: capture source
}
materialization: Selected static presentation {
  select: "Resolve variant\nKind / layout / themes / icons"
  compose: "Pure composition\nSame model and Questions"
  export: "Static HTML / SVG / PNG\nFonts / visibility / fingerprints"
  select -> compose: resolved input
  compose -> export: HTML candidate
}
artifact: "Captured artifacts\nTS SVG / PNG and source receipts"
inspect: "Human visual audit\nArtifacts and remaining gaps"
authoring.compile -> materialization.select: declared selection
authoring.compile -> artifact: model / source binding
artifact -> inspect: SVG candidate
materialization.export -> inspect: image and receipt
