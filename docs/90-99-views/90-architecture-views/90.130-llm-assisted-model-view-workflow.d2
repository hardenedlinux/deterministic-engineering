...@../../../packages/render/themes/flow
confirmed: {label: "User-confirmed intent\nproject inputs and responsibility"; class: note}
llm: {label: "LLM proposes model and views\narchitecture and workflow kept separate"; class: semantic}
check: {label: "Check obligations and model\nASCENT queries / SysML capability"; class: policy}
selection: {label: "Select view family and theme\nexplicit candidate capture"; class: cloud}
render: {label: "Render candidate\nfunctional core / bounded effects"; class: runtime}
review: {label: "Review and publish\nretain source and decision links"; class: note}
confirmed -> llm: authorized design input
llm -> check: candidate, not evidence
check -> selection: supported candidate
selection -> render: immutable input
render -> review: images and trace
