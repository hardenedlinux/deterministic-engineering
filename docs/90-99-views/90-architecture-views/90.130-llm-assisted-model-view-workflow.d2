# Current authored view; arrows mean the relation explicitly written on each edge.
vars: {d2-config: {layout-engine: elk; pad: 24; data: {figure: |json
{
  "title": "Static view authoring and image export workflow",
  "purpose": "workflow",
  "kind": "view-authoring",
  "language": "en",
  "width": 1120,
  "primary": "scope",
  "questions": [
    {
      "ref": "scope",
      "text": "How does a declared candidate become a reviewable image without issuing evidence or publishing a model?",
      "focusRefs": [
        "source"
      ]
    }
  ],
  "references": {
    "source": "docs/90-99-views/90-architecture-views/90.130-llm-assisted-model-view-workflow.d2"
  },
  "basis": {
    "captureRef": "design-candidate:current-readme",
    "modelRefs": [
      "project.sysml"
    ],
    "obligationRefs": [
      "docs/10-19-design/10-architecture/10.142-declarative-render-extensibility-audit.org"
    ],
    "evidenceRefs": []
  },
  "copy": {
    "status": "Design candidate \u00b7 current source associations retained \u00b7 no C/Q/R issued",
    "description": "Workflow describes control order; it does not authorize effects."
  },
  "themes": [
    "node-editor",
    "ocean",
    "compact",
    "layered-right"
  ],
  "icons": [
    "engineering"
  ],
  "presentation": {
    "scenes": [
      {
        "heading": "authoring",
        "graph": {
          "id": "90.130-llm-assisted-model-view-workflow-scene-1",
          "children": [
            {
              "id": "authoring.question"
            },
            {
              "id": "authoring.proposal"
            },
            {
              "id": "authoring.compile"
            }
          ],
          "layoutOptions": {
            "elk.algorithm": "layered",
            "elk.edgeRouting": "ORTHOGONAL",
            "elk.spacing.nodeNode": "40",
            "elk.layered.spacing.nodeNodeBetweenLayers": "52",
            "elk.layered.considerModelOrder.strategy": "NODES_AND_EDGES"
          }
        },
        "icons": {
          "authoring.question": "question",
          "authoring.proposal": "document",
          "authoring.compile": "model"
        }
      },
      {
        "heading": "materialization",
        "graph": {
          "id": "90.130-llm-assisted-model-view-workflow-scene-2",
          "children": [
            {
              "id": "materialization.select"
            },
            {
              "id": "materialization.compose"
            },
            {
              "id": "materialization.export"
            }
          ],
          "layoutOptions": {
            "elk.algorithm": "layered",
            "elk.edgeRouting": "ORTHOGONAL",
            "elk.spacing.nodeNode": "40",
            "elk.layered.spacing.nodeNodeBetweenLayers": "52",
            "elk.layered.considerModelOrder.strategy": "NODES_AND_EDGES"
          }
        },
        "icons": {
          "materialization.select": "selection",
          "materialization.compose": "model",
          "materialization.export": "document"
