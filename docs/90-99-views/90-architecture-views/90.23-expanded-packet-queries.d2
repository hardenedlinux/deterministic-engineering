# org-target: docs/20-29-cases/20-gateway/20.07-packet-query-and-history-fixtures.org::#eight-packet-query-fixtures
# Independent review questions, not API exports or a mandatory Agent sequence. Each has three path fixtures.
grid-columns: 4
grid-gap: 22
classes: {
  data: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 16}}
  binding: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 16}}
  boundary: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 16}}
}
BQ01: "BQ01: Publication / final receiver / occurrence\nInput: Module + Profile + source + cut\nGold: exact binding; no automatic execution\nC-CAP / C-CACHE / C-SOURCE" {class: data}
BQ02: "BQ02: Input / gold / closure\nInput: exact I + G + CL + CutSpec\nGold: absent / unknown / invalid distinguished\nC-CAP / C-CACHE / C-SOURCE" {class: data}
BQ03: "BQ03: Raw native knowledge\nInput: owner {oL}, explicit claim questions\nGold: L0 support + exact target unknowns\nC-CAP / C-CACHE / C-SOURCE" {class: binding}
BQ04: "BQ04: Usage / T-use / method slots\nInput: u + tu + V + Arg + relevant cut\nGold: scoped pending or checked new-target use\nC-CAP / C-CACHE / C-SOURCE" {class: binding}
BQ05: "BQ05: Independent comparison\nInput: frozen output + independent input-bound gold\nGold: no actual verdict from author specification\nC-CAP / C-CACHE / C-SOURCE" {class: boundary}
BQ06: "BQ06: Impact / retention / reuse\nInput: before / after dependency and record bodies\nGold: withdraw use; retain original evidence\nC-CAP / C-CACHE / C-SOURCE" {class: binding}
BQ07: "BQ07: A use / authorization / effect\nInput: actual A + use cut + separate operational refs\nGold: scoped admission is not an effect receipt\nC-CAP / C-CACHE / C-SOURCE" {class: boundary}
BQ08: "BQ08: Shown units / hint integrity\nInput: actual native ID + content + anchor + owned shown-set\nGold: honest raw reuse; no hidden counter review\nC-CAP / C-CACHE / C-SOURCE" {class: boundary}
