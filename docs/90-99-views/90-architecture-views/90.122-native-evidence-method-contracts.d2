direction: right
library: "Existing Library vocabulary\nNamed Pair / Exactly row Types\nOne scope-binding owner"
domain: "Rust Domain / independent Profile\nFull family admission / actual Context Contract\nSource + Cargo.lock + tool bases"
evidence: "Existing Evidence Module\nSealed publication / Function signatures\nRecord-only policy"
scenario: "Existing Scenario\nSelect actual Domain and Evidence owners\nOwner contract + current!"
session: "Real ASCENT Session\nLiteral obligation / pending oracle\nImmutable old query results"
change: "Source comment byte change\nSource basis + snapshot change\nOld Context refuses current use"
reuse: "Six unchanged conditional bases\nModel / arithmetic / cache / runtime\nWorkload / inventory\nReuse still needs premise closure"
authority: "Separate authority and effect owners\nInput check before method body\nResult check after effects / no rollback"
agent: "LLM-based AI agent\nDiscover / select / investigate / repair\nPending and counter guide reasoning"
library -> domain
library -> evidence
domain -> scenario
evidence -> scenario
scenario -> session
scenario -> change
change -> reuse
change -> session: "old cut remains historical"
evidence -> authority: "admission does not grant permission"
agent -> scenario: "native selection and calls"
session -> agent: "typed errors / obligations / evidence gaps"

capacity: "Native SDK capacity handoff\nPreserve guard / CI declaration\nOtherwise declare host CPU count"
capacity -> scenario: "fixed heap / no fixed worker count"
