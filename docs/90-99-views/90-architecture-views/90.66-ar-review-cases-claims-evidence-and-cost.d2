# org-target: docs/10-19-design/10-architecture/10.18-agent-authored-engineering-and-review-contracts.org::#expanded-ar-review-cases
# render-layout: elk; theme: 0; pad: 24; timeout: 30
direction: down
classes: {
  design: {style.fill: "#FFF2DD"; style.stroke: "#9B6C25"; style.border-radius: 10}
  context: {style.fill: "#EAF2FF"; style.stroke: "#315B8A"; style.border-radius: 10}
  existing: {style.fill: "#E6F5F3"; style.stroke: "#19756C"; style.border-radius: 10}
}
status: "DESIGN GOLD ONLY\nProposed before/after fragments and independent review decisions\nNo code changes, test execution, new Catalog rows or issued T/V/A" {class: design}
cases: "AR01-AR08: concrete review inputs" {
  grid-columns: 2
  grid-gap: 20
  ar01: "AR01 Backpressure owner move\nCaller abort is not payload disposal" {class: context}
  ar02: "AR02 Broadcast cancellation\nAn extracted owned Waker may run later" {class: context}
  ar03: "AR03 Inventory representation\nUpdate cost rationale; inspect surviving bounds" {class: context}
  ar04: "AR04 Capacity and throughput\nConditional budget is not measured speed" {class: context}
  ar05: "AR05 Apparently duplicate checks\nPure frozen reuse differs from a live-use recheck\nComplete packet / gold in 90.67" {class: context}
  ar06: "AR06 Wording-only edit\nMeaning may survive; byte-bound evidence differs\nSeparate wording and native obligations" {class: context}
  ar07: "AR07 Publication / verifier copies\nOne owned capability; actual producer gap remains" {class: context}
  ar08: "AR08 Assurance prose\nSeparate callback, complexity and proof claims\nCounter and pending / opposing-pass diagnostic" {class: context}
}
cut: "Claim / usage / captured input cut\nParent definition + selected Profile + source / policy / cost premises\nFormed before method outputs; local case labels are not content identities" {class: design}
poo: "Proposed POO obligation composition\nPreserve parent meaning and provenance; add changed obligations\nALG-INV / ALG-COST / LIFE-MAP\nARCH-OWNER / STYLE-LOCAL / EXPLAIN-CURRENT\nNo new runtime review framework" {class: design}
oracle: "Independent review basis\nOwnership/event argument / source context / arithmetic / graph / policy\nDo not derive gold from the candidate comment\nMissing evidence is not a checked failure" {class: design}
method: "Future actual validation, if selected\nMethod output + complete inputs + accountable oracle review\nOld source or changed claim cannot borrow another result's scope" {class: design}
ascent: "EXISTING ASCENT relation / exchange owners\nobligation / requires -> matching witness_input + checked\nsupport or counter; unmet support remains pending\nt_use can reference counterevidence; it is not merge authority" {class: existing}
review: "Prospective review gold\nRevise / request validation / reuse candidate / accept wording\nThese are review decisions, not new native relations\nOpposing evidence and original history stay visible" {class: design}
cost: "Evaluate total cost and outcome\nSaved: decisive evidence location and repeated equivalent work\nRetained: necessary semantic, source and race-boundary checks\nAvoid: copied essays, extra engines, irrelevant reruns, false assurance\nNo review-cost improvement has been measured" {class: context}
status -> cases
cases -> cut -> poo -> method
cases -> oracle
oracle -> method
method -> ascent -> review -> cost
