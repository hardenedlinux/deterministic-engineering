# org-target: docs/20-29-cases/20-gateway/20.05-expanded-admission-controls.org::#expanded-dc-controls
# Paper oracle contracts, not executed passes. Each lettered subcontrol resets independently.
grid-columns: 4
grid-gap: 22
classes: {
  identity: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 16}}
  evidence: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 16}}
  review: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 16}}
  use: {style: {fill: "#F0EBFA"; stroke: "#72519A"; border-radius: 10; font-size: 16}}
}
DC01: "DC01: Alias / order\nSame canonical claim\nOC; CW01-02 / 12" {class: identity}
DC02: "DC02: Semantic field change\nNew claim; old use RJ03\nOC / OW / OR; CW05-06" {class: identity}
DC03: "DC03: Reviewed slot revision\nSame claim; old A RJ08\nOR; CW09 / 11-12" {class: identity}
DC04: "DC04: Schema / kind / body / T\nRJ01 / RJ02 / RJ05\nOC / OR / OW; CW01-04" {class: identity}
DC05: "DC05: Stable bytes, new metadata\nConflicting ID RJ04; V RJ06\nOW / OR; CW03-07" {class: evidence}
DC06: "DC06: Split witness factors\nNo match; forged splice RJ04\nOW; CW03 / 05 / 16" {class: evidence}
DC07: "DC07: Missing / wrong V\nPending method / binding; RJ06\nOR; CW07 / 09 / 12" {class: evidence}
DC08: "DC08: Checked counterexample\nNot positive Q: RJ07; conflict\nOR / OK; CW07 / 09-11" {class: evidence}
DC09: "DC09: Missing app / extraction\nPending method / binding\nOR; CW07-09 / 12" {class: review}
DC10: "DC10: Law / target / measurement\nChecked transfer; no new A\nOW / OR; CW08-12" {class: review}
DC11: "DC11: Filtered opposing witness\nConflict; forged review refused\nOK / OR; CW10-11 / 15-16" {class: review}
DC12: "DC12: Source / policy cut change\nWithdraw use; stale use RJ10\nOU / OR; CW12-14" {class: review}
DC13: "DC13: Absence / grounding / unknown\nWithdraw; cycle RJ09; pending\nOU / OR; CW09 / 13-14" {class: use}
DC14: "DC14: Content / shown provenance\nExpand H3; unowned hint RJ11\nOW / OK / OU; CW10 / 15-16" {class: use}
DC15: "DC15: Authority / effect promotion\nRJ12; original A keeps scope\nOR; CW04 / 07 / 12" {class: use}
DC16: "DC16: Budget / unknown coverage\nInconclusive / pending scope\nOC / OK; CW06 / 09 / 11" {class: use}
