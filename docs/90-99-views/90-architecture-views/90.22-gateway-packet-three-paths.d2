# org-target: docs/20-29-cases/20-gateway/20.06-oracle-packet-integration.org::#three-packet-reviews
# Each branch independently resets from hypothetical B0. Ready rows are separate conditional inputs.
direction: down
classes: {
  input: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  pending: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
  reuse: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
}
b0: "Independent B0 reset / k0\nP0 local GW-02.a, RL / VL0, hypothetical A0\nSame two Module publications and existing native owners" {class: input}
cap: "C-CAP" {
  label.near: top-left
  profile: "Cap2Profile\nXcap / C2 / S0 / M0 / K0" {class: input}
  open: "Icap.open / Gcap.open / CLcap.open\nkCap.open, OC-open; current corpus {oL}\nL0 support; Pcap / PerfCap unknown" {class: pending}
  review: "BQ04-BQ06: application and impact\nC1 application not C2 admission\nRL retained; AppCap / Q / CorrCap pending" {class: pending}
  ready: "Separate Icap.ready / Gcap.ready input\nkCap.ready with all genuine required refs\nConditional Pcap eligibility; no ACap supplied\nPerfCap measurement remains separate" {class: reuse}
  profile -> open: "new input, closure and cut registration"
  open -> review: "exact open gold and missing-edge judgments"
  review -> ready: "only if actual matching method / review premises exist"
}
cache: "C-CACHE" {
  label.near: top-left
  profile: "CacheProfile\nXcache / Sk / Kk / C1 / B2 / Z1" {class: input}
  open: "Icache.open / Gcache.open / CLcache.open\nkCache.open, OK-open; current corpus {oL}\nPcache / CacheAuth unknown; U-cache revised" {class: pending}
  review: "BQ04-BQ06: negative and shared dependencies\nZ0 -> Z1 plus changed source / interpretation\nLaw-to-cache frame / SC / permission / bytes pending" {class: pending}
  ready: "Separate Icache.ready / Gcache.ready input\nkCache.ready; complete target-specific arguments\nConditional eligibility for each exact target\nPcache A cannot discharge all CacheAuth / U-cache" {class: reuse}
  profile -> open: "new input, closure and cut registration"
  open -> review: "same C / B does not preserve applicability"
  review -> ready: "only with new cache model / frame and full target evidence"
}
source: "C-SOURCE" {
  label.near: top-left
  profile: "LocalProfile, explicit S1 source binding\nXsrc / S1 / K0; M0 text retained" {class: input}
  open: "Isrc.open / Gsrc.open / CLsrc.open\nkSrc.open, OS-open; current corpus {oL}\nL0 support; Psrc unknown" {class: pending}
  review: "BQ04-BQ06: exact selected source closure\nOld VSC0 not Corr1; Q / native use rechecked\nRL retained; RLate captured k0 / recorded kLate\nFrozen k0 excludes that late record" {class: pending}
  ready: "Separate Isrc.ready / Gsrc.ready input\nkSrc.ready; genuine S1-compatible evidence\nConditional Psrc eligibility; no automatic ASrc\nChanged transitions require revised model / gold" {class: reuse}
  profile -> open: "new input, closure and cut registration"
  open -> review: "unchanged model text is not source correspondence"
  review -> ready: "only with checked new source / model / method bindings"
}
consume: "BQ05-BQ08 / existing review, Aitia and Host owners\nActual comparison and supplied A checked at current relevant cut\nSeparate authorization / monitor / effect receipt; later drift withdraws use\nOld artifacts, gold and real past effects remain immutable history" {class: input}
b0 -> cap.profile
b0 -> cache.profile
b0 -> source.profile
cap.ready -> consume: "new-target scoped use only"
cache.ready -> consume: "exact target and at-hit policy only"
source.ready -> consume: "new-source scoped use only"
