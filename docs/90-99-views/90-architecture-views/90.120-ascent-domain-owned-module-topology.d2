direction: right
selection: "Native yuanxu!\nRoot window ./ + explicit domain rows\nPer-domain @ paths when needed"
domains: {
  label: "Target: actual top-level domain owners"
  core: "core\nFinite values / dependency primitives"
  table: "table\nProviders / eqrel / trrel"
  program: "program\nDeclarations / evaluation / sessions"
  candidate: "candidate\nProvenance / finite replay / support cuts"
  rules: "rules\nDeclarations / evidence bindings"
  temporal: "temporal\nCut and lens semantics"
  applications: "applications\nDomain analyses and independent oracles"
  engine: "engine @ interface/\nTransport / ABI / effect ownership"
}
source: "Existing Core owners\nSelection + role/Contract admission\nReal transitive source closure"
checks: "Native build + installed fresh-process consumers\nLive queries + unchanged independent oracles\nFrozen evidence and changed-source rejection"
retire: "Transitional modules/ forwarders\nRemove through direct consumer migration\nCurrent layout remains partial"
foreign: "Rust / Python / C / proofs / tests\nActual tool and package owners\nExplicit evidence dependencies"
selection -> source -> domains
source -> checks
retire -> selection: "replace, not layer"
domains -> checks: "MT01-MT10"
foreign -> checks

review: "Human-readable source\nOne named field per line / explicit nested scopes\nReader-equivalent format-only review"
review -> checks: "separate from semantic acceptance"
