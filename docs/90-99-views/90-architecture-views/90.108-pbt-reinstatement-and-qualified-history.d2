# org-target: docs/10-19-design/10-architecture/10.118-domain-property-testing-and-evidence-trajectories.org::#pbt118-reinstatement-history-packets
# render-layout: elk; theme: 0; pad: 24
direction: down
title: "Reinstatement / historical applicability / recovered prior acts\nDesign input packets and expected gold; no native execution" {shape: text}
input: "Existing Library / POO Module / Profile / Scenario owners\nCapture exact source, policy, role, occurrence and target\nMissing qualification stays explicit; output never justifies its own input"
packets: {
  direction: right
  restored: {
    label: "SU-G09 / RU-G00-11"
    basis: "Original W-PT / V-PT / S1\nAuthorized S2 resolves a-held only\nPV0 and actual new use X-R1"
    compare: "Unchanged qualified dependencies -> reuse candidate\nChanged source / unresolved counter -> affected review\nS3 between early check and effect -> actual boundary policy\nOld receipt cannot become new current authority"
    result: "New C-R1 / U-R1 and eligible checked association\nS2 is not a fresh semantic observation\nPreserve unrelated roles and old frozen views"
    basis -> compare -> result
  }
  history: {
    label: "HC-G11 / QH-G00-12"
    basis: "Original r0 / g0 / I-C0 / PC0 / B0\nRecovered HC1: k0 -> a0 -> f0\nIndependent method validation and admission"
    compare: "Authenticity alone is not semantic qualification\nQualified old edge -> bounded PC0 discharge\nChanged run / source / policy -> reassess affected claim\nConflicting graph is not a vacuous proof"
    result: "New C-HQ1 / graph / T-V-A / U-HQ1\nOld unknown remains a frozen knowledge state\nNo new-run guarantee or delivery coverage"
    basis -> compare -> result
  }
  recovered: {
    label: "MP-G09 / PA-G00-12"
    basis: "Known E2 / G-old / original PA0\nRecovered original p0 -> v0 -> e0\nLater audit has its own actual occurrence"
    compare: "Qualified original acts -> historical route confirmation\nMissing role / unknown order -> pending\nProven absent / rejected / late -> route unmet\nPresent audit cannot fill a missing prior act"
    result: "New C-PA1 / historical audit / U-PA1\nLate recovery after freeze -> new C-PA2\nNo backdated permission or future effect authority"
    basis -> compare -> result
  }
}
closure: "Independent role / dependency / applicability comparison\nASCENT support, counter and t_use use actual eligible inputs\nNative pending is not complete review or permission\nRetain raw evidence; recheck only affected uses"
agent: "LLM-based AI agent discovers rules and missing evidence\nAcquire or validate through existing method / review owners\nActual receiver enforcement and historical qualification remain native gates"
title -> input: {style.opacity: 0}
input -> packets.restored.basis
input -> packets.history.basis
input -> packets.recovered.basis
packets.restored.result -> closure
packets.history.result -> closure
packets.recovered.result -> closure
closure -> agent
