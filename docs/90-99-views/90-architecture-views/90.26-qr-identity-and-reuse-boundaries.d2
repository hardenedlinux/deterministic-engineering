# org-target: docs/20-29-cases/20-gateway/20.08-qr-identity-and-reuse-controls.org::#qr-cut-identity-dag
# Identity dependencies only; existing native owners, no new engine or Agent workflow.
direction: down
classes: {
  roots: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  refs: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  boundary: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
raw: "D0 raw roots\nDeclarations / constructor / supplied facts\nSource-label digest map / rules\nNo future CutId or usage verdict" {class: roots}
context: "D0 independent domain roots\nProfile / source / policy / selected closure\nRelevant evidence and scope generations" {class: roots}
native: "D1 native raw sourceIdentity\nEqual actual hashed inputs -> same N_L\nLogical labels do not force inequality\nSame N_L does not merge mutable session state" {class: roots}
cut: "D2 captured input CutSpec\nNative identity + typed domain roots\nNo self ID or future I / gold / review result" {class: roots}
usage: "D3 exact fresh usage / T-use\nWitness / envelope / target / method / cut\nSame native TL is not the same wrapper" {class: refs}
closure: "D4 InputClosure: oracle-input scope\nPrior root / usage references only\nExcludes its referencing I and future G / output" {class: refs}
input: "D4 OracleInputSpec\nExact earlier closure and captured cut\nNo back-reference to later package review" {class: refs}
gold: "D5 independently authored gold\nExact I / input closure / cut\nCandidate output is not its producer" {class: refs}
output: "D5 frozen candidate output\nSame exact input / cut\nActual result required; no hypothetical receipt" {class: refs}
review: "D6 actual comparison and review closure\nCan inspect earlier I / G / output\nNo earlier I / G points back here" {class: boundary}
late: "Separate source-path late intake\nCaptured k0, recorded kLate / PfxLate\nFrozen Pfx0 unchanged; producer completion unknown" {class: boundary}
next: "Later immutable input epoch, when required\nMay reference already existing review or late result\nOld records / cut bodies retained; affected use rechecked\nNo retroactive mutation or new framework" {class: boundary}
raw -> native: "existing native identity function"
native -> cut: "one input; not the whole domain cut"
context -> cut: "independent relevant generations"
cut -> usage: "captured before dependent association"
usage -> closure: "separately bound identity / guards"
closure -> input: "earlier scope before its referring record"
input -> gold: "independent gold route"
input -> output: "candidate route"
gold -> review: "fixed expected judgments"
output -> review: "actual output reference"
cut -> late: "source-case captured input; no old-prefix insertion"
review -> next: "prior real result, if included"
late -> next: "new history member, if included"
