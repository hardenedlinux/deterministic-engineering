}}}
project: Downstream project {
  source: "D2 / SysML / Org references\nQuestions, copy and selected relations"
  resources: "Theme layers / icon packs\nProject-owned immutable data"
  composer: "Domain compositor\nPresentation schema and organization"
}
library: "@deterministic-engineering/render" {
  capture: "D2 declaration adapter\nResolved kinds, resources and variants"
  composition: "Pure composition\nImmutable model and source footprint"
  export: "Static export effect\nVisibility, fonts, images and receipts"
}
deps: Mature dependencies {
  d2: "D2 compiler / model projection"
  html: "parse5 HTML parser"
  drawing: "Rough.js / XYFlow\nStrokes / authored HTML paths"
  elk: "ELK.js\nMeasured nodes / labels / routing"
  browser: "Playwright browser\nActual layout / fonts / PNG"
}
library.capture -> project.source: reads declared view
library.capture -> project.resources: resolves named layers/packs
project.composer -> library.composition: supplies pure function
library.composition -> deps.html: parses actual markup
library.capture -> deps.d2: delegates model compilation
library.export -> deps.drawing: delegates strokes and paths
library.export -> deps.browser: owns export context
library.composition -> project.source: retains model and source links

library.export -> deps.elk: delegates scene layout and routing
