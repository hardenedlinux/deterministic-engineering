direction: right

title: {
  label: "250-Case B1-B18 Durable AI Governance & 17-Module / 186-Theorem LeanPoo Panoramic Architecture (10.195 / 90.153)"
  near: top-center
  shape: text
  style.font-size: 20
  style.bold: true
}

library: "Reusable Formal Library (deterministic-engineering-qnt — ZERO Mathlib, ZERO Cedar)" {
  style.fill: "#F4F8FB"
  style.stroke: "#2C5E8A"
  style.stroke-width: 2

  p1: "Paradigm 1: Quint / Apalache + F3 + MBT" {
    style.fill: "#E8F1FA"
    style.stroke: "#2C5E8A"
    q26: "26 Defense Models (B1-B17)\n(Apalache PLAN-OK + 100% F3 essential)\n26/26 MBT SUT State Isomorphism"
  }

  p2: "Paradigm 2: Gerbil Scheme ASCENT" {
    style.fill: "#E9F7EF"
    style.stroke: "#1E8449"
    ascent: "44 Sources x 24 Outputs (B1-B17)\nLive gxi Stratified Datalog Oracle\nN-Version Disagreement Fail-Closed"
  }

  p3: "Paradigm 3: CBMC & 5-Language Harnesses" {
    style.fill: "#FEF9E7"
    style.stroke: "#B7950B"
    langs: "C (CBMC 50/50) | C++20 | Rust | TS | Scheme\n250-Case Benchmark (AG01-AG250 / 44 Suites)\n15/15 R3 Non-Leakable M3 Capabilities"
  }

  p4: "Paradigm 4: Pure Lean 4 + LeanPoo (17 Modules / 186 Theorems)" {
    style.fill: "#F5EEF8"
    style.stroke: "#7D3C98"
    m1_14: "Modules 1-14 (156 Theorems)\nB1-B15, R1-R5, Export, 4-Paradigm, Offline Cert, TEE"
    m15: "Module 15: KeyRotationAndCryptoShredding\n(B16: 10 Theorems — AES-256-GCM Rotation & GDPR Erasure)"
    m16: "Module 16: PostQuantumCryptoAgility\n(B17: 10 Theorems — Dual-AND Ed25519+Lamport OTS Agility)"
    m17: "Module 17: ZeroKnowledgeSelectiveDisclosure\n(B18: 10 Theorems — Schnorr Sigma + Anti-Over-Disclosure)"
    m1_14 -> m15 -> m16 -> m17
  }

  gate: "Single-Shot Fleet Gate\njust audit-leanpoo-fleet --json\n(26 Quint x 44x24 ASCENT x 186/186 Axioms)" {
    style.fill: "#D6EAF8"
    style.stroke: "#1B4F72"
    style.bold: true
  }

  p1 -> gate
  p2 -> gate
  p3 -> gate
  p4.m17 -> gate
}

custody: "Air-Gapped PQ-Hybrid & Zero-Knowledge Custody" {
  style.fill: "#FDEDEC"
  style.stroke: "#922B21"
  style.stroke-width: 2

  cert: "SignedLibraryReleaseCertificate\nPublisher Ed25519 + 3-of-4 Witness QC\n+ B17 Dual-AND Ed25519+Lamport PQ Signature"
  zk: "B18 ZK Selective-Disclosure Compliance Proof\nRFC 3526 MODP-2048 Schnorr Sigma + Salted Merkle\n(Zero Secret Leakage + Single-Use Nullifier)"
  cert -> zk: "Proves Compliance Without Leaking PII"
}

host: "Consuming Authorization Host (cedar-poo-spec)" {
  style.fill: "#EAFAF1"
  style.stroke: "#145A32"
  style.stroke-width: 2

  dual: "Dual-Sovereign Release Gate\nLibrary Finality AND Host Policy Permit\n(Monotonic LeanPoo ObjectContract.refine)"
  policies: "CedarPooSpec.{Authorization,Governance,Admission,Data}\nStrict Library <-> Host Separation (0 Cedar in Library)"
  dual -> policies
}

library.gate -> custody.cert: "M1 Pinned Attestation Digest"
custody.zk -> host.dual: "Verified Offline Cert + ZK Receipt"
