# org-target: docs/10-19-design/10-architecture/10.14-rust-performance-library-and-mechanism-cases.org::#rust-library-boundary
direction: down
classes: {
  knowledge: {style.fill: "#EAF2FF"; style.stroke: "#315B8A"; style.border-radius: 10}
  reasoning: {style.fill: "#E6F5F3"; style.stroke: "#19756C"; style.border-radius: 10}
  boundary: {style.fill: "#FFF2DD"; style.stroke: "#9B6C25"; style.border-radius: 10}
}
library: "Shared engineering Library / Catalog\nRust ownership + resource lifecycles\nLayout / allocation / locality / concurrency\nClaims / alternatives / rules / evidence trajectories" {class: knowledge}
semantics: "Runtime specializations\nFuture poll / wake / retained state\nTokio task / admission / cancellation\nRayon submitted work / CPU owners / result disposal" {class: knowledge}
agent: "LLM-based AI agent\nDiscover mechanisms and applicable knowledge\nBind workload and performance objective\nExplore alternatives and missing evidence" {class: reasoning}
composition: "Existing POO Module / Profile / Scenario\nCoherent knowledge publication\nActual context specialization and bounded questions\nNo fixed application topology or extra framework" {class: reasoning}
applications: "Independent applications\nIndex builder / compression / batch transform\nGateway is another application binding\nProject facts do not define Library ownership" {class: knowledge}
obligations: "Native ASCENT Evidence DSL\nDerive affected obligations and dependency cuts\nSupport / counter / pending / contextual reuse\nEvidence cannot be inferred from an LLM proposal" {class: reasoning}
mechanism: "Native mechanism implemented in 10.15; bounded scope\nAsync submission of owned CPU work\nPermit / cancellation / failed delivery / cleanup\nM01-M06 barrier-defined independent gold\nNo HTTP or gateway service required" {class: boundary}
methods: "Existing Core Ops + QNT + Lean\nExact native source / lock / features / target\nQNT: bounded ownership + explicit mapping\nLean: conditional accounting + justified coefficients\nExisting observer now accepts native results in 10.15" {class: boundary}
evidence: "Existing native ASCENT exchange + Session\nRegister actual validated results only\nRecheck changed source / runtime / workload\nRetain historical witnesses without current backflow" {class: reasoning}
qualified: "Existing 10.13 qualification\nReal QNT / Lean and native registration path\nShared Modules migrated to mechanism owners\nNo native Rust or performance acceptance" {class: boundary}
library -> semantics
semantics -> composition
library -> agent
agent -> composition
applications -> composition: "application inputs"
composition -> obligations
obligations -> mechanism: "one selected investigation"
mechanism -> methods
methods -> evidence: "only after actual validation"
feedback: "Feedback to the Library and LLM-based AI agent\nReview reusable knowledge with explicit premises\nRevise design alternatives from actual evidence\nNo application-wide acceptance by example" {class: knowledge}
evidence -> feedback: "evidence informs alternatives"

qualified -> obligations: "reuse existing inference and exchange"
