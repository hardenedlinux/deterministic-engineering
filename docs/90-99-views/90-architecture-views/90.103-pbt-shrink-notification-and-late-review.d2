# org-target: docs/10-19-design/10-architecture/10.118-domain-property-testing-and-evidence-trajectories.org::#pbt118-focused-boundary-packets
# render-layout: elk; theme: 0; pad: 24
direction: down
title: "Focused PBT boundary packets\nDesign inputs and step gold only; no execution" {shape: text}
selection: "Existing POO Module / Profile / Scenario / methods\nOriginal subjects, typed claims, captured source and exact role closure"
packets: {
  direction: right
  shrink: {
    label: "PB-BS04 / BS04-G00-09"
    input: "Original F-E failing prefix\nCPU retains X1 while R1 is released\nSeparate overlap predicate F-O"
    compare: "A: dispose before violation -> F-E absent\nB: dispose after F-E but before probe -> F-E survives\nC: wait instruction removed but facts survive -> may accept\nD: decisive observations missing -> pending"
    output: "Same predicate needs independent reduced replay\nKeep original W-B0 and fresh reduced cut\nApplicable prefix method needed; full-report timeout stays failed\nCleanup / campaign / isolation acceptance stays separate"
    input -> compare -> output
  }
  notify: {
    label: "PB-CG08-counter / CG08-G00-10"
    input: "Reviewed finite BC-PBT05/N-C0\nEligible F2/task generation and close fence\nComplete notifier / executor / wake-credit inventory and history"
    compare: "No qualifying opportunity under full coverage -> scoped counter\nExisting/coalesced/already-delivered opportunity -> no missed-opportunity counter\nDeferred work / unknown fence / incomplete coverage -> pending\nNo fresh W2 callback alone is insufficient"
    output: "Credit interpretation expanded in view90.104\nOpportunity / actual poll / temporal progress stay separate\nFinite protocol counter does not prove parent liveness failure\nNo automatic unmodified-source or memory-safety result"
    input -> compare -> output
  }
  late: {
    label: "RG08 / RG08-G00-11"
    input: "Original M-B0 / C-B0\nFreeze F0/P0, then source C-B1 and F1/P1\nLate L0 retains original run/cut identity"
    compare: "Validate L0 -> new historical capture C-H0L/P2\nReplay F0 and F1 unchanged\nNew current review C-R1/P2 checks complete opposing family\nOld source mismatch blocks new native applicability"
    output: "Reopen affected review conclusions in a new occurrence\nPreserve historical counter and scoped new-source support\nP3 before actual use requires selected-policy revalidation\nNo query-level compare-and-effect guarantee\nNo mutation of frozen views or old-authority restoration"
    input -> compare -> output
  }
}
closure: "Existing ASCENT relations + actual review/evidence owners\nFresh checked-use and exact footprints; no new counter registry\nOnly affected current conclusions need revalidation"
agent: "LLM-based AI agent / existing Aitia review\nInspect oracle explanation and original/reduced/late references\nReuse unaffected definitions, proofs and evidence within premises\nImplementation coverage and native admission remain open"
title -> selection: {style.opacity: 0}
selection -> packets.shrink.input
selection -> packets.notify.input
selection -> packets.late.input
packets.shrink.output -> closure
packets.notify.output -> closure
packets.late.output -> closure
closure -> agent
