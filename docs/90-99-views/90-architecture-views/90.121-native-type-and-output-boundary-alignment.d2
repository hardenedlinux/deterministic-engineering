direction: right
poo: "Existing POO / Yuanxu owners"
records: "Named Type + Record\nRequired / inherited / sealed fields"
method: "Function + actual signatures\nArguments / keywords / results"
association: "ObjectContract + contextual refinement\nBindings / identities / delayed fields"
evidence: "Existing ASCENT evidence relations\nApplicability / failure / authority"
projection: "Selected actual ASCENT rows\nOrdered model projection"
output: "One private output port\nFinal text only / exact quoting"
checks: "Native Record + Scope regressions\nActual ASCENT consequences\nIndependent quoted-reference expectation\n3,959-byte output comparison"
open: "Open acceptance gates\nShallow Scope contracts / identity encodings\nDirectory grouping != admitted dependency decomposition\nNative source ownership / cold CI"
poo -> records
poo -> method
poo -> association
records -> evidence: "data admission is not permission"
method -> evidence
association -> evidence
projection -> output -> checks
evidence -> projection: "selected consequences"
checks -> open: "focused checks do not qualify full CI"
