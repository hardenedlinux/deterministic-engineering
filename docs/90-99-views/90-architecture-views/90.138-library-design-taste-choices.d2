library: "Library\nDefinitions and contracts"
project: Project {
  profile: "Profile\nSelects published definitions"
  scenario: "Scenario\nBinds project inputs"
  inputs: "Repository inputs\nModels / Org / decisions"
}
project.profile -> library: selects
project.scenario -> project.profile: binds
project.scenario -> library: references definitions
project.scenario -> project.inputs: binds actual inputs
