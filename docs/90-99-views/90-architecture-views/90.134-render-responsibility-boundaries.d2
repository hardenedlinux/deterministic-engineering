        },
        "icons": {
          "project.declarations": "document",
          "project.resources": "selection",
          "project.composer": "decision",
          "core.compile": "capture",
          "core.compose": "decision",
          "core.export": "reference",
          "libraries.d2": "model",
          "libraries.html": "document",
          "libraries.rough": "selection",
          "libraries.xyflow": "reference",
          "libraries.browser": "reference",
          "libraries.elk": "model",
          "project.source": "document",
          "core.capture": "capture",
          "core.composition": "decision",
          "libraries.drawing": "selection"
        },
        "roles": {
          "project.declarations": "capture",
          "project.resources": "capture",
          "project.composer": "capture",
          "core.compile": "selection",
          "core.compose": "selection",
          "core.export": "selection",
          "libraries.d2": "external",
          "libraries.html": "external",
