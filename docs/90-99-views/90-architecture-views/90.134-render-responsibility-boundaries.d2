    "description": "Architecture describes responsibilities and dependencies."
  },
  "themes": [
    "blueprint",
    "node-editor",
    "compact"
  ],
  "icons": [
    "engineering"
  ],
  "presentation": {
    "scenes": [
      {
        "heading": null,
