  }
}
|
}}}
project: Project-owned {
  declarations: D2 / SysML / Questions / observations
  resources: Themes / icons / selected variants
  composer: Domain composition / presentation schema
}
core: Render Library {
  compile: Declared input / resource resolution
  compose: Immutable capture / pure composition
  export: Static export / input and visibility checks
}
libraries: Mature libraries {
  d2: D2 compiler / model projection
  html: parse5 HTML parser
  rough: Rough.js Options / primitives
  xyflow: XYFlow path utilities
  elk: "ELK.js\nMeasured nodes / labels / routing"
  browser: Playwright browser / fonts / PNG
}
project.composer -> project.declarations: interprets
project.composer -> core.compose: uses
core.compile -> project.resources: resolves
core.compile -> libraries.d2: delegates
core.compose -> libraries.html: parses
core.export -> libraries.rough: strokes
core.export -> libraries.xyflow: connectors
core.export -> libraries.browser: renders

core.export -> libraries.elk: measured scene layout and routing
