# org-target: docs/10-19-design/10-architecture/10.118-domain-property-testing-and-evidence-trajectories.org::#pbt118-suspension-history-packets
# render-layout: elk; theme: 0; pad: 24
direction: down
title: "Suspended use / historical causal confirmation / missing prior acts\nProposed input packets and gold only; no native execution" {shape: text}
input: "Existing POO / Evidence / ASCENT / review and receiver owners\nActual subject, policy, role, source and captured occurrence\nFresh result references never become their own historical inputs"
packets: {
  direction: right
  suspension: {
    label: "OC-G05 / SU-G00-11"
    basis: "Original W / V / frozen F-S0\nActual authorized S1 and affected assertions\nEffective occurrence under selected validity policy"
    compare: "S1 before use -> old association ineligible\nCached rows or receipts cannot defeat actual suspension\nUnaffected qualified roles remain reusable\nUnverified notice is not a revocation API"
    result: "New eligible source set / actual current-use comparison\nS2 reinstatement needs a fresh basis/use, not old authority\nNo blanket artifact ban or unrelated campaign rerun"
    basis -> compare -> result
  }
  order: {
    label: "PO-G09 / HC-G00-12"
    basis: "Original B0 / run / k0 and f0\nHC1 newly retrieved or validly attested history\nActual k0 completion -> original a0 -> f0"
    compare: "K<F confirmation can select H-a under original waiver\nF<K can select H-b with actual negative coverage\nRequest ACK / redundant edge / new replay cannot fill old order\nConflicting confirmations -> method review, not vacuous proof"
    result: "New historical graph / V / query and checked use\nOld frozen unknown remains intact\nCancellation discharge is not delivery coverage"
    basis -> compare -> result
  }
  prior: {
    label: "HA-G05 / MP-G00-12"
    basis: "Known E2 and valid pre-existing G-old\nOriginal policy requires prior presentation and accepted validation\nActual role / timing / subject evidence"
    compare: "Grant alone -> exact missing roles pending\nQualified absence / rejection / late act -> route unmet\nRecovered genuine prior acts may close knowledge gaps\nLater V-new cannot be the missing V-old"
    result: "New bounded historical assessment\nOne record may satisfy permitted roles; keep required independence\nNo new effect, replay or backdated permission"
    basis -> compare -> result
  }
}
closure: "Exact role / source / policy / validity comparison\nIndependent interpretation and actual issuer/admission handoff\nFrozen history retained; unaffected qualified evidence reused\nDetailed SU-G09 / HC-G11 / MP-G09 packets: view 90.108"
agent: "LLM-based AI agent / existing Aitia and receiver workflow\nAcquire only missing required evidence\nKeep prior occurrence, new proof and current authority distinct\nNative handoff / historical coverage / enforcement remain open"
title -> input: {style.opacity: 0}
input -> packets.suspension.basis
input -> packets.order.basis
input -> packets.prior.basis
packets.suspension.result -> closure
packets.order.result -> closure
packets.prior.result -> closure
closure -> agent
