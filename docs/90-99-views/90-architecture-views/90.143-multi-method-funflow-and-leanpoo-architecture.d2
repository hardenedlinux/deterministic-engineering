direction: down

config: "SysML v2 Single Source of Truth (10.154-*.sysml)\n5 Zero-Glue Subjects | 13 Verification Engines\nOpenSysML -validate -strict -> api-json"

ascentGate: "ASCENT Governance (ascent-rules.ss)\nMR01-MR06 Pre-Flight | ER01-ER04 Admission\nIR01-IR06 Reuse, Toolchain Drift & Ed25519 Attestation\nSelf-Verified in Lean 4 (Core.MetaGovernance)"

funflow: "Fun-Flow Control Plane (library/verification-flow/)\nZero-I/O SysML->DAG Compiler + Conflict-Free Parallel Waves\nTaskFamilyRegistry: de-quint | de-lean-poo | de-source | de-oracle\nEmits yuanxu.core.flow-dag-runtime-manifest.v1"

quintModels: "packages/quint-models (Bun / Apalache / MBT)\nClaim: bounded-interleaving, fault-race, mbt-trace\nProcessTree | BackpressureOwners | LeaseFencingToken"

leanModels: "packages/lean-models (Lake / LeanPoo 6-Core, 0 sorryAx)\nClaim: unbounded-invariant, refinement, proof-transport\nCore/{Conservation,Budget,Containment,Order,Transport,MetaGovernance}\nRefines -> 5 Engineering Modules (83/83 Lake jobs)"

rustSubjects: "languages-engineering/{rust,c} + Source Contracts\nClaim: source-memory-ub (CBMC 6.11), api-ban-lint (Clippy)\nProcessTreeGuard (HTTP E2E, Online OS MBT, Darwin setsid)\nBackpressure Tokio/Rayon | C deterministic_boundary.c"

runtimeAdapter: "Parallel Contained Ops Runner (verification-flow-runner.ss)\nConcurrent Gambit Green-Thread Waves + Replay Validation\nEd25519 Signed Cache (v2) + 2-Level Merkle Fleet Report\nPinned-Key Offline Verifier + <1s Dry-Run Impact Predictor"

evidenceSession: "Unified ASCENT Evidence & Attestation Closure\nPinned-Key Ed25519 Report + Fleet Merkle Verification\nCold 13/0 -> Warm 0/13 Verified Reuse Across All 5 Subjects"

config -> ascentGate
config -> funflow
ascentGate -> funflow: "admitted pending frontier"
quintModels -> funflow: "runnable-flow (de-quint)"
leanModels -> funflow: "runnable-flow (de-lean-poo)"
rustSubjects -> funflow: "runnable-flow (de-source / de-oracle)"
quintModels -> rustSubjects: "MR04: itf-trace"
rustSubjects -> leanModels: "MR03: SpawnPreservesContainer"
funflow -> runtimeAdapter: "inert DAG runtime manifest"
runtimeAdapter -> evidenceSession: "pure runnable-admit records"
evidenceSession -> ascentGate: "revalidation & reuse loop"
