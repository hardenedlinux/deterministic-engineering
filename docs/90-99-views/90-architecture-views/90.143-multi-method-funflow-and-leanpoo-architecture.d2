direction: down

config: "SysML v2 Single Source of Truth (10.154-*.sysml)\n6 Zero-Glue Subjects (5 Eng + 1 Threat) | 15 Engines\nOpenSysML -validate -strict -> api-json"

ascentGate: "ASCENT Governance (ascent-rules.ss)\nMR01-MR08 Pre-Flight (incl. Acyclicity) | ER01-ER04 Admission\nIR01-IR08 Reuse, Toolchain Drift, Ed25519 Trust/Revocation, Strict Premise & M3 TTL\nSelf-Verified in Lean 4 (27 Zero-Axiom Theorems in Core.MetaGovernance)"

funflow: "Fun-Flow Control Plane (library/verification-flow/)\nZero-I/O SysML->DAG Compiler + Conflict-Free Parallel Waves\nStatic Change-Impact Analyzer + TaskFamilyRegistry\nEmits yuanxu.core.flow-dag-runtime-manifest.v1"

quintModels: "packages/quint-models (Bun / Apalache / MBT)\nClaim: bounded-interleaving, fault-race, mbt-trace\nEngineering: ProcessTree | Backpressure | LeaseFencing\nThreat: DelegatedAgentAuthz + AuthorityCurrentness"

leanModels: "packages/lean-models (Lake / LeanPoo 6-Core, 0 sorryAx)\nClaim: unbounded-invariant, refinement, proof-transport\nCore/{Conservation,Budget,Containment,Order,Transport,MetaGovernance}\nRefines -> 5 Engineering + 2 Threat Modules (CapabilityContainment, AuthorityCurrentness)"

rustSubjects: "languages-engineering/{rust,c} + Source Contracts\nClaim: source-memory-ub (CBMC 6.11), api-ban-lint (Clippy)\nProcessTreeGuard (Linux cgroup v2 pre_exec/kill, Darwin setsid, Online OS MBT)\nBackpressure Tokio/Rayon | C deterministic_boundary.c"

runtimeAdapter: "Parallel Contained Ops Runner (verification-flow-runner.ss)\nConcurrent Gambit Green-Thread Waves + Replay Validation\nMulti-Key Ed25519 Trust Store (JSON v1 Rotation/Revocation) + 2-Level Merkle Fleet\nStandalone Offline CLI (--verify-report / --verify-fleet) + <1s Impact Predictor"

evidenceSession: "Unified ASCENT Evidence & Attestation Closure\nOffline JSON Trust-Store & Pinned-Key Fleet Merkle Verification\nCold 15/0 -> Warm 0/15 Verified Reuse | 10 Qualification Suites + CI Gate"

config -> ascentGate
config -> funflow
ascentGate -> funflow: "admitted pending frontier"
quintModels -> funflow: "runnable-flow (de-quint)"
leanModels -> funflow: "runnable-flow (de-lean-poo)"
rustSubjects -> funflow: "runnable-flow (de-source / de-oracle)"
quintModels -> rustSubjects: "MR04: itf-trace"
rustSubjects -> leanModels: "MR03: SpawnPreservesContainer"
funflow -> runtimeAdapter: "inert DAG runtime manifest"
runtimeAdapter -> evidenceSession: "pure runnable-admit records"
evidenceSession -> ascentGate: "revalidation & reuse loop"
