direction: down

config: "SysML v2 Single Source of Truth (10.154-*.sysml)\n7 Zero-Glue Subjects (5 Eng + 2 Threat) | 17 Engines\nOpenSysML -validate -strict -> api-json"

ascentGate: "ASCENT Governance (ascent-rules.ss)\nMR01-MR08 Pre-Flight | ER01-ER04 Admission\nIR01-IR08 Reuse, Toolchain Drift & Ed25519 Trust\n47 Zero-Axiom Lean 4 Theorems (Core.MetaGovernance)"

funflow: "Fun-Flow Control Plane (library/verification-flow/)\nZero-I/O SysML->DAG Compiler + Parallel Waves\nStatic Change-Impact + TaskFamilyRegistry\nEmits yuanxu.core.flow-dag-runtime-manifest.v1"

quintModels: "packages/quint-models (Bun / Apalache / MBT)\nClaim: bounded-interleaving, fault-race, mbt-trace\nEngineering: ProcessTree | Backpressure | LeaseFencing\nThreat: DelegatedAgentAuthz + AuthorityCurrentness"

leanModels: "packages/lean-models (Lake / LeanPoo 6-Core, 0 sorryAx)\nClaim: unbounded-invariant, refinement, transport\nCore/{Conservation,Budget,Containment,Order,Transport}\nRefines -> Engineering + Threat LeanPoo Modules"

rustSubjects: "languages-engineering/{rust,c} + Source Contracts\nClaim: source-memory-ub (CBMC), api-ban-lint (Clippy)\nProcessTreeGuard (cgroup v2, setsid, Online OS MBT)\nBackpressure Tokio/Rayon | C deterministic_boundary.c"

runtimeAdapter: "Parallel Contained Ops Runner\n(verification-flow-runner.ss)\nGambit Green-Thread Waves + SHA-256 + Ed25519 Fleet\nAir-Gapped Verifier (offline-attestation-verifier.ss)"

evidenceSession: "Unified ASCENT Evidence & 2-File Air-Gapped Audit\nGerbil + Zero-Dep Bun/TS (<100ms) Fleet/Trust/Freshness/Pin\nCold 17/0 -> Warm 0/17 Reuse | 32 Adversarial/Interop Controls"

config -> ascentGate
config -> funflow
ascentGate -> funflow: "admitted pending frontier"
quintModels -> funflow: "runnable-flow (de-quint)"
leanModels -> funflow: "runnable-flow (de-lean-poo)"
rustSubjects -> funflow: "runnable-flow (de-source / de-oracle)"
quintModels -> rustSubjects: "MR04: itf-trace"
rustSubjects -> leanModels: "MR03: SpawnPreservesContainer"
funflow -> runtimeAdapter: "inert DAG runtime manifest"
runtimeAdapter -> evidenceSession: "pure runnable-admit records"
evidenceSession -> ascentGate: "revalidation & reuse loop"
