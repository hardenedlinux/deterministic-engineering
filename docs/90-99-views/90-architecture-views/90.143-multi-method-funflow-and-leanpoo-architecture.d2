direction: down

config: "config.ss + Yuanxu Profiles\nlanguages.{c, cpp, quint, lean, rust}\n3-axis Profiles + Band-5 governance-floor"

ascentGate: "ASCENT Governance (de.layer.governance)\nMR01 Claim-Kind Routing | MR02 Anti-Duplication\nMR03 Premise Handoff | MR04 DAG Closure\nMR05 Countermodels | MR06 OS Containment"

funflow: "Fun-Flow Control Plane (library/verification-flow/)\nZero-I/O pure Category/Arrow DAG + defrules macros\nTaskFamilyRegistry: de-quint | de-lean-poo | de-source | de-oracle\nEmits yuanxu.core.flow-dag-runtime-manifest.v1"

quintModels: "packages/quint-models (Bun / subtree)\nClaim: bounded-interleaving, fault-race, mbt-trace\nPilot: ProcessTreeReclamation.qnt (5 countermodels)"

leanModels: "packages/lean-models (Lake / LeanPoo / subtree)\nClaim: unbounded-invariant, refinement, proof-transport\nCore/{Conservation,Budget,Containment,Order,Transport}\nRefines -> ProcessTree (LinuxCgroupV2 / DarwinPgidPipe)"

rustSubjects: "languages-engineering/rust + Source Contracts\nClaim: source-memory-ub, api-ban-lint, os-sigkill-oracle\nProcessTreeGuard + Clippy ban + 4 SIGKILL Leak Controls"

runtimeAdapter: "Contained Runtime Adapter (outside library/)\nExecutes inert DAG manifest inside process-tree guard\nquint-modules-resolver | lake build | cargo + SIGKILL(137)"

evidenceSession: "Unified ASCENT Evidence Session\nlibrary/evidence/func.ss (make-resource-evidence)\nSelective M1 reuse | M3 use-time witness | open_premise"

config -> ascentGate
config -> funflow
ascentGate -> funflow: "admitted pending frontier"
quintModels -> funflow: "runnable-flow (de-quint)"
leanModels -> funflow: "runnable-flow (de-lean-poo)"
rustSubjects -> funflow: "runnable-flow (de-source / de-oracle)"
quintModels -> rustSubjects: "MR04: itf-trace"
rustSubjects -> leanModels: "MR03: SpawnPreservesContainer"
funflow -> runtimeAdapter: "inert DAG runtime manifest"
runtimeAdapter -> evidenceSession: "pure runnable-admit records"
evidenceSession -> ascentGate: "revalidation & reuse loop"
