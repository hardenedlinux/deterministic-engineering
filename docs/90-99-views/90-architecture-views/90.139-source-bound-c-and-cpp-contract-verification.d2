direction: down

parent: "Parent Library\nModels, rules and obligations"
profile: "Profile Module\nABI, macros and method bounds"
scenario: "Consumer Scenario\nReal source, callers and faults"
contracts: "Source contracts\nPre/postconditions, writes and owners"
plans: "Scheme method declarations\nTyped verification plans; no execution"
methods: "Development verification\nReal body + callers; bounded CBMC / native tests"
math: "Lean / Quint correspondence\nNumeric lemmas / state-order assumptions"
oracle: "Independent checks\nLiteral gold and actual source mutants\nOccupied refusal / self transfer"
closure: "Captured evidence inputs\nSource, harness, tools, bounds and configuration"
ascent: "ASCENT relations\nSupport, counter, pending and reuse premises"
consumer: "External consuming ecosystem\nReview and current-use authorization"
change: "Changed source or assumptions\nNew capture; retain old witnesses and frozen queries"
parent -> profile -> scenario
parent -> contracts
profile -> plans
scenario -> methods
contracts -> methods
plans -> methods
math -> oracle
methods -> oracle -> closure -> ascent -> consumer
consumer -> change -> scenario
