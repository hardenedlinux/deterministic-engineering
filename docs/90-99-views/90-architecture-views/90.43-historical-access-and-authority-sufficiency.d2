# org-target: docs/20-29-cases/20-gateway/20.17-sufficient-evidence-and-bounded-revalidation.org::#historical-access-sufficiency-packet
direction: down
classes: {
  input: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  state: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  gate: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
delivery: "HA00 / HA01 original delivery\nExact P2 / occ2 / ex2 / R2 / consumer\nGenuine completion + completion-bound access\nHistorical permitted ownership R2 established" {class: input}
answer: "HA02 / HA03 separate asked predicates\nExisting evidence sufficient for historical ownership\nCompletion versus k3 still unknown\nNo mandatory order proof for narrower question\nFrozen k3 unchanged" {class: state}
current: "HA04 / HA05 retained boundaries\nNo original-unit confirmation of P3 / sigma3\nHistorical grant not current read permission\nCurrent denied read refused; fresh use needs scope" {class: gate}
history: "AH00 / AH01 independent authority case\nAuthentic original action and covered OC1\ndeny41 -> dispatch -> consume -> complete -> allow42\nCausal order alone not complete authority coverage" {class: input}
closed: "AH02 / AH03 actual H41 and Kauth\nComplete relevant grants / exceptions / delegation\nEntire consumption interval denied\nCovered unauthorized occurrence established\nNo extra direct boundary receipt needed if policy accepts" {class: state}
limits: "AH04 / AH05 retained checks\nCoverage gap or straddled interval stays pending\nContract requiring direct receipt retains that obligation\nHistorical denial not authorization for retry\nNew subject / current use has its own guards" {class: gate}
delivery -> answer -> current
history -> closed -> limits
answer -> closed: "scoped sufficiency; independent corpora"
