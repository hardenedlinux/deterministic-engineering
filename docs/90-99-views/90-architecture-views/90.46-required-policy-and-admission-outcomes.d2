# org-target: docs/20-29-cases/20-gateway/20.18-policy-required-checks-and-evidence-admission.org::#method-admission-policy-packet
direction: down
classes: {
  input: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  state: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  gate: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
policy: "Authentic applicable requirement\nActual owner / consumer / subject / effective scope\nComplete required predicate or closed admission domain\nPreference alone creates no mandatory guard" {class: input}
order: "OP stronger historical predicate\nOwned original R2 true; before-k3 unknown\nRequired order missing: stronger answer pending\nKnown after-k3: satisfaction refused\nHistorical ownership retained" {class: gate}
record: "BR actual direct-record requirement\nH41 history retained; record missing: pending\nExplicitly forbidden substitution: offer refused\nMatching genuine record may qualify exact scope\nMissing record is not a new actual violation" {class: gate}
method: "AM genuine VAlt / exact method scope\nUnknown mapping: pending, not forbidden\nActual closed forbidden mapping: RJ06 for offer\nActual allowed mapping: scoped review support\nCompleted result retained in original scope" {class: gate}
reuse: "Current use versus reusable evidence\nFresh method / policy / source / issuer guards\nNew counter and full intake still required\nNo automatic A / positive Q / effect authority\nDE01 avoids duplicate checks without waiving policy" {class: state}
policy -> order
policy -> record
policy -> method
order -> reuse
record -> reuse
method -> reuse
