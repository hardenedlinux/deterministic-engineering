# org-target: docs/10-19-design/10-architecture/10.118-domain-property-testing-and-evidence-trajectories.org::#pbt118-packet-gold
# render-layout: elk; theme: 0; pad: 24
direction: down
title: "PB-B / PB-C full packet review\nProposed inputs and gold; no native execution" {shape: text}
input: "Existing Module / Profile / Scenario / method\nActual source, lock, property, oracle, mapping and schedule\nFinite input cut precedes observations and verdicts"
cases: {
  direction: right
  bp: "PB-BG00-09\nCPU holds X1 at capacity one\nCaller detaches; required reservation released\nClosed failing prefix can refute BP-PBT01\nCleanup completeness is a separate duty"
  bc: "PB-CG00-12\nF1 cancelled -> F2 generation registered\nFinal strong Sender drop completes\nExplicit poll supports readiness only\nScoped BC-PBT05/N-C0 counter needs reviewed fence + full coverage\nExisting / coalesced / delivered wake opportunities must be checked\nParent liveness remains a separate question"
}
validation: "Independent ledger / history / protocol oracles\nOV01-07: ordering, ownership, inventory and negative controls\nAbsent evidence or timeout alone -> undetermined"
witness: "Original O/T/V/W + genuine admitted association\nKeep input identity, property and source cut\nNo semantic truth from strings or JSON"
shrink: "PB-BS01-05 / PB-CS01-06\nCheck enabledness, identities, failure predicate and causal edges\nNew reduced cut + actual replay + original-witness link\nBS04: releasing CPU after a closed failure may preserve it\nWrong failure or missing decisive facts cannot replace original"
old: "Existing ASCENT relation gold RG01-05\nMatched scope + witness_input + checked association\nCounter can coexist with pending\nSupport + counter can make pending false; not counter-free readiness"
change: "CH-B01 / CH-C01-03\nNew source, oracle, mapping or distribution -> new target use\nRaw/reduced queries keep exact expected role sets\nPreserve original witness and old frozen query"
fresh: "RG06-07\nMismatch blocks old witness at new usage\nFresh replay/campaign may give bounded new-source support\nOld-failure disposition and broader duties remain separate"
late: "CH-L01 / RG08 / PC08\nLate result binds original run and cut\nNew event/query-view occurrence only\nNew historical capture and current review occurrence\nRecheck relevance and opposing inventory; no frozen-view mutation"
review: "Existing Aitia / LLM-based AI agent workflow\nPC01-08 traced to packet/shrink/oracle/change gold\nFocused BS04 / CG08 / RG08 view90.103\nRetain unresolved counter and pending duties\nReuse definitions/proofs/corpus only within checked premises"
title -> input: {style.opacity: 0}
input -> cases
cases.bp -> validation
cases.bc -> validation
validation -> witness: "Qualified property result"
validation -> review: "Incomplete method/observation remains pending" {style.stroke-dash: 4}
witness -> shrink: "Reduction creates a new witness"
witness -> old
shrink -> old: "Separate capture/query and exact role comparison"
old -> change -> fresh -> review
old -> late -> review
