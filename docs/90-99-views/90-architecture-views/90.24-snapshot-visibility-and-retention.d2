# org-target: docs/20-29-cases/20-gateway/20.07-packet-query-and-history-fixtures.org::#late-intake-visibility
# Fixture causal visibility and retained evidence, not a global distributed clock or new storage framework.
direction: down
classes: {
  cut: {style: {fill: "#EAF2FF"; stroke: "#315B8A"; border-radius: 10; font-size: 17}}
  retained: {style: {fill: "#E6F5F3"; stroke: "#19756C"; border-radius: 10; font-size: 17}}
  boundary: {style: {fill: "#FFF2DD"; stroke: "#9B6C25"; border-radius: 10; font-size: 17}}
}
capture: "k0 / Pfx0: t0 captures X0 / S0 / P0\nB0 records, original TL / VL0 / A0\nFrozen input roots precede usage judgments" {class: cut}
frozen: "Frozen O0 snapshot read, even after kLate\nP0 support only o+; L0 support oL\nNo oLate; Pfx0 and old gold never edited" {class: cut}
publish: "Publish Xsrc / S1 at kSrc.open\nM0 text retained; actual source differs\nOwn immutable current input / gold / closure" {class: cut}
current: "OS-open corpus {oL}\nL0 support; Psrc unknown\nOld RLate cannot be relabeled Psrc" {class: boundary}
intake: "kLate / new prefix PfxLate\nRecord RLate / ELate / oLate / TLate\nt0 captured k0; journal observation recorded kLate\nProducer completion cut unknown without its receipt\nVLate absent; no backfill into Pfx0" {class: cut}
history: "Fresh historical owner OH-late\nKnowledge about S0 as recorded at kLate\nP0 raw support o+ and oLate\nTwo reports are not independent proof" {class: retained}
impact: "BQ06: changed source / parameter / cache scope\nWithdraw exact affected present-use qualification\nUnknown footprint remains conservative / pending" {class: boundary}
store: "Retained record / body assertions\nH0 subset H1; original IDs / bodies preserved\nRL / EL / TL / VL0 / old A and gold stay historical\nInvalidation issues no deletion instruction" {class: retained}
usage: "Fresh usage and external T-use binding\nSame retained EL / TL; new target / cut / owner\nEL origin remains k0; no native T extension" {class: retained}
transfer: "Checked new-target transfer only if justified\nGenuine application / frame / SC / method / policy\nLaw trust changes can block reuse despite same bytes\nActual A / authorization / Host receipts still separate" {class: boundary}
capture -> frozen: "immutable captured corpus and body"
capture -> publish: "explicit fixture causal order"
publish -> current: "new current source view"
publish -> intake: "later immutable result intake"
intake -> history: "new knowledge at new history prefix"
publish -> impact: "source change; cap/cache branches have their own dependencies"
impact -> store: "withdraw use, preserve underlying records"
intake -> store: "append new intake; never overwrite old snapshot"
store -> usage: "readable retained bytes are only one premise"
usage -> transfer: "check all target and current-cut obligations"
