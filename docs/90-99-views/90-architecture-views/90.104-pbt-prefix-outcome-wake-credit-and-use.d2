# org-target: docs/10-19-design/10-architecture/10.118-domain-property-testing-and-evidence-trajectories.org::#pbt118-outcome-use-packets
# render-layout: elk; theme: 0; pad: 24
direction: down
title: "Closed prefix / wake opportunity / actual use\nProposed input packets and gold; no native execution" {shape: text}
selection: "Existing Module / Profile / Scenario / method and Evidence owners\nActual subjects, typed claims, exact role closure and selected policy"
packets: {
  direction: right
  prefix: {
    label: "BS04-G07 / PT-G00-10"
    input: "F-E at synchronized frontier H-PT\nLater teardown hits fixed watchdog\nExecution and semantic prefix have separate identities"
    validate: "Applicable prefix method + actual O/T/V/admission\nFull-report checker cannot accept a truncated report\nMissing method/closure -> raw candidate, pending"
    outcomes: "Qualified prefix counter may survive\nOriginal run stays failed/incomplete\nShrink/campaign/cleanup/isolation acceptance stays separate"
    reuse: "Later cleanup does not erase prior failure\nLate pre-frontier facts need causal/closure re-evaluation\nObserver conflict suspends affected interpretation\nNo worker reuse without real isolation/reset evidence"
    input -> validate -> outcomes -> reuse
  }
  wake: {
    label: "CG08-G05 / WO-G00-10"
    input: "Eligible F2 / task / runtime generation\nCredit and publication/delivery/consumption graph\nReviewed finite BC-PBT05/N-C0"
    validate: "Existing/merged credit may supply one opportunity\nValid delivered-and-consumed opportunity survives an empty queue\nConsumed-before-close or wrong generation does not transfer"
    outcomes: "Finite opportunity support only after validation\nActual Closed / erroneous Pending are separate results\nNo all-schedule or unbounded progress conclusion"
    reuse: "Callback counts cannot certify a runnable task\nUnknown mapping stays pending, not negative evidence\nCancel/delivery occurrence differs from log arrival\nChanged generation/scheduler/order needs new validation"
    input -> validate -> outcomes -> reuse
  }
  use: {
    label: "RG08-G10 / UP-G00-11"
    input: "R2 / frozen P2 -> tentative preflight\nRelevant L2 accepted before actual use -> P3\nActor, target, policy and effect boundary explicit"
    validate: "Compare required actual basis at use\nWhole-prefix policy needs fresh P3 association\nRelevant-family reuse requires qualified unchanged-scope proof"
    outcomes: "Stale P2 use is refused/pending\nNew R3 rechecks affected complete opposing set\nUnsupported compare-and-effect capability stays open"
    reuse: "Frozen R2 remains historical\nUnaffected support/proofs can be reused with checked premises\nCommitted effect stays observed while authority is assessed\nLater review cannot retrospectively authorize prior effects"
    input -> validate -> outcomes -> reuse
  }
}
joined: "Existing ASCENT relations explain matching support/counter/pending\nLifecycle, review and actual enforcement remain distinct duties\nFocused late-event / executed-effect detail: view90.105\nNo query row or timeout creates current authority"
agent: "LLM-based AI agent / existing Aitia and receiver workflow\nPreserve raw history; choose only supported methods\nRevalidate changed dependencies; retain unaffected qualified evidence"
title -> selection: {style.opacity: 0}
selection -> packets.prefix.input
selection -> packets.wake.input
selection -> packets.use.input
packets.prefix.reuse -> joined
packets.wake.reuse -> joined
packets.use.reuse -> joined
joined -> agent
