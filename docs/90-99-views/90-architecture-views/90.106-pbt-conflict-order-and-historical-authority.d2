# org-target: docs/10-19-design/10-architecture/10.118-domain-property-testing-and-evidence-trajectories.org::#pbt118-conflict-order-audit-packets
# render-layout: elk; theme: 0; pad: 24
direction: down
title: "Observation conflict / unknown order / historical authority\nPaper input packets and gold only; no native execution" {shape: text}
input: "Existing POO / Evidence / ASCENT / review owners\nActual source, typed property/policy, origin and captured occurrence\nNew result inputs precede their own output; frozen history is retained"
packets: {
  direction: right
  conflict: {
    label: "LC-G07 / OC-G00-11"
    basis: "Held H0 versus disposal D0\nRun / generation / observation-or-hypothesis / exchange binding\nActual relevant-challenge and eligibility policy"
    cases: "Invalid/unrelated allegation -> refuse association\nAccepted but unvalidated challenge -> scoped policy review\nGenuine conflict -> actual owner decides affected eligibility\nNo arrival-time or duplicate-vote truth rule"
    result: "Fresh eligible association set / current query\nRaw fail without checked is not qualified counter/t_use\nActual S1/S2 validity governs new current use\nOnly transitive dependent uses are reassessed\nCounter disappearance is not safety or readiness"
    basis -> cases -> result
  }
  order: {
    label: "CW-G09 / PO-G00-12"
    basis: "Observed G<F, G<K, F<D, K<D\nUnknown K/F is not proven concurrency\nActual selected waiver/retained-duty Contract"
    cases: "Waiver: G,K,F,D versus G,F,K,D can disagree -> pending\nIndependent G<D<K and D<F -> useful finite support\nAll completions agree only with sound complete reasoning\nEmpty / cut-off / unsound history set proves nothing"
    result: "Question-specific pending and scoped results\nHistorical confirmation needs actual old occurrence references\nNew replay cannot establish an old missing edge\nNo assumed ASCENT scheduler or universal liveness proof"
    basis -> cases -> result
  }
  audit: {
    label: "EX-G06 / HA-G00-13"
    basis: "Actual E2 and policy effective then\nG-old issuer, scope, pre-existence and as-of validity\nRequired prior presentation/checking occurrences"
    cases: "Standing grant can suffice only if historical policy permits\nRequired prior validation must actually have existed\nLater V-audit is not V-old or a backdated grant\nOne valid permitted path need not enumerate unrelated routes"
    result: "New bounded historical confirmation or pending/refusal\nStale R2 finding and provider enforcement remain separate\nMissing prior roles stay pending unless genuinely recovered\nHistorical confirmation grants no new effect authority"
    basis -> cases -> result
  }
}
closure: "Exact reference / dependency and validity comparison\nFresh checked use; authorized review/eligibility handoff\nFocused suspension / historical-order / prior-act detail: view90.107\nNo new conflict engine, authority service or atomic primitive"
agent: "LLM-based AI agent / existing Aitia and receiver workflow\nAcquire missing evidence only for affected questions\nReuse unchanged qualified material under matching premises\nNative authenticity / analysis / enforcement gates remain open"
title -> input: {style.opacity: 0}
input -> packets.conflict.basis
input -> packets.order.basis
input -> packets.audit.basis
packets.conflict.result -> closure
packets.order.result -> closure
packets.audit.result -> closure
closure -> agent
