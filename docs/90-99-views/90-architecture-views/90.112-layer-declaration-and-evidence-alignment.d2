direction: down
title: "Native declarations across existing engineering owners" {shape: text}
authored: {
  direction: right
  library: "Organization Library\nNamed methods / published requirements\nReferences follow effective methods"
  profile: "Independent Profiles and proposals\nDerived workload / retained base factors\nDemand never copies itself into coverage"
  scenario: "Native Scenario composition values\nEffective Library / domain / engine / evidence\nCaptured old fields removed"
}
projection: "Pure transformations at existing owners\nDeclaration -> typed source rows\nQNT finite coverage lookup / relation assembly"
effects: "Existing effect and admission boundaries\nQuint process + independent BFS / ITF oracles\nFile checks / native exchange / Session replacement"
queries: "Actual native ASCENT queries\nNew demand -> gap; new rule -> pending\nReal pass -> support; changed basis -> mismatch\nActual counter -> counter + pending"
controls: "LA01-LA05 / EV01-EV09\nOld values and frozen results remain unchanged\nRepeated registration retains two witnesses\nChanged source refuses; original bytes permit revalidation"
retained: "Retained owners\nAitia history / accepted prefix / revocation / recovery\nCurrentness on both sides of I/O\n2 GiB heap / 180-second build / 120-second test file"
