        },
        "icons": {
          "model": "model",
          "composition": "selection",
          "themes": "library",
          "icons": "reference",
          "export": "document",
          "layout": "model",
          "host": "capture"
        },
        "roles": {
          "themes": "publication",
          "icons": "selection",
          "host": "capture",
          "model": "external",
          "layout": "external"
        }
      }
    ]
  },
  "variants": [
    {
      "name": "sketchbook",
      "themes": [
        "sketchbook",
        "ember",
        "compact",
        "layered-down"
      ]
    }
  ]
}
|
}}}
model: "Model adapters\nOfficial D2 / OpenSysML observations"
composition: "Pure composition\ncomposeFigure / composeHeading / composeDiagram"
themes: "Visual resources\nStyle + palette + type + density + role markers"
icons: "SVG assets\nReplaceable domain icons and surfaces"
export: "Browser export effect\nFonts / actual bounds / SVG / PNG / receipt"
layout: "ELK layout\nMeasured node and label boxes"
host: "Host project\nSource acquisition and explicit writes"
composition -> model: reads captured model
composition -> themes: selects visual layers
composition -> icons: selects assets
export -> composition: consumes composed HTML
export -> layout: delegates geometry
host -> model: captures inputs
host -> export: requests image export
