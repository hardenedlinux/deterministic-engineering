    "heading": "packages/render/src/heading.ts",
    "measurement": "packages/render/src/scene-export.ts",
    "export": "packages/render/src/export.ts"
  },
  "basis": {
    "captureRef": "design-candidate:functional-render",
    "modelRefs": [],
    "obligationRefs": [
      "docs/10-19-design/10-architecture/10.144-functional-themes-layouts-and-package-examples.org"
    ],
    "evidenceRefs": []
  },
  "copy": {
    "description": "Architecture dependencies; arrows point to the capability consumed.",
    "status": "Static rendering facts only \u00b7 source-bound Questions \u00b7 no C/Q/R or model publication"
  },
  "themes": [
    "sketchbook",
    "compact"
  ],
  "icons": [
    "engineering"
  ],
  "presentation": {
    "scenes": [
      {
        "graph": {
          "id": "functional-composition",
          "children": [
            {
              "id": "model"
            },
            {
              "id": "composition"
            },
            {
