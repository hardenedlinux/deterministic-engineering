# Component dependencies, not execution order.
vars: {d2-config: {data: {figure: |json
{
  "title": "Functional rendering: independent owners and replaceable resources",
  "purpose": "architecture",
  "kind": "render-composition",
  "language": "en",
  "width": 1440,
  "primary": "boundaries",
  "questions": [
    {
      "ref": "boundaries",
      "text": "What can a downstream project compose without replacing model or layout semantics?",
      "focusRefs": [
        "source",
        "theme",
        "heading",
        "measurement",
        "export"
      ]
    }
  ],
  "references": {
    "source": "docs/90-99-views/90-architecture-views/90.137-functional-render-composition.d2",
