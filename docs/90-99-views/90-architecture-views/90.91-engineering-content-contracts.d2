# org-target: docs/10-19-design/10-architecture/10.31-architecture-document-and-decision-contracts.org::#engineering-content-contracts
# render-layout: elk; theme: 0; pad: 24; timeout: 30
direction: down
library: "Library publishes\nNative contract metadata + content duties\nExpected native Contracts and supported methods"
profile: "Independent Profile selects\nReview stage / viewpoints / product roles\nRequired policy retained; no document-body copies"
content: {
  label: "DE-CASE-01 actual project content / design-level identities"
  model: "Architecture model\nDE-AM01 actual / DE-AM02 target\nElements, relations, allocation and omissions"
  org: "Org document products\nD01-D10 roles bound to actual sections\nSemantic owners + D2 sources + SVG"
  decisions: "Decision records\nDE-D01-D05 concerns / alternatives / rationale\nConsequences, triggers and supersession"
}
capture: "Scenario captures one use\nTrusted required inventory + actual content closure\nRepo, policy, revisions, sources, mappings and evidence"
duties: "DE-O-ARCH / DOC / DEC / TRACE / REVIEW\nRequirement, subject and method associations\nDeclared per-duty input roles"
observer: "Proposed project observers / adapters\nNative structure + mechanical checks + semantic review\nCurrent inputs and issued scoped results"
ascent: "Existing ASCENT owner\nExplicit rules and admitted evidence projections\nApplicability; support, counter, pending and conflicts"
aitia: "Existing Aitia owners\nExact stage / policy / artifact inventory\nFresh review required; delivery remains separate"
views: "Org and paired D2/SVG\nExplain actual query and identified relations\nAuthored state is not evidence or disposition"
library -> duties: publishes meanings
library -> capture: expected Contracts
profile -> capture: selected policy
content.model -> capture: actual content
content.org -> capture: actual content
content.decisions -> capture: actual content
capture -> duties: bind occurrence and required set
capture -> observer: same captured use {
  style.stroke-dash: 4
}
duties -> observer: supported questions {
  style.stroke-dash: 4
}
observer -> ascent: checked evidence projection {
  style.stroke-dash: 4
}
ascent -> aitia: evidence and gaps through project adapter {
  style.stroke-dash: 4
}
ascent -> views: query explanation {
  style.stroke-dash: 4
