;;; -*- Gerbil -*-
;;; Existing ASCENT intake -> native Aitia content and disposition requests.
;;; Completeness is bounded to the host-selected exchange, never global discovery.
(import :clan/poo/object :std/list/list :std/encoding/json
        (only-in :std/misc/ports read-all-as-u8vector)
        (only-in :std/crypto/digest sha256) (only-in :std/encoding/hex hex-encode)
        :yuanxu/contribution/verification
        :agentic-ai-lab/modules/ai-agentic-context/clue-exchange :agentic-ai-lab/modules/temporal-causality/trajectory/ascent-ledger
        :agentic-ai-lab/lambda-aitia/modules/sdlc/objects
        :agentic-ai-lab/lambda-aitia/modules/sdlc/standards/nasa-review
        :agentic-ai-lab/lambda-aitia/modules/sdlc/standards/nasa-lifecycle
        :deterministic-engineering/library/concurrency/resource-control/backpressure-memory/rust/reassessment-oracle
        "./func.ss")
(export open-backpressure-history open-backpressure-histories make-backpressure-reassessment reassessment-stage
        reassessment-verify-context reassessment-verify-content reassessment-verify-disposition)
(def claim "SWE-061/p1/permit-lifecycle-history")
(def (load-json path) (call-with-input-file path (cut read-json <> object-as-hash: #t)))
(def (clone value) (call-with-input-string (json->string value) (cut read-json <> object-as-hash: #t)))
(def (load-bound-json path expected)
  (def bytes (call-with-input-file path read-all-as-u8vector))
  (def actual (hex-encode (sha256 bytes)))
  (when (and expected (not (equal? actual expected))) (error "bound metadata changed" path))
  (list (call-with-input-string (utf8->string bytes) (cut read-json <> object-as-hash: #t)) actual))
(def (dependency-map pairs)
  (def result (make-hash-table))
  (for-each (lambda (pair)
    (def prior (hash-ref result (car pair) #f))
    (when (and prior (not (equal? prior (cadr pair)))) (error "conflicting dependency binding"))
    (hash-put! result (car pair) (cadr pair))) pairs)
  result)
(def (bound-source-bundle path checked)
  (map (lambda (p) (or (hash-ref checked p #f)
                        (hash-ref checked (path-normalize p))))
    (list path (path-expand "../Cargo.toml" (path-directory path))
               (path-expand "../Cargo.lock" (path-directory path)))))
(def (digest-text text) (hex-encode (sha256 (string->utf8 text))))
(def (source-bundle path)
  (map review-file-digest (list path
    (path-expand "../Cargo.toml" (path-directory path))
    (path-expand "../Cargo.lock" (path-directory path)))))
(def (same-set? a b)
  (and (= (length a) (length b)) (= (length a) (length (delete-duplicates/hash a)))
       (every (lambda (x) (and (member x b) #t)) a)))
(def (assert-files pairs)
  (def buffer (make-u8vector 65536))
  (def unique (make-hash-table))
  (for-each (lambda (p)
    (def prior (hash-ref unique (car p) #f))
    (when (and prior (not (equal? prior (cadr p)))) (error "conflicting reassessment input"))
    (hash-put! unique (car p) (cadr p))) pairs)
  (hash-for-each (lambda (path digest)
    (unless (equal? (review-file-digest (review-reference-path path digest) buffer: buffer) digest) (error "reassessment input changed" path))) unique)
  unique)
;; One producer-private pure baseline derivation, never intake or authority state.
;; Every caller first completes audit-backpressure-content's full byte check.
(def completed-baseline-entries #f)
(def (derive-baseline-entries baseline checked)
  (def report (car (load-bound-json (.ref baseline 'report) (.ref baseline 'report-digest))))
  (def original (map (lambda (row)
    (def observation (hash-ref row "observation"))
    (def record-path (hash-ref row "recordPath"))
    (def review (car (load-bound-json (hash-ref row "reviewPath") (hash-ref checked (hash-ref row "reviewPath")))))
    (def oracle (hash-ref review "oracle"))
    (def method (hash-ref observation "method"))
    (def native? (equal? method "native"))
    (def raw (and native? (find (lambda (p) (string-contains (car p) "/observations.json")) (hash-ref observation "artifacts"))))
    (hash ("id" (hash-ref row "id")) ("recordPath" record-path) ("recordSha256" (hash-ref checked record-path))
          ("outcome" (hash-ref observation "outcome"))
          ("case" (if native? (hash-ref oracle "case") method))
          ("payloadBytes" (if raw (hash-ref (car (load-bound-json (car raw) (hash-ref checked (car raw)))) "payloadBytes") 0))
          ("sourceSha256" (if native?
            (cadr (or (find (lambda (p) (string-contains (car p) "/src/main.rs")) (hash-ref observation "inputs"))
                      (error "historical source binding absent"))) "non-native"))
          ("sourceBundle" (if native?
            (bound-source-bundle (car (find (lambda (p) (string-contains (car p) "/src/main.rs")) (hash-ref observation "inputs"))) checked) '()))
          ("diagnostic" (and (equal? method "quint") (equal? (hash-ref observation "outcome") "fail")))
          ("dependencies" (append (hash-ref observation "inputs") (hash-ref observation "artifacts"))))) (hash-ref report "results")))
  original)
(def (baseline-entry-record baseline checked)
  (def prior completed-baseline-entries)
  (def dependencies (.ref baseline 'dependencies))
  (if (and prior (equal? (.ref baseline 'report) (vector-ref prior 0))
                 (equal? (.ref baseline 'report-digest) (vector-ref prior 1))
                 (equal? dependencies (vector-ref prior 2)))
    prior
    (let* ((entries (derive-baseline-entries baseline checked))
           (keys (map (lambda (entry) (cons entry
             (digest-text (json->string (hash-ref entry "dependencies"))))) entries))
           (record (vector (string-copy (.ref baseline 'report))
                     (string-copy (.ref baseline 'report-digest))
                     dependencies entries keys)))
      (set! completed-baseline-entries record) record)))
(def (open-backpressure-history acceptance sources)
  (history-from-baseline (audit-backpressure-content acceptance 'caller-owned) sources))
;; A single input epoch constructs independent native state owners. The baseline
;; presentation stays private; no currentness verdict or caller-supplied proof is
;; accepted, and every actual use still validates the complete current closure.
(def (open-backpressure-histories acceptance sources count)
  (unless (and (integer? count) (exact? count) (> count 0)) (error "positive history count required"))
  (def baseline (audit-backpressure-content acceptance 'caller-owned))
  (def histories
    (let loop ((remaining count) (result '()))
      (if (= remaining 0) (reverse result)
        (loop (- remaining 1) (cons (history-from-baseline baseline sources) result)))))
  (assert-files (.ref baseline 'dependencies))
  histories)
(def (history-from-baseline baseline sources)
  (def selected-sources (load-json sources))
  (def source-seal (review-file-digest sources))
  (def captured (make-hash-table))
  ;; Dependencies are privately owned per exact run closure, not cloned once per
  ;; case. Callers still receive deep copies through entry; no path/stat cache.
  (def dependency-sets (make-hash-table))
  (def (own-entry entry (prepared-key #f))
    (def dependencies (hash-ref entry "dependencies"))
    (def key (or prepared-key (digest-text (json->string dependencies))))
    (def owned (hash-ref dependency-sets key #f))
    (when (and owned (not (equal? owned dependencies)))
      (error "history dependency identity collision"))
    (unless owned
      (set! owned (clone dependencies))
      (hash-put! dependency-sets key owned))
    (def result (make-hash-table))
    (hash-for-each (lambda (name value)
      (unless (equal? name "dependencies") (hash-put! result name (clone value)))) entry)
    (hash-put! result "dependencies" owned)
    result)
  (def trajectory (hash-ref (ascent-trajectory (hash ("action" "open")
    ("task" "backpressure-history-reassessment") ("sourceIdentity" (.ref baseline 'report-digest)))) "trajectory"))
  (def (check-host!)
    (unless (equal? source-seal (review-file-digest sources)) (error "history source manifest changed"))
    (assert-files (hash-ref selected-sources "files")))
  (def history-exchange
    (open-trajectory-clue-exchange trajectory
      (lambda (id digest source context)
        (def entry (hash-get captured id))
        (and entry (equal? source (hash-ref entry "recordPath"))
             (equal? (review-file-digest source) (hash-ref entry "recordSha256"))
             (string-append "sha256:" (hash-ref entry "recordSha256")))) source-seal))
  (def (register! entries checked (dependency-keys '()))
    (check-host!)
    ;; This private set comes only from the completed byte audit in this same
    ;; registration operation. Check coverage; do not repeat the full file scan.
    (for-each (lambda (entry)
      (for-each (lambda (pair)
        (unless (equal? (hash-ref checked (car pair) #f) (cadr pair))
          (error "entry dependency was not checked" (car pair))))
        (hash-ref entry "dependencies"))) entries)
    (def checked-records (make-hash-table))
    (def pending-ids (make-hash-table))
    ;; Reject every duplicate and changed record before provisioning any row.
    ;; ASCENT still owns attestation and generation-bound publication.
    (for-each (lambda (entry)
      (def id (hash-ref entry "id"))
      (when (or (hash-key? captured id) (hash-key? pending-ids id))
        (error "history id already registered" id))
      (hash-put! pending-ids id #t)
      (def path (hash-ref entry "recordPath"))
      (def expected (hash-ref entry "recordSha256"))
      (def prior (hash-ref checked-records path #f))
      (unless (equal? (or prior (review-file-digest path)) expected)
        (error "history record differs"))
      (hash-put! checked-records path expected)) entries)
    (def rows (map (lambda (entry)
      (def id (hash-ref entry "id"))
      (def prepared (assq entry dependency-keys))
      (hash-put! captured (string-copy id) (own-entry entry (and prepared (cdr prepared))))
      (hash ("id" (string-copy id)) ("claim" (string-copy claim)) ("role" "observation")
            ("polarity" (if (equal? (hash-ref entry "outcome") "fail") "counter" "support"))
            ("source" (string-copy (hash-ref entry "recordPath"))) ("factors" '()) ("links" '()))) entries))
    (history-exchange 'submit rows (hash-ref (history-exchange 'snapshot) "generation")))
  (def baseline-checked (dependency-map (.ref baseline 'dependencies)))
  (def baseline-record (baseline-entry-record baseline baseline-checked))
  (def original (vector-ref baseline-record 3))
  (register! original baseline-checked (vector-ref baseline-record 4))
  (def registration-batches 0) (def logical-dependency-references 0)
  (def checked-dependency-paths 0)
  (def (prepare-run path bound-run checked)
    (def run (car bound-run)) (def record-sha (cadr bound-run))
    (unless (and (equal? (hash-ref run "schema") "rust.backpressure-source-reassessment/v1")
                 (= (hash-ref run "exit") 0)
                 (equal? (hash-ref checked (hash-ref run "source") #f) (hash-ref run "sourceSha256"))
                 (assoc (hash-ref run "source") (hash-ref run "dependencies"))
                 (assoc (hash-ref run "observations") (hash-ref run "dependencies")))
      (error "unbound native reassessment run"))
    (def gold (backpressure-reassessment-oracle
      (car (load-bound-json (hash-ref run "observations") (hash-ref checked (hash-ref run "observations"))))))
    (def bundle (bound-source-bundle (hash-ref run "source") checked))
    (def entries (map (lambda (g)
      (hash ("id" (string-append record-sha "/" (hash-ref g "case")))
            ("recordPath" path) ("recordSha256" record-sha)
            ("outcome" (hash-ref g "outcome")) ("case" (hash-ref g "case"))
            ("payloadBytes" (hash-ref g "payloadBytes")) ("diagnostic" #f)
            ("sourceSha256" (hash-ref run "sourceSha256")) ("sourceBundle" bundle) ("dependencies" (hash-ref run "dependencies")))) gold))
    (def dependency-key (digest-text (json->string (hash-ref run "dependencies"))))
    (list entries (map (lambda (entry) (cons entry dependency-key)) entries)))
  (def (add-history-runs! paths)
    (unless (and (pair? paths) (every string? paths)
                 (= (length paths) (length (delete-duplicates/hash paths))))
      (error "registration batch requires distinct run paths"))
    (def bound-runs (map (lambda (path) (load-bound-json path #f)) paths))
    (def references (append-map (lambda (bound) (hash-ref (car bound) "dependencies")) bound-runs))
    ;; The private map is created by this complete byte check, never supplied by
    ;; the caller or retained as a currentness verdict across operations.
    (def checked (assert-files references))
    (def prepared (map (lambda (path bound) (prepare-run path bound checked)) paths bound-runs))
    (def groups (map car prepared))
    (register! (append-map identity groups) checked (append-map cadr prepared))
    (check-host!)
    (set! registration-batches (+ registration-batches 1))
    (set! logical-dependency-references (+ logical-dependency-references (length references)))
    (set! checked-dependency-paths (+ checked-dependency-paths (hash-length checked)))
    groups)
  (def (add-history-run! path) (car (add-history-runs! (list path))))
  (def (history-registration-stats)
    (let ((selected-batches registration-batches) (selected-logical logical-dependency-references)
          (selected-checked checked-dependency-paths))
      (.o batches: selected-batches logical-dependency-references: selected-logical
          checked-dependency-paths: selected-checked)))
  ;; ASCENT owns query evaluation. Only union registration is reused by the
  ;; cross-intake consumer; every capture obtains an actual native query.
  (def queries 0)
  (def (capture-value)
    (def snapshot (history-exchange 'snapshot))
    (def view (history-exchange 'query claim))
    (def failures (filter (lambda (row) (equal? (hash-ref row "polarity") "counter")) (hash-ref snapshot "clues")))
    (unless (and (null? (hash-ref view "unavailable"))
                 (same-set? (map (cut hash-ref <> "id") failures)
                            (map cadr (hash-ref view "counterevidence")))) (error "history unavailable or incomplete attestation"))
    (set! queries (+ queries 1))
    (clone (list snapshot view)))
  (def (capture-history) (check-host!) (capture-value))
  (def (capture-current-history!) (current-files!) (capture-value))
  (def (history-capture-stats)
    (let ((selected-queries queries) (selected-entries (hash-length captured))
          (sets (hash-length dependency-sets))
          (owned-items (apply + (map length (hash-values dependency-sets))))
          (logical-items (apply + (map (lambda (e) (length (hash-ref e "dependencies"))) (hash-values captured)))))
      (.o queries: selected-queries entries: selected-entries dependency-sets: sets
          owned-dependency-items: owned-items logical-dependency-items: logical-items)))
  (def (entry-reference id)
    (def entry (or (hash-get captured id) (error "unknown history evidence" id)))
    (let ((selected-id (string-copy id)) (selected-path (string-copy (hash-ref entry "recordPath")))
          (selected-digest (string-copy (hash-ref entry "recordSha256")))
          (selected-case (string-copy (hash-ref entry "case")))
          (selected-outcome (string-copy (hash-ref entry "outcome")))
          (selected-bundle (map string-copy (hash-ref entry "sourceBundle")))
          (selected-diagnostic (hash-ref entry "diagnostic")))
      (.o identity: selected-id path: selected-path digest: selected-digest
          case: selected-case outcome: selected-outcome source-bundle: selected-bundle diagnostic?: selected-diagnostic)))
  (def (find-entry id) (clone (or (hash-get captured id) (error "unknown history evidence" id))))
  (def (current-files!)
    (check-host!)
    (def paths (make-hash-table))
    (for-each (lambda (pair) (hash-put! paths (car pair) (cadr pair))) (.ref baseline 'dependencies))
    (for-each (lambda (entry)
      (for-each (lambda (pair)
        (def prior (hash-ref paths (car pair) #f))
        (when (and prior (not (equal? prior (cadr pair)))) (error "conflicting history dependency"))
        (hash-put! paths (car pair) (cadr pair))) (hash-ref entry "dependencies"))) (hash-values captured))
    (assert-files (map (lambda (p) (list p (hash-ref paths p))) (hash-keys paths))))
  (def observation-sequence 0)
  (def last-observation #f)
  (def (observe-history! digest)
    (unless (equal? digest last-observation)
      (set! observation-sequence (+ observation-sequence 1))
      (ascent-trajectory (hash ("action" "append") ("trajectory" trajectory)
        ("event" (hash ("id" (string-append "discovery/" (number->string observation-sequence)))
          ("kind" "evidence") ("sourceIdentity" (.ref baseline 'report-digest))
          ("resultReference" (string-append "sha256:" digest)) ("pathIdentity" "cross-intake-discovery")))))
      (set! last-observation (string-copy digest))))
  (def source-path (string-copy sources))
  (def captured-source-seal (string-copy source-seal))
  (.o current-capture!: capture-current-history! reference: entry-reference capture-stats: history-capture-stats
      observe!: observe-history! exchange: history-exchange capture: capture-history
      add-run!: add-history-run! add-runs!: add-history-runs! registration-stats: history-registration-stats
      entry: find-entry current!: current-files! source-current!: check-host!
      sources: source-path source-seal: captured-source-seal))

(def (failure-ids history-cut)
  (map (cut hash-ref <> "id")
    (filter (lambda (row) (equal? (hash-ref row "polarity") "counter")) (hash-ref (car history-cut) "clues"))))
(def (make-backpressure-reassessment history profile source-path
                                    failures: (declared #f) dispositions: (dispositions '()))
  (unless (and (eq? (.ref profile 'identity) 'backpressure-coding-method/v1)
               (equal? (.ref profile 'subject) "rust.backpressure-lifecycle")
               (eq? (.ref profile 'software-class) 'a)
               (member (.ref profile 'scope) '("bounded-permit-method/M04-M06" "bounded-permit-method/M04")))
    (error "unsupported reassessment policy or scope"))
  (def history-cut ((.ref history 'capture)))
  (def expected (failure-ids history-cut))
  (def complete? (same-set? (or declared expected) expected))
  ;; Construction binds a descriptive native capture. It is not content
  ;; issuance or current-use authority; those retain their separate checks.
  (def selected-bundle (source-bundle source-path))
  (def source-digest (car selected-bundle))
  (def selected-scope (.ref profile 'scope))
  (def revision (.ref profile 'revision))
  (def subject (.ref profile 'subject))
  (def project (sdlc-project subject revision selected-scope #t))
  (def context-request (nasa-context-request project 'a (.ref profile 'context)))
  (def packet (json->string (hash ("schema" "aitia.backpressure-reassessment/v1")
    ("policy" "backpressure-coding-method/v1") ("subject" subject) ("revision" revision) ("scope" selected-scope)
    ("source" source-path) ("sourceSha256" source-digest) ("sourceBundle" selected-bundle) ("history" (car history-cut))
    ("viewIdentity" (hash-ref (cadr history-cut) "viewIdentity")) ("view" (cadr history-cut))
    ("consumerSources" (.ref history 'sources)) ("consumerSourcesSha256" (.ref history 'source-seal)) ("failures" (or declared expected))
    ("dispositions" (map (lambda (d) (list (.ref d 'failure) (.ref d 'repair))) dispositions)))))
  (def evidence (nasa-verifiable-evidence (nasa-criterion-evidence "BP061-reassessment" project "SWE-061" "SWE-061/p1"
      "independent-ownership-cut-oracle/v1" 'pass) (digest-text packet)))
  (def content-request (nasa-evidence-request evidence))
  (def (bound-current? captured-cut)
    (and (equal? selected-bundle (source-bundle source-path))
         (equal? (list subject revision selected-scope)
                 (map (cut .ref profile <>) '(subject revision scope)))
         (equal? (hash-ref (cadr captured-cut) "viewIdentity")
                 (hash-ref (cadr history-cut) "viewIdentity"))))
  (def (current? (full? #t))
    (with-catch (lambda (_) #f) (lambda ()
      (bound-current? ((.ref history (if full? 'current-capture! 'capture)))))))
  (def (covers? failure repair)
    (and (not (hash-ref failure "diagnostic"))
         (equal? (hash-ref failure "outcome") "fail") (equal? (hash-ref repair "outcome") "pass")
         (equal? (hash-ref failure "case") (hash-ref repair "case"))
         (= (hash-ref failure "payloadBytes") (hash-ref repair "payloadBytes"))
         (not (equal? selected-bundle (hash-ref failure "sourceBundle")))
         (equal? selected-bundle (hash-ref repair "sourceBundle"))))
  (def disposition-requests (map (lambda (d)
    (def f ((.ref history 'entry) (.ref d 'failure)))
    (def r ((.ref history 'entry) (.ref d 'repair)))
    (unless (member (.ref d 'failure) expected) (error "disposition names no captured failure"))
    (list (.ref d 'failure) (covers? f r)
      (nasa-evidence-request (nasa-verifiable-evidence
        (nasa-criterion-evidence (string-append "BP061-disposition/" (.ref d 'failure)) project "SWE-061" "SWE-061/p1"
          "independent-ownership-cut-oracle/v1" 'pass)
        (digest-text (string-append packet (hash-ref f "recordSha256") (hash-ref r "recordSha256")))))
      (append (hash-ref f "dependencies") (hash-ref r "dependencies")))) dispositions))
  (unless (= (length dispositions) (length (delete-duplicates/hash (map (lambda (d) (.ref d 'failure)) dispositions))))
    (error "duplicate failure disposition"))
  (def (current-support?)
    (every (lambda (case)
      (any (lambda (clue)
        (def entry ((.ref history 'reference) (hash-ref clue "id")))
        (and (equal? (.ref entry 'case) case) (equal? (.ref entry 'outcome) "pass")
             (equal? selected-bundle (.ref entry 'source-bundle)))) (hash-ref (car history-cut) "clues")))
      (if (equal? selected-scope "bounded-permit-method/M04") '("M04") '("M04" "M06"))))
  (def adapter (nasa-verification-adapter "backpressure-history-content/v1"
    (lambda (request now until)
      (with-catch (lambda (_) #f) (lambda ()
      (if (eq? request context-request)
        (begin ((.ref history 'source-current!)) #t)
        (and complete?
             (or (and (eq? request content-request) (current-support?) (current?))
                 (any (lambda (row) (and (cadr row) (eq? request (caddr row))
                   (current? #f) (begin (assert-files (cadddr row)) #t))) disposition-requests)))))))))
  (def (gate receipts now)
    ;; One checked native read per use, never a cached verdict or receipt.
    (def inspected-cut (with-catch (lambda (_) #f)
      (lambda () ((.ref history 'current-capture!)))))
    (def present-cut (or inspected-cut
      (with-catch (lambda (_) history-cut) (lambda () ((.ref history 'capture))))))
    (def still-current (and inspected-cut
      (with-catch (lambda (_) #f) (lambda () (bound-current? inspected-cut)))))
    (def present-failures (failure-ids present-cut))
    (def open-failures (filter (lambda (id)
      (def entry ((.ref history 'reference) id))
      (and (not (.ref entry 'diagnostic?))
        (not (and still-current complete?
          (any (lambda (row) (and (equal? (car row) id) (cadr row)
            (any (lambda (receipt) (yuanxu-verification-valid? adapter receipt (caddr row) now)) receipts))) disposition-requests))))) present-failures))
    (def blockers (map (lambda (id)
      (nasa-verifiable-evidence (nasa-criterion-evidence (string-append "unresolved/" id) project "SWE-061" "SWE-061/p1"
        "retained-native-failure" 'fail) (.ref ((.ref history 'reference) id) 'digest))) open-failures))
    (def selected-receipts (if (and still-current complete?) receipts
      (filter (lambda (receipt) (yuanxu-verification-valid? adapter receipt context-request now)) receipts)))
    (def result (nasa-stage-gate (nasa-stage-policy "backpressure-reassessment" '("SWE-061")) project 'a (.ref profile 'context)
      (cons evidence blockers) adapter selected-receipts now))
    (let ((selected-result result) (selected-open open-failures) (selected-current still-current) (selected-complete complete?))
      (.o (:: @ selected-result) history-complete?: selected-complete current?: selected-current
          failure-ids: present-failures unresolved: selected-open)))
  (let ((selected-adapter adapter) (selected-content content-request) (selected-context context-request) (selected-gate gate)
        (selected-dispositions disposition-requests) (selected-packet packet) (selected-expected expected))
    (.o adapter: selected-adapter content-request: selected-content context-request: selected-context gate: selected-gate
        disposition-requests: selected-dispositions packet: selected-packet failure-ids: selected-expected)))
(def (reassessment-stage review receipts now) ((.ref review 'gate) receipts now))
(def (reassessment-verify-context review now until)
  (yuanxu-verify (.ref review 'adapter) (.ref review 'context-request) now until))
(def (reassessment-verify-content review now until)
  (yuanxu-verify (.ref review 'adapter) (.ref review 'content-request) now until))
(def (reassessment-verify-disposition review id now until)
  (def row (or (find (lambda (r) (equal? (car r) id)) (.ref review 'disposition-requests)) (error "unknown disposition request")))
  (yuanxu-verify (.ref review 'adapter) (caddr row) now until))
