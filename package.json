{
  "name": "deterministic-engineering-workspace",
  "private": true,
  "type": "module",
  "license": "LGPL-2.1-or-later",
  "engines": {
    "bun": ">=1.3.11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --cwd packages/render typecheck",
    "typecheck:quint": "bun run --cwd packages/quint-modules-resolver typecheck",
    "typecheck:all": "bun run typecheck && bun run typecheck:quint",
    "test": "bun test ./packages/render/test",
    "test:quint": "bun run --cwd packages/quint-modules-resolver test",
    "test:all": "bun run test && bun run test:quint",
    "test:export": "bun run --cwd packages/render test:export",
    "test:examples": "bun test ./packages/render/examples/test",
    "example:case": "bun packages/render/examples/library-case.ts",
    "example:compare": "bun packages/render/examples/comparison.ts",
    "example:overviews": "bun packages/render/examples/overviews.ts",
    "example:design": "bun packages/render/examples/design-choices.ts",
    "example:images": "bun packages/render/examples/raster-comparison.ts",
    "example:library-boundary": "bun packages/render/examples/library-boundary.ts"
  }
}
