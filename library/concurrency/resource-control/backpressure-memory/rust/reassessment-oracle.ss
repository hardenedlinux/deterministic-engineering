;;; -*- Gerbil -*-
;;; Independent ownership-cut oracle for source-changing mechanism experiments.
;;; The Rust producer reports events; neither case labels nor producer verdicts decide safety.
(import :std/encoding/json :std/list/list)
(export backpressure-reassessment-oracle)
(def (backpressure-reassessment-oracle raw)
  (unless (and (equal? (hash-ref raw "schema") "rust.resource-lifecycle.v1")
               (= (hash-ref raw "capacity") 1) (= (hash-ref raw "rayonThreads") 1)
               (equal? (hash-ref raw "tokioFlavor") "current_thread")
               (equal? (hash-ref raw "panic") "unwind")) (error "unsupported reassessment mechanism"))
  (def cases (hash-ref raw "cases"))
  (unless (equal? (map (cut hash-ref <> "case") cases) '("M01" "M02" "M03" "M04" "M05" "M06"))
    (error "incomplete native reassessment cases"))
  (map (lambda (case)
    (def events (hash-ref case "events"))
    (def (one label)
      (def found (filter (lambda (e) (equal? (hash-ref e "event") label)) events))
      (unless (= (length found) 1) (error "incomplete or duplicate native event" label)) (car found))
    (def (index label)
      (let loop ((xs events) (i 0))
        (cond ((null? xs) (error "missing native order event" label))
              ((equal? (hash-ref (car xs) "event") label) i)
              (else (loop (cdr xs) (+ i 1))))))
    (def held (one "held")) (def final (one "final"))
    (unless (and (< (index "payload-created") (index "held"))
                 (< (index "held") (index "payload-dropped"))
                 (< (index "payload-dropped") (index "final"))
                 (= (hash-ref held "live") 1) (= (hash-ref held "drops") 0)
                 (= (hash-ref final "live") 0) (= (hash-ref final "drops") 1)
                 (= (hash-ref final "available") 1)) (error "invalid disposal event closure"))
    (when (member (hash-ref case "case") '("M04" "M06"))
      (unless (and (< (index "caller-waiting") (index "held"))
                   (< (index "caller-cancelled") (index "held"))
                   (< (index "held") (index "cpu-released"))
                   (< (index "cpu-released") (index "cpu-finished"))) (error "caller-abort cut not established")))
    (def safe (every (lambda (e)
      (or (not (hash-key? e "live")) (= (hash-ref e "live") (- 1 (hash-ref e "available"))))) events))
    (hash ("case" (hash-ref case "case")) ("outcome" (if safe "pass" "fail"))
          ("payloadBytes" (hash-ref raw "payloadBytes")))) cases))
