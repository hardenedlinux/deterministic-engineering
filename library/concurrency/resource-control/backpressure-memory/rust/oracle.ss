;;; -*- Gerbil -*-
;;; Independent finite oracle: explicit job stages and a reservation bit mask.
;;; It reads neither Quint ASTs nor ASCENT rules.
(import :std/encoding/json)
(export resource-ownership-oracle resource-counter-oracle resource-budget-oracle resource-native-oracle)
(def (bit job) (arithmetic-shift 1 job))
(def (occupancy stages stage) (length (filter (cut = <> stage) stages)))
(def (holders stages)
  (let loop ((rest stages) (job 0) (mask 0))
    (if (null? rest) mask
      (loop (cdr rest) (+ job 1)
        (if (<= 1 (car rest) 4) (bitwise-ior mask (bit job)) mask)))))
(def (safe? stages mask limit queue)
  (and (= mask (holders stages))
       (<= (length (filter (lambda (s) (<= 1 s 4)) stages)) limit)
       (<= (occupancy stages 1) queue)))
(def (transition state job target)
  (let* ((stages (car state)) (mask (cadr state))
         (next (let loop ((rest stages) (i 0))
                 (if (null? rest) '()
                   (cons (if (= i job) target (car rest)) (loop (cdr rest) (+ i 1)))))))
    (list next (cond ((= target 1) (bitwise-ior mask (bit job)))
                    ((= target 5) (bitwise-and mask (bitwise-not (bit job))))
                    (else mask)))))
(def (resource-ownership-oracle limit queue)
  (unless (or (and (= limit 1) (= queue 1)) (and (member limit '(2 4)) (= queue 2))) (error "unsupported ownership domain"))
  (def seen (make-hash-table))
  (let loop ((todo '(((0 0 0 0 0) 0))) (states 0) (edges 0))
    (if (null? todo)
      (hash ("oracle" "explicit-five-job-bfs/v1") ("safe" #t)
            ("states" states) ("transitions" edges) ("limit" limit) ("queue" queue))
      (let* ((state (car todo)) (stages (car state)) (mask (cadr state)))
        (if (hash-get seen state) (loop (cdr todo) states edges)
          (let ((next '()))
            (unless (safe? stages mask limit queue) (error "independent ownership oracle violation" state))
            (hash-put! seen state #t)
            (let jobs ((rest stages) (job 0))
              (unless (null? rest)
                (for-each (lambda (target) (set! next (cons (transition state job target) next)))
                  (case (car rest)
                    ((0) (if (and (< (occupancy stages 1) queue)
                                  (< (length (filter (lambda (s) (<= 1 s 4)) stages)) limit)) '(1) '()))
                    ((1) '(2)) ((2) '(3 4)) ((3 4) '(5)) (else '())))
                (jobs (cdr rest) (+ job 1))))
            (loop (append next (cdr todo)) (+ states 1) (+ edges (length next)))))))))
(def (itf-int value) (string->number (hash-ref value "#bigint")))
(def (itf-set state field) (map itf-int (hash-ref (hash-ref state field) "#set")))
(def (resource-counter-oracle trace-file)
  (def trace (call-with-input-file trace-file (cut read-json <> object-as-hash: #t)))
  (def states (hash-ref trace "states"))
  (unless (= (length states) 2) (error "expected the independent two-state counter schedule"))
  (def before (hash-ref (car states) "s"))
  (def after (hash-ref (cadr states) "s"))
  (unless (and (equal? (itf-set before "running") '(0))
               (equal? (itf-set before "admitted") '(0))
               (null? (itf-set before "cleanup"))
               (null? (itf-set after "running"))
               (null? (itf-set after "admitted"))
               (equal? (itf-set after "cleanup") '(0)))
    (error "trace does not establish retained cleanup without reservation"))
  (hash ("oracle" "explicit-job0-cancel/v1") ("retainedJob" 0)
        ("reservationAfter" #f) ("cleanupAfter" #t) ("violation" #t)))
(def (resource-budget-oracle queue active item fixed cache budget)
  (def planned (+ (* (+ queue active) item) fixed cache))
  (hash ("oracle" "integer-accounting/v1") ("planned" planned)
        ("budget" budget) ("within" (<= planned budget))))

;; Independent event/cut oracle. The Rust producer emits observations, not gold.
(def (resource-native-oracle report)
  (unless (and (equal? (hash-ref report "schema") "rust.resource-lifecycle.v1")
               (= (hash-ref report "capacity") 1)
               (equal? (hash-ref report "tokioFlavor") "current_thread")
               (= (hash-ref report "rayonThreads") 1)
               (equal? (hash-ref report "panic") "unwind"))
    (error "native producer scope differs"))
  (def cases (hash-ref report "cases"))
  (unless (equal? (map (cut hash-ref <> "case") cases) '("M01" "M02" "M03" "M04" "M05" "M06"))
    (error "native case closure incomplete or duplicated"))
  (map (lambda (case)
    (def name (hash-ref case "case"))
    (def events (hash-ref case "events"))
    (def labels (map (cut hash-ref <> "event") events))
    (def (at label) (or (find (lambda (e) (equal? (hash-ref e "event") label)) events)
                       (error "native event absent" name label)))
    (def (index label) (let loop ((xs labels) (i 0))
      (cond ((null? xs) (error "native order event absent" name label))
            ((equal? (car xs) label) i) (else (loop (cdr xs) (+ i 1))))))
    (def (before a b) (unless (< (index a) (index b)) (error "native partial order violated" name a b)))
    (for-each (lambda (label)
      (unless (= (length (filter (cut equal? <> label) labels)) 1)
        (error "native event closure duplicated/missing" name label)))
      '("payload-created" "payload-dropped" "held" "final"))
    (def held (at "held")) (def final (at "final"))
    (unless (and (= (hash-ref held "live") 1) (= (hash-ref held "drops") 0)
                 (= (hash-ref held "available") (if (equal? name "M06") 1 0))
                 (= (hash-ref final "live") 0) (= (hash-ref final "drops") 1)
                 (= (hash-ref final "available") 1))
      (error "native holder/permit gold mismatch" name))
    (before "payload-created" "held") (before "held" "payload-dropped")
    (before "payload-dropped" "final")
    (if (equal? name "M02")
      (begin (before "waiter-pending" "waiter-cancelled") (before "waiter-cancelled" "held")
        (unless (= (hash-ref case "acquiredByWaiter") 0) (error "cancelled waiter acquired")))
      (begin
        (before "cpu-started" "started") (before "started" "held")
        (before "held" "cpu-released") (before "cpu-released" "cpu-finished")
        (before "cpu-finished" "final")
        (cond
          ((equal? name "M01")
            (def returned (at "returned"))
            (unless (and (= (hash-ref returned "live") 1) (= (hash-ref returned "available") 0))
              (error "result owner lost reservation"))
            (before "cpu-released" "returned") (before "returned" "payload-dropped"))
          ((equal? name "M03") (before "receiver-dropped" "held")
            (before "cpu-released" "delivery-failed-retained")
            (before "delivery-failed-retained" "payload-dropped"))
          ((or (equal? name "M04") (equal? name "M06"))
            (before "caller-cancelled" "held")
            (before "cpu-released" "delivery-failed-retained")
            (before "delivery-failed-retained" "payload-dropped"))
          ((equal? name "M05") (before "cpu-released" "cleanup-full-retained")
            (before "cleanup-full-retained" "payload-dropped")))))
    (def projection
      (map (lambda (e)
        (def live (hash-ref e "live")) (def reserved (- 1 (hash-ref e "available")))
        (hash ("cut" (hash-ref e "event")) ("owners" live) ("reserved" reserved)
              ("safe" (= live reserved))))
        (filter (lambda (e) (hash-key? e "live")) events)))
    (unless (equal? (andmap (cut hash-ref <> "safe") projection) (not (equal? name "M06")))
      (error "cut projection differs from ownership invariant" name))
    (hash ("oracle" "independent-cut-and-ownership/v1") ("projection" projection) ("case" name)
          ("outcome" (if (equal? name "M06") "fail" "pass"))
          ("heldLive" 1) ("heldAvailable" (hash-ref held "available"))
          ("finalLive" 0) ("finalAvailable" 1))) cases))
