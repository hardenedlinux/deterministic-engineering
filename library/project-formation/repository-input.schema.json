{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BoundedRepositoryInputRequest",
  "type": "object",
  "required": [
    "root",
    "paths",
    "maxBytes",
    "lifetimeSeconds"
  ],
  "additionalProperties": false,
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "lifetimeSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 120
    }
  }
}
