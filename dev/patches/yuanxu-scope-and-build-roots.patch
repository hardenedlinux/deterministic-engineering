diff --git a/t/module-context-normalization-test.ss b/t/module-context-normalization-test.ss
new file mode 100644
index 0000000..b9b4d94
--- /dev/null
+++ b/t/module-context-normalization-test.ss
@@ -0,0 +1,75 @@
+;;; Core-owned same-path qualification. No public Contract override is exported.
+(import :std/test :clan/poo/object
+        (only-in :std/io/tempfile call-with-temporary-directory)
+        (only-in :yuanxu/types yuanxu-predicate-type yuanxu-predicate-contract)
+        (only-in :yuanxu/module-system/source/publication ModuleScopeContextContract module-scope-context?)
+        :yuanxu/module-system/source/objects
+        :yuanxu/module-system/source/link)
+;; Statically bind the private production factory. Public yuanxu-load-modules
+;; fixes ModuleScopeContextContract; this does not replace a global descriptor.
+(extern namespace: yuanxu/module-system/source/link load-module-selection)
+(export module-context-normalization-test)
+(def Shape (yuanxu-predicate-contract 'qualification/scope object?))
+(def (write-source path text)
+ (create-directory* (path-directory path))
+ (call-with-output-file [path: path truncate: #t] (cut display text <>)))
+(def (normalizing-contract selected receive)
+ (.cc ModuleScopeContextContract 'value-contract
+  (.cc (yuanxu-predicate-type 'module/scope-context module-scope-context?)
+   '.validate (lambda (raw)
+    (unless (module-scope-context? raw) (error "invalid qualification Context"))
+    ;; Restrict existing roots, never add permissions or change source callbacks.
+    (def normalized (.cc raw 'selected selected 'generation (string-copy (.ref raw 'generation))))
+    (receive raw normalized)
+    normalized))))
+(def module-context-normalization-test
+ (test-suite "Same production Context admission and continuation"
+  (test-case "caller Context K1 controls roots and all retained evidence"
+   (def original #f) (def retained #f) (def admissions 0)
+   (def C (normalizing-contract '(left)
+    (lambda (raw normalized) (set! original raw) (set! retained normalized) (set! admissions (+ admissions 1)))))
+   (def declarations
+    (.o left: (.o identity: 'left features: (.o)
+               core: (.o requires: (.o) scope-contract: Shape link: (lambda (_) (.o ready: #t))))
+        right: (error "removed root was forced")))
+   (def K0 (.o generation: "context-fixture" module-ids: '(left right) selected: '(left right) denied-modules: '()
+    locate: make-yuanxu-module-generated-source
+    read-publication: (lambda (source) (.ref declarations (yuanxu-module-source-ref-value source)))
+    current?: (lambda (generation) (string=? generation "context-fixture"))))
+   (def selection (load-module-selection C K0 #f #f))
+   (def K1 (.get selection context))
+   (check-equal? (eq? original K0) #t)
+   (check-equal? (eq? K1 retained) #t)
+   (check-equal? (eq? K1 K0) #f)
+   (check-equal? (.get K0 selected) '(left right))
+   (check-equal? (.get K1 selected) '(left))
+   (def record (.call selection .selected-record 'left))
+   (check-equal? (eq? (.get record scope-evidence context) K1) #t)
+   (check-equal? (.get selection modules left ready) #t)
+   (check-equal? (.get selection dependency-order) '(left))
+   (check-equal? admissions 1))
+  (test-case "native directory paired reader keeps ownership and refuses changed source"
+   (call-with-temporary-directory "context-native-owner"
+    (lambda (root)
+     (write-source (path-expand "gerbil.pkg" root) "(package: context-native-owner)")
+     (write-source (path-expand "init.ss" root) "(import :yuanxu/module-system/selection/init-syntax) (yuanxu! mode: explicit source: \"./modules\" (demo))")
+     (write-source (path-expand "modules/demo/types.ss" root)
+      "(import :clan/poo/object (only-in :yuanxu/types yuanxu-predicate-contract)) (def Scope (yuanxu-predicate-contract 'qualification/scope object?)) (export Scope)")
+     (write-source (path-expand "modules/demo/objects.ss" root)
+      "(import :clan/poo/object) (def Defaults (.o)) (export Defaults)")
+     (write-source (path-expand "modules/demo/config.ss" root)
+      "(import \"objects.ss\") (def Config Defaults) (export Config)")
+     (def interface (path-expand "modules/demo/interface.ss" root))
+     (write-source interface "(.def Published identity: 'demo features: (.o) core: (.o requires: (.o) scope-contract: Scope exports: (.o value: 'ready)))")
+     (def original #f) (def retained #f) (def admissions 0)
+     (def C (normalizing-contract '(demo)
+      (lambda (raw normalized) (set! original raw) (set! retained normalized) (set! admissions (+ admissions 1)))))
+     (def selection (load-module-selection C (path-expand "init.ss" root) #f #f))
+     (check-equal? (eq? (.get selection context) retained) #t)
+     (check-equal? (eq? original retained) #f)
+     (check-equal? (.get selection modules demo value) 'ready)
+     (def record (.call selection .selected-record 'demo))
+     (check-equal? (eq? (.get record scope-evidence context) retained) #t)
+     (check-equal? admissions 1)
+     (write-source interface "(this changed source must refuse)")
+     (check-exception (.call selection .selected-record 'demo) error?))))))
diff --git a/t/module-normalized-scope-test.ss b/t/module-normalized-scope-test.ss
new file mode 100644
index 0000000..be4964c
--- /dev/null
+++ b/t/module-normalized-scope-test.ss
@@ -0,0 +1,88 @@
+;;; Actual linker controls: independent expected values and receiver identities.
+(import :std/test :clan/poo/object
+        (only-in :clan/poo/mop Type. define-type Function)
+        (only-in :clan/poo/type String)
+        (only-in :clan/poo/object-contract ObjectContract.)
+        (only-in :yuanxu/types YuanxuContract. yuanxu-predicate-contract)
+        :yuanxu/module-system/source/objects
+        (only-in :yuanxu/module-system/source/link yuanxu-load-modules))
+(export module-normalized-scope-test)
+(def Shape (yuanxu-predicate-contract 'fixture/scope object?))
+(def (publication id required-bindings descriptor factory)
+  (.o identity: id features: (.o)
+      core: (.o requires: required-bindings scope-contract: descriptor link: factory)))
+(def (context publications selected-ids current-predicate)
+  (.o generation: "normalized-fixture" module-ids: '(provider left right unused)
+      selected: selected-ids denied-modules: '()
+      locate: make-yuanxu-module-generated-source
+      read-publication: (lambda (source) (.ref publications (yuanxu-module-source-ref-value source)))
+      current?: current-predicate))
+(def (normalizer id label counter)
+  (define-type (Normalize @ Type.)
+    .validate: (lambda (value) (counter) (.cc value 'label label)))
+  (.cc YuanxuContract. 'identity id 'value-contract Normalize))
+(def module-normalized-scope-test
+  (test-suite "Actual normalized consumer and final Scope receivers"
+    (test-case "one provider retains final Scope; two edges and consumers remain isolated"
+      (def factories 0) (def admissions 0) (def edge-count 0)
+      (def count-admit (lambda () (set! admissions (+ admissions 1))))
+      (def count-edge (lambda () (set! edge-count (+ edge-count 1))))
+      (def provider-type (normalizer 'fixture/provider "provider-final" count-admit))
+      (def left-edge (normalizer 'fixture/left-edge "left-edge" count-edge))
+      (def right-edge (normalizer 'fixture/right-edge "right-edge" count-edge))
+      (def left-type (normalizer 'fixture/left "left-final" count-admit))
+      (def right-type (normalizer 'fixture/right "right-final" count-admit))
+      (def publications
+        (.o provider: (publication 'provider (.o) provider-type
+                         (lambda (_deps) (set! factories (+ factories 1)) (.o label: "raw-provider")))
+            left: (publication 'left (.o P: (.o module-id: 'provider contract: left-edge)) left-type
+                    (lambda (deps) (.o label: "raw-left" child: (.get deps P))))
+            right: (publication 'right (.o P: (.o module-id: 'provider contract: right-edge)) right-type
+                     (lambda (deps) (.o label: "raw-right" child: (.get deps P))))
+            unused: (publication 'unused (.o) Shape (lambda (_deps) (error "unused factory forced")))))
+      (def selection (yuanxu-load-modules (context publications '(left right) (lambda (_g) #t))))
+      (def left (.get selection modules left))
+      (def right (.get selection modules right))
+      (def provider (.get (.call selection .selected-record 'provider) scope))
+      (check-equal? (.get provider label) "provider-final")
+      (check-equal? (.get left label) "left-final")
+      (check-equal? (.get right label) "right-final")
+      (check-equal? (.get left child label) "left-edge")
+      (check-equal? (.get right child label) "right-edge")
+      (check-equal? (eq? (.get left child) (.get right child)) #f)
+      (def left-record (.call selection .selected-record 'left))
+      (check-equal? (eq? (.get left-record scope) (.get left-record scope-evidence candidate)) #t)
+      (check-equal? (eq? (.get left child)
+                       (.get left-record dependency-records P requirement-evidence candidate)) #t)
+      (check-equal? (eq? left (.get selection modules left)) #t)
+      (check-equal? factories 1)
+      (check-equal? admissions 3)
+      (check-equal? edge-count 2))
+    (test-case "normalized dependency preserves Function input/output boundaries"
+      (def calls 0)
+      (def fields (.cc ObjectContract. 'responsibilities
+                    (.o callback: (Function (list String) (list String)))))
+      (def descriptor (.cc YuanxuContract. 'identity 'fixture/callback 'value-contract fields))
+      (def publications
+        (.o provider: (publication 'provider (.o) Shape
+                        (lambda (_deps) (.o callback: (lambda (_x) (set! calls (+ calls 1)) 123))))
+            left: (publication 'left (.o P: (.o module-id: 'provider contract: descriptor)) Shape
+                    (lambda (deps) (.o callback: (.get deps P callback))))))
+      (def selection (yuanxu-load-modules (context publications '(left) (lambda (_g) #t))))
+      (def callback (.get selection modules left callback))
+      (check-exception (callback 123) error?)
+      (check-equal? calls 0)
+      (check-exception (callback "valid") error?)
+      (check-equal? calls 1))
+    (test-case "warm stale source refuses and fences the same session"
+      (def current #t)
+      (def publications
+        (.o left: (publication 'left (.o) Shape (lambda (_deps) (.o value: "left")))
+            right: (publication 'right (.o) Shape (lambda (_deps) (.o value: "right")))))
+      (def selection (yuanxu-load-modules (context publications '(left right) (lambda (_g) current))))
+      (def held (.get selection modules left))
+      (set! current #f)
+      (check-exception (.call selection .selected-record 'left) error?)
+      (set! current #t)
+      (check-exception (.call selection .selected-record 'right) error?)
+      (check-equal? (.get held value) "left"))))
